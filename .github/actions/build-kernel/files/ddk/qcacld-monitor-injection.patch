+}
+
+bool wma_mon_inject_peer_create_response(uint8_t vdev_id,
+					 const uint8_t *peer_mac,
+					 uint32_t status)
+{
+	bool signal = false;
+	bool handled = false;
+
+	if (!g_inj.initialized || !peer_mac)
+		return false;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	if (g_inj.vdev_claimed && g_inj.vdev_id == vdev_id &&
+	    !qdf_mem_cmp(g_inj.mac_addr, peer_mac, QDF_MAC_ADDR_SIZE)) {
+		handled = true;
+		if (g_inj.state == WMA_MON_INJECT_STARTING) {
+			g_inj.peer_create_status = status;
+			signal = true;
+		}
+	}
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	if (signal)
+		qdf_event_set(&g_inj.peer_create_event);
+
+	return handled;
+}
+
+bool wma_mon_inject_peer_delete_response(uint8_t vdev_id,
+					 const uint8_t *peer_mac)
+{
+	bool signal = false;
+	bool handled = false;
+
+	if (!g_inj.initialized || !peer_mac)
+		return false;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	if (g_inj.vdev_claimed && g_inj.vdev_id == vdev_id &&
+	    !qdf_mem_cmp(g_inj.mac_addr, peer_mac, QDF_MAC_ADDR_SIZE)) {
+		handled = true;
+		if (g_inj.state == WMA_MON_INJECT_STOPPING)
+			signal = true;
+	}
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	if (signal)
+		qdf_event_set(&g_inj.peer_delete_event);
+
+	return handled;
+}
+
+bool wma_mon_inject_tx_complete(uint32_t desc_id, uint32_t status)
+{
+	qdf_nbuf_t nbuf = NULL;
+	int i;
+
+	if (!wma_mon_inject_is_desc_id(desc_id))
+		return false;
+
+	if (!g_inj.initialized)
+		return true;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+		if (!g_inj.inflight[i].valid ||
+		    g_inj.inflight[i].desc_id != desc_id)
+			continue;
+
+		nbuf = g_inj.inflight[i].nbuf;
+		g_inj.inflight[i].nbuf = NULL;
+		g_inj.inflight[i].valid = false;
+		break;
+	}
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	if (nbuf)
+		wma_mon_inject_nbuf_unmap_free(nbuf);
+	else
+		wma_warn("Injection: completion for unknown desc_id=%u", desc_id);
+
+	if (status)
+		wma_warn("Injection: desc_id=%u completed with status=%u",
+			 desc_id, status);
+
+	return true;
+}
+
+static void wma_mon_inject_mark_down(void)
+{
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	g_inj.state = WMA_MON_INJECT_DOWN;
+	g_inj.vdev_claimed = false;
+	g_inj.vdev_created = false;
+	g_inj.start_sent = false;
+	g_inj.peer_created = false;
+	g_inj.vdev_id = 0;
+	g_inj.mon_vdev_id = 0;
+	g_inj.chanfreq = 0;
+	g_inj.start_status = QDF_STATUS_E_FAILURE;
+	g_inj.peer_create_status = QDF_STATUS_E_FAILURE;
+	qdf_mem_zero(g_inj.mac_addr, sizeof(g_inj.mac_addr));
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+}
+
+static void wma_mon_inject_teardown_locked(tp_wma_handle wma)
+{
+	struct peer_delete_cmd_params pdel = {0};
+	struct vdev_stop_params vstop = {0};
+	QDF_STATUS status;
+	uint8_t mac_addr[QDF_MAC_ADDR_SIZE];
+	uint8_t vdev_id;
+	bool peer_created;
+	bool start_sent;
+	bool vdev_created;
+	bool delete_acked = false;
+	bool submitters_idle;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	if (!g_inj.vdev_claimed) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		return;
+	}
+
+	g_inj.state = WMA_MON_INJECT_STOPPING;
+	vdev_id = g_inj.vdev_id;
+	peer_created = g_inj.peer_created;
+	start_sent = g_inj.start_sent;
+	vdev_created = g_inj.vdev_created;
+	qdf_mem_copy(mac_addr, g_inj.mac_addr, sizeof(mac_addr));
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	wma_mon_inject_wait_for_tx_drain();
+
+	if (wma && wma->wmi_handle && peer_created) {
+		qdf_event_reset(&g_inj.peer_delete_event);
+		pdel.vdev_id = vdev_id;
+		status = wmi_unified_peer_delete_send(wma->wmi_handle,
+						      mac_addr, &pdel);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			wma_warn("Injection: peer delete failed: %d", status);
+		} else {
+			status = qdf_wait_for_event_completion(
+						&g_inj.peer_delete_event,
+						WMA_MON_INJECT_PEER_TIMEOUT_MS);
+			if (QDF_IS_STATUS_ERROR(status))
+				wma_warn("Injection: peer delete response timed out");
+		}
+	}
+
+	if (wma && wma->wmi_handle && start_sent) {
+		qdf_event_reset(&g_inj.stop_event);
+		vstop.vdev_id = vdev_id;
+		status = wmi_unified_vdev_stop_send(wma->wmi_handle, &vstop);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			wma_warn("Injection: vdev stop failed: %d", status);
+		} else {
+			status = qdf_wait_for_event_completion(
+						&g_inj.stop_event,
+						WMA_MON_INJECT_STOP_TIMEOUT_MS);
+			if (QDF_IS_STATUS_ERROR(status))
+				wma_warn("Injection: vdev stop response timed out");
+		}
+	}
+
+	if (wma && wma->wmi_handle && vdev_created) {
+		qdf_event_reset(&g_inj.delete_event);
+		status = wmi_unified_vdev_delete_send(wma->wmi_handle, vdev_id);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			wma_warn("Injection: vdev delete failed: %d", status);
+		} else {
+			status = qdf_wait_for_event_completion(
+						&g_inj.delete_event,
+						WMA_MON_INJECT_DELETE_TIMEOUT_MS);
+			if (QDF_IS_STATUS_ERROR(status)) {
+				wma_warn("Injection: vdev delete response timed out");
+			} else {
+				delete_acked = true;
+			}
+		}
+	}
+
+	/*
+	 * A delete response guarantees firmware no longer owns the vdev's DMA
+	 * buffers. If delete times out, leave them mapped for a late completion;
+	 * force-freeing them would turn a firmware stall into a use-after-DMA.
+	 */
+	submitters_idle = wma_mon_inject_submitters_idle();
+	if ((!vdev_created || delete_acked) && submitters_idle) {
+		wma_mon_inject_flush_inflight();
+	} else if (!submitters_idle) {
+		wma_warn("Injection: retaining TX buffers while a submitter is active");
+	} else {
+		wma_warn("Injection: retaining uncompleted TX buffers after delete timeout");
+	}
+	wma_mon_inject_mark_down();
+}
+
+int wma_mon_inject_setup(uint8_t mon_vdev_id, uint32_t chanfreq)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct vdev_create_params vcreate = {0};
+	struct vdev_start_params vstart = {0};
+	struct peer_create_params pcreate = {0};
+	uint8_t helper_mac[QDF_MAC_ADDR_SIZE];
+	uint8_t *monitor_mac;
+	QDF_STATUS status;
+	uint32_t peer_status;
+	uint8_t vdev_id;
+	bool peer_conf_supported;
+	int ret = -EIO;
+
+	if (!g_inj.initialized || !wma || !wma->wmi_handle || !chanfreq)
+		return -EINVAL;
+
+	status = qdf_mutex_acquire(&g_inj.lifecycle_lock);
+	if (QDF_IS_STATUS_ERROR(status))
+		return -EAGAIN;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	if (g_inj.state == WMA_MON_INJECT_UP &&
+	    g_inj.chanfreq == chanfreq) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		ret = 0;
+		goto out_unlock;
+	}
+
+	if (g_inj.state == WMA_MON_INJECT_UP) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		wma_mon_inject_teardown_locked(wma);
+	} else if (g_inj.state != WMA_MON_INJECT_DOWN) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		ret = -EBUSY;
+		goto out_unlock;
+	} else {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+	}
+
+	if (mon_vdev_id >= wma->max_bssid ||
+	    !wma->interfaces[mon_vdev_id].vdev) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+
+	status = wma_mon_inject_find_vdev_id(wma, mon_vdev_id, &vdev_id);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+
+	monitor_mac =
+		wlan_vdev_mlme_get_macaddr(wma->interfaces[mon_vdev_id].vdev);
+	if (!monitor_mac) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	wma_mon_inject_build_mac(helper_mac, monitor_mac);
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	g_inj.state = WMA_MON_INJECT_STARTING;
+	g_inj.vdev_claimed = true;
+	g_inj.vdev_created = false;
+	g_inj.start_sent = false;
+	g_inj.peer_created = false;
+	g_inj.vdev_id = vdev_id;
+	g_inj.mon_vdev_id = mon_vdev_id;
+	g_inj.chanfreq = chanfreq;
+	g_inj.start_status = QDF_STATUS_E_FAILURE;
+	g_inj.peer_create_status = QDF_STATUS_E_FAILURE;
+	qdf_mem_copy(g_inj.mac_addr, helper_mac, sizeof(helper_mac));
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	vcreate.vdev_id = vdev_id;
+	vcreate.type = WMI_VDEV_TYPE_STA;
+	vcreate.subtype = 0;
+	vcreate.nss_2g = 1;
+	vcreate.nss_5g = 1;
+	vcreate.pdev_id = 0;
+
+	status = wmi_unified_vdev_create_send(wma->wmi_handle,
+					      helper_mac, &vcreate);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: vdev create failed: %d", status);
+		goto fail_teardown;
+	}
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	g_inj.vdev_created = true;
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	status = qdf_event_reset(&g_inj.start_event);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto fail_teardown;
+
+	vstart.vdev_id = vdev_id;
+	vstart.channel.mhz = chanfreq;
+	vstart.channel.cfreq1 = chanfreq;
+	vstart.channel.cfreq2 = 0;
+	vstart.channel.phy_mode = (chanfreq < 4000) ? WLAN_PHYMODE_11G
+							  : WLAN_PHYMODE_11A;
+	vstart.channel.maxregpower = 20;
+	vstart.channel.maxpower = 20;
+	vstart.channel.pwr = 20;
+	vstart.beacon_interval = 0;
+	vstart.dtim_period = 0;
+
+	status = wmi_unified_vdev_start_send(wma->wmi_handle, &vstart);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: vdev start failed: %d", status);
+		goto fail_teardown;
+	}
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	g_inj.start_sent = true;
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	status = qdf_wait_for_event_completion(
+					&g_inj.start_event,
+					WMA_MON_INJECT_START_TIMEOUT_MS);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: vdev start response timed out");
+		goto fail_teardown;
+	}
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	status = g_inj.start_status;
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: firmware rejected vdev start: %d", status);
+		goto fail_teardown;
+	}
+
+	pcreate.peer_addr = helper_mac;
+	pcreate.peer_type = WMI_PEER_TYPE_DEFAULT;
+	pcreate.vdev_id = vdev_id;
+	peer_conf_supported = wmi_service_enabled(
+					wma->wmi_handle,
+					wmi_service_peer_create_conf);
+	if (peer_conf_supported) {
+		status = qdf_event_reset(&g_inj.peer_create_event);
+		if (QDF_IS_STATUS_ERROR(status))
+			goto fail_teardown;
+	}
+
+	status = wmi_unified_peer_create_send(wma->wmi_handle, &pcreate);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: peer create failed: %d", status);
+		goto fail_teardown;
+	}
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	g_inj.peer_created = true;
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	if (peer_conf_supported) {
+		status = qdf_wait_for_event_completion(
+						&g_inj.peer_create_event,
+						WMA_MON_INJECT_PEER_TIMEOUT_MS);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			wma_err("Injection: peer create response timed out");
+			goto fail_teardown;
+		}
+
+		qdf_spin_lock_bh(&g_inj.state_lock);
+		peer_status = g_inj.peer_create_status;
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		if (peer_status) {
+			wma_err("Injection: firmware rejected peer create: %u",
+				peer_status);
+			goto fail_teardown;
+		}
+	}
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	g_inj.state = WMA_MON_INJECT_UP;
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	wma_info("Injection: helper vdev %u ready on %u MHz",
+		 vdev_id, chanfreq);
+	ret = 0;
+	goto out_unlock;
+
+fail_teardown:
+	wma_mon_inject_teardown_locked(wma);
+out_unlock:
+	qdf_mutex_release(&g_inj.lifecycle_lock);
+	return ret;
+}
+
+void wma_mon_inject_teardown(void)
+{
+	tp_wma_handle wma;
+	QDF_STATUS status;
+
+	if (!g_inj.initialized)
+		return;
+
+	status = qdf_mutex_acquire(&g_inj.lifecycle_lock);
+	if (QDF_IS_STATUS_ERROR(status))
+		return;
+
+	wma = cds_get_context(QDF_MODULE_ID_WMA);
+	wma_mon_inject_teardown_locked(wma);
+	qdf_mutex_release(&g_inj.lifecycle_lock);
+}
+
+void wma_mon_inject_deinit(void)
+{
+	if (!g_inj.initialized)
+		return;
+
+	wma_mon_inject_teardown();
+	qdf_event_destroy(&g_inj.delete_event);
+	qdf_event_destroy(&g_inj.stop_event);
+	qdf_event_destroy(&g_inj.peer_delete_event);
+	qdf_event_destroy(&g_inj.peer_create_event);
+	qdf_event_destroy(&g_inj.start_event);
+	qdf_spinlock_destroy(&g_inj.state_lock);
+	qdf_mutex_destroy(&g_inj.lifecycle_lock);
+	qdf_mem_zero(&g_inj, sizeof(g_inj));
+}
+
+int wma_mon_inject_tx(struct sk_buff *skb, uint32_t chanfreq)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	void *qdf_ctx = cds_get_context(QDF_MODULE_ID_QDF_DEVICE);
+	struct wmi_mgmt_params mgmt = {0};
+	qdf_nbuf_t wmi_buf;
+	uint8_t *frame_data;
+	uint16_t desc_id;
+	uint8_t vdev_id;
+	QDF_STATUS status;
+	int slot = -1;
+	int i;
+
+	if (!g_inj.initialized || !wma || !wma->wmi_handle ||
+	    !qdf_ctx || !skb)
+		return -EINVAL;
+
+	wmi_buf = qdf_nbuf_alloc(NULL, skb->len, 0, 0, false);
+	if (!wmi_buf)
+		return -ENOMEM;
+
+	frame_data = qdf_nbuf_put_tail(wmi_buf, skb->len);
+	if (!frame_data) {
+		qdf_nbuf_free(wmi_buf);
+		return -ENOMEM;
+	}
+	qdf_mem_copy(frame_data, skb->data, skb->len);
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	if (g_inj.state != WMA_MON_INJECT_UP ||
+	    g_inj.chanfreq != chanfreq) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		qdf_nbuf_free(wmi_buf);
+		return -ENODEV;
+	}
+
+	for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+		if (!g_inj.inflight[i].valid) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < 0) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		wma_warn("Injection: in-flight buffer table full");
+		qdf_nbuf_free(wmi_buf);
+		return -EBUSY;
+	}
+
+	if (!wma_mon_inject_desc_id_alloc_locked(&desc_id)) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		qdf_nbuf_free(wmi_buf);
+		return -EBUSY;
+	}
+	vdev_id = g_inj.vdev_id;
+	g_inj.active_submitters++;
+	g_inj.inflight[slot].valid = true;
+	g_inj.inflight[slot].nbuf = wmi_buf;
+	g_inj.inflight[slot].desc_id = desc_id;
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	mgmt.tx_frame = wmi_buf;
+	mgmt.pdata = frame_data;
+	mgmt.frm_len = skb->len;
+	mgmt.vdev_id = vdev_id;
+	mgmt.tx_type = GENERIC_NODOWLOAD_ACK_COMP_INDEX;
+	mgmt.chanfreq = (uint16_t)chanfreq;
+	mgmt.desc_id = desc_id;
+	mgmt.macaddr = NULL;
+	mgmt.qdf_ctx = qdf_ctx;
+
+	status = wmi_mgmt_unified_cmd_send(wma->wmi_handle, &mgmt);
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	if (g_inj.active_submitters)
+		g_inj.active_submitters--;
+	if (QDF_IS_STATUS_ERROR(status)) {
+		g_inj.inflight[slot].valid = false;
+		g_inj.inflight[slot].nbuf = NULL;
+	}
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	if (QDF_IS_STATUS_ERROR(status)) {
+		qdf_nbuf_free(wmi_buf);
+		return -EIO;
+	}
+
+	return 0;
+}
