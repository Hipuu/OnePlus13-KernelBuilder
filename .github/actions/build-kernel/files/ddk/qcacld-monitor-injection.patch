-/* Monitor mode net_device_ops, does not Tx and most of operations. */
+
+static netdev_tx_t hdd_mon_hard_start_xmit(struct sk_buff *skb,
+					   struct net_device *dev)
+{
+	struct hdd_adapter *adapter = WLAN_HDD_GET_PRIV_PTR(dev);
+	struct hdd_context *hdd_ctx;
+	struct ieee80211_hdr *hdr;
+	struct wlan_objmgr_peer *peer;
+	struct wlan_objmgr_pdev *pdev;
+	struct mgmt_txrx_desc_param mgmt_params = {0};
+	struct wlan_channel channel = {0};
+	QDF_STATUS status;
+	int ctx_ret;
+	uint32_t chanfreq = 0;
+
+	if (!adapter) {
+		hdd_err("Injection: NULL adapter, dropping");
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	hdd_ctx = WLAN_HDD_GET_CTX(adapter);
+	ctx_ret = wlan_hdd_validate_context(hdd_ctx);
+	if (ctx_ret) {
+		hdd_err("Injection: HDD context invalid (%d), dropping", ctx_ret);
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	if (skb_linearize(skb) || hdd_mon_inject_strip_radiotap(skb)) {
+		hdd_err("Injection: malformed radiotap frame, dropping");
+		goto drop;
+	}
+
+	hdr = (struct ieee80211_hdr *)skb->data;
+	if (!ieee80211_is_mgmt(hdr->frame_control)) {
+		hdd_err("Injection: non-mgmt frame (fc=0x%04x), dropping",
+			hdr->frame_control);
+		goto drop;
+	}
+
+	/*
+	 * SA normalization: for broadcast probe requests, firmware drops
+	 * frames whose SA does not match a known peer.  Overwrite SA
+	 * (offset 10 in the 802.11 header) with the monitor vdev's own
+	 * MAC so the self-peer lookup succeeds.
+	 */
+	if (skb->len >= 24 &&
+	    ieee80211_is_probe_req(hdr->frame_control) &&
+	    is_broadcast_ether_addr(hdr->addr1)) {
+		ether_addr_copy(hdr->addr2,
+				adapter->deflink->mac_addr.bytes);
+	}
+
+	/* Resolve the monitor vdev's self-peer from objmgr */
+	pdev = hdd_ctx->pdev;
+	if (!pdev) {
+		hdd_err("Injection: no pdev, dropping");
+		goto drop;
+	}
+
+	peer = wlan_objmgr_get_peer_by_mac_from_vdev(
+			pdev, adapter->deflink->vdev_id,
+			adapter->deflink->mac_addr, WLAN_OSIF_ID);
+	if (!peer) {
+		hdd_err("Injection: no self-peer for vdev %u, dropping",
+			adapter->deflink->vdev_id);
+		goto drop;
+	}
+
+	/* Determine the current monitor channel frequency */
+	if (hdd_mon_inject_get_channel(adapter, &channel) && channel.ch_freq)
+		chanfreq = channel.ch_freq;
+
+	/* Fill management TX parameters */
+	mgmt_params.vdev_id = adapter->deflink->vdev_id;
+	mgmt_params.chanfreq = chanfreq;
+	mgmt_params.wait_for_ack = false;
+	mgmt_params.dont_wait_for_ack = true;
+
+	/*
+	 * Submit through the stock management TX pipeline.
+	 * On success, wlan_mgmt_txrx_mgmt_frame_tx() takes ownership
+	 * of the nbuf and frees it via the completion path.
+	 * On failure, the caller must free it.
+	 */
+	status = wlan_mgmt_txrx_mgmt_frame_tx(
+			peer,
+			NULL,		   /* context */
+			skb,
+			NULL,		   /* no download callback */
+			NULL,		   /* no OTA callback */
+			WLAN_OSIF_ID,
+			&mgmt_params);
+
+	wlan_objmgr_peer_release_ref(peer, WLAN_OSIF_ID);
+
+	if (QDF_IS_STATUS_SUCCESS(status)) {
+		dev->stats.tx_packets++;
+		dev->stats.tx_bytes += skb->len;
+		hdd_debug("Injection: frame submitted via stock mgmt TX on %u MHz",
+			  chanfreq);
+		return NETDEV_TX_OK;
+	}
+
+	hdd_err("Injection: mgmt_frame_tx failed (%d)", status);
+drop:
+	dev->stats.tx_dropped++;
+	qdf_nbuf_free(skb);
+	return NETDEV_TX_OK;
+}
