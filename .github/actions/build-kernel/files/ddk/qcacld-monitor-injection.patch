+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+/* Hidden STA vdev used for monitor-mode frame injection. */
+static struct hdd_adapter *hdd_mon_inject_sta_adapter;
+
+/**
+ * hdd_mon_inject_get_chan_freq() - current monitor channel frequency
+ * @mon_adapter: the monitor-mode adapter
+ *
+ * Return: channel frequency in MHz, or 0 if not set.
+ */
+static uint32_t hdd_mon_inject_get_chan_freq(struct hdd_adapter *mon_adapter)
+{
+	struct wlan_objmgr_vdev *mon_vdev;
+	uint32_t chan_freq = 0;
+
+	mon_vdev = hdd_objmgr_get_vdev_by_user(mon_adapter->deflink,
+					       WLAN_OSIF_ID);
+	if (mon_vdev) {
+		chan_freq = wlan_get_operation_chan_freq(mon_vdev);
+		hdd_objmgr_put_vdev_by_user(mon_vdev, WLAN_OSIF_ID);
+	}
+
+	return chan_freq;
+}
+
+/**
+ * hdd_mon_inject_fill_chan_param() - populate mlme_channel_param from freq
+ * @freq: channel center frequency in MHz
+ * @chan: mlme channel parameters to fill
+ *
+ * Return: none
+ */
+static void hdd_mon_inject_fill_chan_param(uint32_t freq,
+					   struct mlme_channel_param *chan)
+{
+	memset(chan, 0, sizeof(*chan));
+	chan->mhz = freq;
+	chan->cfreq1 = freq;
+
+	if (freq < 4000) {
+		if (freq == 2484)
+			chan->chan_id = 14;
+		else
+			chan->chan_id = ((int)freq - 2412) / 5 + 1;
+		chan->phy_mode = WLAN_PHYMODE_11G;
+	} else {
+		chan->chan_id = ((int)freq - 5000) / 5;
+		chan->phy_mode = WLAN_PHYMODE_11A;
+	}
+
+	chan->allow_ht = true;
+	chan->allow_vht = true;
+	chan->pwr = 20;
+	chan->maxpower = 20;
+}
+
+/**
+ * hdd_mon_inject_start_hidden_vdev() - start hidden STA vdev and create peer
+ * @sta_adapter: the hidden STA adapter
+ * @mon_adapter: the monitor adapter whose channel will be used
+ *
+ * Return: true on success, false on failure
+ */
+static bool hdd_mon_inject_start_hidden_vdev(struct hdd_adapter *sta_adapter,
+					     struct hdd_adapter *mon_adapter)
+{
+	struct hdd_context *hdd_ctx = WLAN_HDD_GET_CTX(sta_adapter);
+	struct wlan_objmgr_vdev *vdev;
+	struct vdev_start_params start_param = {0};
+	struct peer_create_params peer_param = {0};
+	struct mlme_channel_param chan = {0};
+	wmi_unified_t wmi_handle;
+	uint32_t freq;
+	uint8_t vdev_id;
+	QDF_STATUS status;
+
+	freq = hdd_mon_inject_get_chan_freq(mon_adapter);
+	if (!freq) {
+		hdd_err("Injection: monitor channel not set");
+		return false;
+	}
+
+	wmi_handle = get_wmi_unified_hdl_from_psoc(hdd_ctx->psoc);
+	if (!wmi_handle) {
+		hdd_err("Injection: no wmi handle");
+		return false;
+	}
+
+	vdev = hdd_objmgr_get_vdev_by_user(sta_adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev) {
+		hdd_err("Injection: hidden STA vdev not ready");
+		return false;
+	}
+	vdev_id = wlan_vdev_get_id(vdev);
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+
+	hdd_mon_inject_fill_chan_param(freq, &chan);
+
+	start_param.vdev_id = vdev_id;
+	start_param.beacon_interval = 100;
+	start_param.dtim_period = 1;
+	start_param.channel = chan;
+
+	status = wmi_unified_vdev_start_send(wmi_handle, &start_param);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		hdd_err("Injection: vdev start failed %d", status);
+		return false;
+	}
+
+	/* Firmware needs a moment to move the vdev into the started state. */
+	qdf_sleep(50);
+
+	peer_param.peer_addr = sta_adapter->mac_addr.bytes;
+	peer_param.vdev_id = vdev_id;
+	peer_param.peer_type = WMI_PEER_TYPE_DEFAULT;
+
+	status = wmi_unified_peer_create_send(wmi_handle, &peer_param);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		hdd_err("Injection: peer create failed %d", status);
+		return false;
+	}
+
+	return true;
+}
+
+/**
+ * hdd_mon_inject_stop_hidden_vdev() - stop hidden vdev and delete self peer
+ * @sta_adapter: the hidden STA adapter
+ *
+ * Return: none
+ */
+static void hdd_mon_inject_stop_hidden_vdev(struct hdd_adapter *sta_adapter)
+{
+	struct hdd_context *hdd_ctx = WLAN_HDD_GET_CTX(sta_adapter);
+	struct vdev_stop_params stop_param = {0};
+	struct peer_delete_cmd_params del_param = {0};
+	wmi_unified_t wmi_handle;
+	uint8_t vdev_id;
+
+	wmi_handle = get_wmi_unified_hdl_from_psoc(hdd_ctx->psoc);
+	if (!wmi_handle)
+		return;
+
+	vdev_id = sta_adapter->deflink->vdev_id;
+
+	memset(&del_param, 0, sizeof(del_param));
+	del_param.vdev_id = vdev_id;
+	wmi_unified_peer_delete_send(wmi_handle, sta_adapter->mac_addr.bytes,
+				     &del_param);
+
+	memset(&stop_param, 0, sizeof(stop_param));
+	stop_param.vdev_id = vdev_id;
+	wmi_unified_vdev_stop_send(wmi_handle, &stop_param);
+}
+
+/**
+ * hdd_mon_inject_create_hidden_sta() - allocate and start a hidden STA vdev
+ * @mon_adapter: the monitor-mode adapter that will use the vdev for injection
+ *
+ * The firmware silently drops frames submitted on a monitor vdev, so a hidden
+ * STA vdev is created alongside the monitor interface. Injection uses this
+ * STA vdev instead of the monitor vdev.
+ *
+ * Return: true on success, false on failure
+ */
+static bool hdd_mon_inject_create_hidden_sta(struct hdd_adapter *mon_adapter)
+{
+	struct hdd_context *hdd_ctx = WLAN_HDD_GET_CTX(mon_adapter);
+	struct hdd_adapter_create_param params = {0};
+	struct hdd_adapter *sta_adapter;
+	uint8_t *mac_addr;
+
+	if (hdd_mon_inject_sta_adapter) {
+		sta_adapter = hdd_get_adapter_by_macaddr(hdd_ctx,
+					hdd_mon_inject_sta_adapter->mac_addr.bytes);
+		if (sta_adapter == hdd_mon_inject_sta_adapter)
+			return true;
+		/* Stale pointer left behind after a mode switch. */
+		hdd_mon_inject_sta_adapter = NULL;
+	}
+
+	if (mon_adapter->device_mode != QDF_MONITOR_MODE)
+		return false;
+
+	mac_addr = wlan_hdd_get_intf_addr(hdd_ctx, QDF_STA_MODE);
+	if (!mac_addr) {
+		hdd_err("Injection: failed to get STA MAC address");
+		return false;
+	}
+
+	sta_adapter = hdd_open_adapter(hdd_ctx, QDF_STA_MODE, "null",
+				       mac_addr, NET_NAME_UNKNOWN, true,
+				       &params);
+	if (!sta_adapter) {
+		hdd_err("Injection: failed to open hidden STA adapter");
+		wlan_hdd_release_intf_addr(hdd_ctx, mac_addr);
+		return false;
+	}
+
+	if (hdd_start_adapter(sta_adapter, true)) {
+		hdd_err("Injection: failed to start hidden STA adapter");
+		goto err_close;
+	}
+
+	if (!hdd_mon_inject_start_hidden_vdev(sta_adapter, mon_adapter)) {
+		hdd_err("Injection: hidden STA vdev start failed");
+		goto err_stop;
+	}
+
+	hdd_mon_inject_sta_adapter = sta_adapter;
+	return true;
+
+err_stop:
+	hdd_stop_adapter(hdd_ctx, sta_adapter);
+err_close:
+	hdd_close_adapter(hdd_ctx, sta_adapter, true);
+	wlan_hdd_release_intf_addr(hdd_ctx, mac_addr);
+	return false;
+}
+
+/**
+ * hdd_mon_inject_destroy_hidden_sta() - tear down the hidden STA vdev
+ * @mon_adapter: the monitor-mode adapter that owns the hidden STA vdev
+ *
+ * Return: none
+ */
+static void hdd_mon_inject_destroy_hidden_sta(struct hdd_adapter *mon_adapter)
+{
+	struct hdd_context *hdd_ctx = WLAN_HDD_GET_CTX(mon_adapter);
+	struct hdd_adapter *sta_adapter = hdd_mon_inject_sta_adapter;
+	struct qdf_mac_addr mac_addr;
+
+	if (!sta_adapter)
+		return;
+
+	hdd_mon_inject_sta_adapter = NULL;
+
+	qdf_copy_macaddr(&mac_addr, &sta_adapter->mac_addr);
+	hdd_mon_inject_stop_hidden_vdev(sta_adapter);
+	hdd_stop_adapter(hdd_ctx, sta_adapter);
+	hdd_deinit_adapter(hdd_ctx, sta_adapter, true);
+	hdd_close_adapter(hdd_ctx, sta_adapter, true);
+	wlan_hdd_release_intf_addr(hdd_ctx, mac_addr.bytes);
+}
+#endif
