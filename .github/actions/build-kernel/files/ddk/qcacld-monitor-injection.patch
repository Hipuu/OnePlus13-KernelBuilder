+/*
+ * Firmware mgmt TX on the ghost STA accepts broadcast without a DA peer,
+ * but unicast completions return status=1 unless a WMI peer exists for the
+ * destination. Create peers on demand (best-effort; failures still attempt TX).
+ * Called without g_inj.lock held; takes the lock around the cache only.
+ */
+static void hdd_mon_inject_ensure_peer(struct wmi_unified *wmi, uint8_t vdev_id,
+				       const uint8_t *mac)
+{
+	struct peer_create_params pcreate = {0};
+	QDF_STATUS status;
+	uint8_t i, count;
+	uint8_t slot;
+
+	if (!wmi || !mac)
+		return;
+	if (is_broadcast_ether_addr(mac) || is_multicast_ether_addr(mac) ||
+	    is_zero_ether_addr(mac))
+		return;
+
+	/*
+	 * Never peer the monitored AP's own BSSID.  peach-v2 cmnos-asserts
+	 * ~230-250 ms after a PEER_CREATE for it on the ghost vdev, and
+	 * aireplay-ng's directed deauth emits exactly that frame
+	 * (addr1 = AP BSSID, addr2 = victim) as the second half of every
+	 * iteration -- so without this gate every wifite deauth attack
+	 * hangs the firmware.
+	 *
+	 * The cache is populated in process context before the helper goes
+	 * ready (and refreshed by the reaper), so the window where it is
+	 * still invalid is only the helper-create path itself, which
+	 * transmits nothing.  When it IS invalid we fall through and peer
+	 * normally: a false negative costs one assert, a false positive
+	 * would silently break unicast injection to a real station.
+	 */
+	if (g_inj.ap_bssid_valid && ether_addr_equal(g_inj.ap_bssid, mac))
+		return;
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	count = g_inj.peer_count;
+	for (i = 0; i < count && i < HDD_MON_INJECT_PEER_MAX; i++) {
+		if (ether_addr_equal(g_inj.peer_mac[i], mac)) {
+			qdf_spin_unlock_bh(&g_inj.lock);
+			return;
+		}
+	}
+	if (count >= HDD_MON_INJECT_PEER_MAX) {
+		/* Evict oldest (slot 0); FW may retain stale peer — best effort. */
+		slot = 0;
+		qdf_mem_copy(g_inj.peer_mac[0], mac, QDF_MAC_ADDR_SIZE);
+	} else {
+		slot = count;
+		qdf_mem_copy(g_inj.peer_mac[slot], mac, QDF_MAC_ADDR_SIZE);
+		g_inj.peer_count = count + 1;
+	}
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	{
+		uint8_t mac_copy[QDF_MAC_ADDR_SIZE];
+
+		ether_addr_copy(mac_copy, mac);
+		pcreate.vdev_id = vdev_id;
+		pcreate.peer_addr = mac_copy;
+		pcreate.peer_type = WMI_PEER_TYPE_DEFAULT;
+		status = wmi_unified_peer_create_send(wmi, &pcreate);
+	}
+	if (QDF_IS_STATUS_ERROR(status)) {
+		hdd_err("Injection: PEER_CREATE for %pM failed (%d)", mac, status);
+		return;
+	}
+	/* No sleep here: ndo_start_xmit must not block. FW create is async;
+	 * first unicast after peer create may still fail; later frames OK.
+	 */
+	hdd_info("Injection: PEER_CREATE for unicast DA %pM on vdev %u", mac,
+		 vdev_id);
+}
