+static netdev_tx_t hdd_mon_hard_start_xmit(struct sk_buff *skb,
+					   struct net_device *dev)
+{
+	struct hdd_adapter *adapter = WLAN_HDD_GET_PRIV_PTR(dev);
+	struct hdd_adapter *sta_adapter;
+	struct hdd_context *hdd_ctx;
+	struct wlan_hdd_link_info *link_info;
+	struct wlan_objmgr_vdev *vdev;
+	struct wlan_objmgr_pdev *pdev;
+	struct wlan_objmgr_peer *peer;
+	struct ieee80211_hdr *hdr;
+	struct wmi_mgmt_params mgmt_param = {0};
+	uint32_t frame_len;
+	uint8_t pdev_id;
+	QDF_STATUS status;
+
+	if (!adapter) {
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	hdd_ctx = WLAN_HDD_GET_CTX(adapter);
+	if (wlan_hdd_validate_context(hdd_ctx))
+		goto drop;
+
+	if (!READ_ONCE(hdd_mon_inject_ready)) {
+		hdd_debug_rl("Injection: hidden STA is not ready");
+		goto drop;
+	}
+
+	sta_adapter = READ_ONCE(hdd_mon_inject_sta_adapter);
+	if (!sta_adapter)
+		goto drop;
+
+	link_info = sta_adapter->deflink;
+	if (!link_info || wlan_hdd_validate_vdev_id(link_info->vdev_id))
+		goto drop;
+
+	if (skb_linearize(skb) || hdd_mon_strip_radiotap(skb)) {
+		hdd_debug_rl("Injection: malformed radiotap frame");
+		goto drop;
+	}
+
+	hdr = (struct ieee80211_hdr *)skb->data;
+	if (!ieee80211_is_mgmt(hdr->frame_control)) {
+		hdd_debug_rl("Injection: only management frames are supported");
+		goto drop;
+	}
+
+	/* Match the host and firmware self-peer used by the hidden STA. */
+	qdf_mem_copy(hdr->addr2, hdd_mon_inject_peer_addr.bytes, ETH_ALEN);
+	qdf_mem_copy(hdr->addr3, hdd_mon_inject_peer_addr.bytes, ETH_ALEN);
+	frame_len = skb->len;
