+/* Forward declarations â always visible (referenced outside #ifdef). */
+static void hdd_mon_inject_tx_enable_work(struct work_struct *work);
+
+/* Always declare: referenced from suspend/resume paths and injection functions. */
+static DECLARE_DELAYED_WORK(hdd_mon_inject_tx_enable_dw,
+			    hdd_mon_inject_tx_enable_work);
+static struct hdd_adapter *hdd_mon_inject_tx_enable_adapter;
+
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+
+#define HDD_MON_MIN_80211_LEN 24
+
+struct hdd_mon_radiotap_hdr {
+	uint8_t it_version;
+	uint8_t it_pad;
+	uint16_t it_len;
+	uint32_t it_present;
+} __packed;
+
+static int hdd_mon_inject_strip_radiotap(struct sk_buff *skb)
+{
+	struct hdd_mon_radiotap_hdr *rthdr;
+	uint16_t rtap_len;
+
+	if (skb->len < sizeof(*rthdr))
+		return -EINVAL;
+
+	rthdr = (struct hdd_mon_radiotap_hdr *)skb->data;
+	if (rthdr->it_version != 0)
+		return -EINVAL;
+
+	rtap_len = le16_to_cpu(rthdr->it_len);
+	if (rtap_len < sizeof(*rthdr) || rtap_len > skb->len ||
+	    skb->len - rtap_len < HDD_MON_MIN_80211_LEN)
+		return -EINVAL;
+
+	skb_pull(skb, rtap_len);
+	return 0;
+}
+
+static bool hdd_mon_inject_get_channel(struct hdd_adapter *mon_adapter,
+				       struct wlan_channel *channel)
+{
+	struct wlan_objmgr_vdev *vdev;
+	struct wlan_channel *source;
+	bool valid = false;
+
+	vdev = hdd_objmgr_get_vdev_by_user(mon_adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev)
+		return false;
+
+	source = wlan_vdev_mlme_get_bss_chan(vdev);
+	if (!source || !source->ch_freq)
+		source = wlan_vdev_mlme_get_des_chan(vdev);
+
+	if (source && source->ch_freq) {
+		qdf_mem_copy(channel, source, sizeof(*channel));
+		valid = true;
+	}
+
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+	return valid;
+}
+
+static void hdd_mon_inject_stop(struct hdd_adapter *adapter)
+{
+	cancel_delayed_work_sync(&hdd_mon_inject_tx_enable_dw);
+	hdd_mon_inject_tx_enable_adapter = NULL;
+}
+
+/* Delayed work: enable carrier + TX queues after hdd_start_adapter finishes */
+static void hdd_mon_inject_tx_enable_work(struct work_struct *work)
+{
+	struct hdd_adapter *adapter;
+	struct net_device *dev;
+
+	/* Recover adapter from the global we stashed in __hdd_mon_open */
+	adapter = hdd_mon_inject_tx_enable_adapter;
+	if (!adapter)
+		return;
+	dev = adapter->dev;
+	if (!dev)
+		return;
+
+	netif_carrier_on(dev);
+	netif_tx_wake_all_queues(dev);
+	hdd_info("Injection: carrier on + TX queues woken (deferred)");
+}
+
+#else /* !FEATURE_MONITOR_MODE_SUPPORT */
+
+/* Stub: forward-declared above; defined here for the !FEATURE case. */
+static void hdd_mon_inject_tx_enable_work(struct work_struct *work) {}
+
+#endif /* FEATURE_MONITOR_MODE_SUPPORT */
