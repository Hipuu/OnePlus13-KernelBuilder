+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+
+#define HDD_MON_MIN_80211_LEN 24
+
+struct hdd_mon_radiotap_hdr {
+	uint8_t it_version;
+	uint8_t it_pad;
+	uint16_t it_len;
+	uint32_t it_present;
+} __packed;
+
+static uint32_t hdd_mon_inject_chan_freq;
+
+static int hdd_mon_inject_strip_radiotap(struct sk_buff *skb)
+{
+	struct hdd_mon_radiotap_hdr *rthdr;
+	uint16_t rtap_len;
+
+	if (skb->len < sizeof(*rthdr))
+		return -EINVAL;
+
+	rthdr = (struct hdd_mon_radiotap_hdr *)skb->data;
+	if (rthdr->it_version != 0)
+		return -EINVAL;
+
+	rtap_len = le16_to_cpu(rthdr->it_len);
+	if (rtap_len < sizeof(*rthdr) || rtap_len > skb->len ||
+	    skb->len - rtap_len < HDD_MON_MIN_80211_LEN)
+		return -EINVAL;
+
+	skb_pull(skb, rtap_len);
+	return 0;
+}
+
+static bool hdd_mon_inject_get_channel(struct hdd_adapter *mon_adapter,
+				       struct wlan_channel *channel)
+{
+	struct wlan_objmgr_vdev *vdev;
+	struct wlan_channel *source;
+	bool valid = false;
+
+	vdev = hdd_objmgr_get_vdev_by_user(mon_adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev)
+		return false;
+
+	source = wlan_vdev_mlme_get_bss_chan(vdev);
+	if (!source || !source->ch_freq)
+		source = wlan_vdev_mlme_get_des_chan(vdev);
+
+	if (source && source->ch_freq) {
+		qdf_mem_copy(channel, source, sizeof(*channel));
+		valid = true;
+	}
+
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+	return valid;
+}
+
+/**
+ * hdd_mon_inject_set_channel() - create or reconfigure injection helper
+ * @adapter: monitor adapter
+ * @chanfreq: channel frequency in MHz (0 = read from vdev, fallback 2412)
+ *
+ * Calls wma_mon_inject_setup unconditionally so the helper vdev exists
+ * regardless of whether the monitor vdev's own VDEV_START succeeded.
+ */
+static bool hdd_mon_inject_set_channel(struct hdd_adapter *adapter,
+				       uint32_t chanfreq)
+{
+	struct wlan_channel channel = {0};
+
+	if (!adapter || !adapter->deflink)
+		return false;
+
+	if (!chanfreq) {
+		if (!hdd_mon_inject_get_channel(adapter, &channel) ||
+		    !channel.ch_freq) {
+			chanfreq = 2412;
+			hdd_info("Injection: no monitor channel, defaulting to %u MHz",
+				 chanfreq);
+		} else {
+			chanfreq = channel.ch_freq;
+		}
+	}
+
+	if (wma_mon_inject_setup(adapter->deflink->vdev_id,
+				 chanfreq) != 0) {
+		hdd_err("Injection: failed to start helper vdev on %u MHz",
+			chanfreq);
+		return false;
+	}
+
+	hdd_mon_inject_chan_freq = chanfreq;
+	hdd_info("Injection: helper ready on %u MHz", chanfreq);
+	return true;
+}
+
+static void hdd_mon_inject_stop(struct hdd_adapter *adapter)
+{
+	wma_mon_inject_teardown();
+	hdd_mon_inject_chan_freq = 0;
+}
+
+#endif /* FEATURE_MONITOR_MODE_SUPPORT */
+
 /**
  * __hdd_mon_open() - HDD Open function
  * @dev: Pointer to net_device structure
@@ -3523,6 +3623,17 @@ static int __hdd_mon_open(struct net_device *dev)
 		param.policy = BBM_DRIVER_MODE_POLICY;
 		param.policy_info.driver_mode = QDF_GLOBAL_MONITOR_MODE;
 		ucfg_dp_bbm_apply_independent_policy(hdd_ctx->psoc, &param);
+		if (!hdd_mon_inject_set_channel(adapter, 2412))
+			hdd_err("Injection: initial channel setup failed");
+
+		/*
+		 * Enable carrier and TX queues so frames can reach
+		 * ndo_start_xmit.  qcacld leaves all adapters in
+		 * carrier-off / queues-stopped after hdd_start_adapter().
+		 */
+		netif_carrier_on(dev);
+		netif_tx_wake_all_queues(dev);
+
 		ucfg_dp_set_current_throughput_level(hdd_ctx->psoc,
 						     PLD_BUS_WIDTH_VERY_HIGH);
 	}
@@ -5875,6 +5977,11 @@ int hdd_stop_no_trans(struct net_device *dev)
 	if (WLAN_HDD_IS_NDI(adapter))
 		goto reset_iface_opened;
 
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+	if (wlan_hdd_is_session_type_monitor(adapter->device_mode))
+		hdd_mon_inject_stop(adapter);
+#endif
+
 	/*
 	 * The interface is marked as down for outside world (aka kernel)
 	 * But the driver is pretty much alive inside. The driver needs to
@@ -7306,10 +7413,52 @@ static const struct net_device_ops wlan_drv_ops = {
 };
 
 #ifdef FEATURE_MONITOR_MODE_SUPPORT
-/* Monitor mode net_device_ops, does not Tx and most of operations. */
+
+static netdev_tx_t hdd_mon_hard_start_xmit(struct sk_buff *skb,
+					   struct net_device *dev)
+{
+	struct hdd_adapter *adapter = WLAN_HDD_GET_PRIV_PTR(dev);
+	struct ieee80211_hdr *hdr;
+
+	if (!adapter) {
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	if (wlan_hdd_validate_context(WLAN_HDD_GET_CTX(adapter))) {
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	if (skb_linearize(skb) || hdd_mon_inject_strip_radiotap(skb)) {
+		hdd_debug_rl("Injection: malformed radiotap frame");
+		goto drop;
+	}
+
+	hdr = (struct ieee80211_hdr *)skb->data;
+	if (!ieee80211_is_mgmt(hdr->frame_control)) {
+		hdd_debug_rl("Injection: only management frames are supported");
+		goto drop;
+	}
+
+	if (wma_mon_inject_tx(skb, hdd_mon_inject_chan_freq) == 0) {
+		dev->stats.tx_packets++;
+		dev->stats.tx_bytes += skb->len;
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+drop:
+	dev->stats.tx_dropped++;
+	qdf_nbuf_free(skb);
+	return NETDEV_TX_OK;
+}
+
+/* Monitor mode net_device_ops with management-frame injection support. */
 static const struct net_device_ops wlan_mon_drv_ops = {
 	.ndo_open = hdd_mon_open,
 	.ndo_stop = hdd_stop,
+	.ndo_start_xmit = hdd_mon_hard_start_xmit,
 	.ndo_get_stats = hdd_get_stats,
 };
 
@@ -11423,7 +11572,19 @@ int wlan_hdd_set_mon_chan(struct hdd_adapter *adapter)
 			adapter->monitor_mode_vdev_up_in_progress = false;
 		}
 	}
-		return qdf_status_to_os_return(status);
+
+	/*
+	 * Set up the injection helper unconditionally, even when
+	 * VDEV_START returned failure or timed out.  The helper
+	 * is a separate STA vdev that does not depend on the
+	 * monitor vdev's start state.
+	 */
+	if (!hdd_mon_inject_set_channel(adapter, 0)) {
+		hdd_err("Injection: failed to set helper channel after mon_chan change");
+		/* Non-fatal — monitor capture still works. */
+	}
+
+	return qdf_status_to_os_return(status);
 }
 #endif
 
diff --git a/core/wma/inc/wma_frame_inject.h b/core/wma/inc/wma_frame_inject.h
new file mode 100644
index 00000000..2a3b4c89
--- /dev/null
+++ b/core/wma/inc/wma_frame_inject.h
@@ -0,0 +1,73 @@
+/*
+ * Copyright (c) 2024 The Linux Foundation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef WMA_FRAME_INJECT_H
+#define WMA_FRAME_INJECT_H
+
+#include <qdf_types.h>
+#include <qdf_nbuf.h>
+
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+
+QDF_STATUS wma_mon_inject_init(void);
+void wma_mon_inject_deinit(void);
+
+/**
+ * wma_mon_inject_setup() - create a firmware-only helper vdev for injection
+ * @mon_vdev_id: monitor vdev id (used to avoid slot collision)
+ * @chanfreq: channel frequency in MHz
+ *
+ * Creates a lightweight STA vdev in firmware with a self-peer on the
+ * requested channel, using msleep() waits instead of event-based
+ * synchronization.  Firmware WMI responses for the helper vdev pass
+ * through standard paths harmlessly (no host vdev object → null timer
+ * check → early return).
+ *
+ * Return: 0 on success, negative errno on failure.
+ */
+int wma_mon_inject_setup(uint8_t mon_vdev_id, uint32_t chanfreq);
+
+/**
+ * wma_mon_inject_teardown() - destroy the helper vdev
+ *
+ * Stops new TX, flushes in-flight buffers, then sends
+ * PEER_DELETE -> VDEV_STOP -> VDEV_DELETE with msleep() gaps.
+ */
+void wma_mon_inject_teardown(void);
+
+/**
+ * wma_mon_inject_tx() - transmit a management frame through the helper vdev
+ * @skb: 802.11 management frame (radiotap already stripped)
+ * @chanfreq: channel frequency in MHz
+ *
+ * The caller retains ownership of @skb on both success and failure.
+ * The WMI layer copies frame data into its own buffer.
+ *
+ * Return: 0 on success, negative errno on failure.
+ */
+int wma_mon_inject_tx(struct sk_buff *skb, uint32_t chanfreq);
+
+/**
+ * wma_mon_inject_tx_complete() - handle TX completion for injection desc_ids
+ * @desc_id: WMI descriptor ID from the completion event
+ * @status: firmware completion status
+ *
+ * Return: true if this desc_id belongs to injection (consumed), false otherwise
+ */
+bool wma_mon_inject_tx_complete(uint32_t desc_id, uint32_t status);
+
+#else /* FEATURE_MONITOR_MODE_SUPPORT */
+
+static inline QDF_STATUS wma_mon_inject_init(void) { return QDF_STATUS_SUCCESS; }
+static inline void wma_mon_inject_deinit(void) {}
+static inline int wma_mon_inject_setup(uint8_t mon_vdev_id, uint32_t chanfreq) { return -EINVAL; }
+static inline void wma_mon_inject_teardown(void) {}
+static inline int wma_mon_inject_tx(struct sk_buff *skb, uint32_t chanfreq) { return -EINVAL; }
+static inline bool wma_mon_inject_tx_complete(uint32_t desc_id, uint32_t status) { return false; }
+
+#endif /* FEATURE_MONITOR_MODE_SUPPORT */
+
+#endif /* WMA_FRAME_INJECT_H */
diff --git a/core/wma/src/wma_frame_inject.c b/core/wma/src/wma_frame_inject.c
new file mode 100644
index 00000000..3f8c2d11
--- /dev/null
+++ b/core/wma/src/wma_frame_inject.c
@@ -0,0 +1,656 @@
+/*
+ * Copyright (c) 2024 The Linux Foundation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Monitor-mode management frame injection through a hidden helper STA vdev.
+ *
+ * The firmware's management TX handler rejects frames on MONITOR vdevs.
+ * Work around this by creating a lightweight STA vdev on the monitor
+ * channel.  The STA vdev has a self-peer so firmware can transmit the
+ * management frame through the standard peer-lookup -> WAL-TX path.
+ *
+ * Lifecycle uses msleep() instead of qdf_event_wait: no response
+ * interception hooks are needed because the helper vdev intentionally
+ * has no host wlan_objmgr_vdev object.  Firmware WMI responses arrive
+ * through standard handlers, which find a null vdev and return early.
+ *
+ * Skip VDEV_UP: for STA vdevs, firmware asserts unless a BSS peer
+ * (the AP) exists.  The mgmt TX handler only needs the vdev in
+ * STARTED state with a valid peer.
+ *
+ * A qdf_delayed_work reaper runs every 3 seconds to free stale
+ * in-flight nbufs whose TX completions never arrive (firmware does
+ * not send completions for the helper vdev's management frames).
+ */
+
+#include <linux/delay.h>
+
+#include "wma_frame_inject.h"
+#include "wma.h"
+#include "wma_api.h"
+#include "wma_internal.h"
+#include "wmi_unified_api.h"
+#include "wmi_unified.h"
+#include "wlan_vdev_mgr_tgt_if_tx_defs.h"
+#include "qdf_lock.h"
+#include "qdf_mem.h"
+#include "qdf_nbuf.h"
+#include "qdf_delayed_work.h"
+#include "qdf_time.h"
+#include "qdf_atomic.h"
+#include "cds_api.h"
+#include <linux/ieee80211.h>
+
+#define WMA_MON_INJECT_MAX_VDEV		(CFG_TGT_NUM_VDEV - 2)
+#define WMA_MON_INJECT_MAX_INFLIGHT	64
+#define WMA_MON_INJECT_DESC_ID_BASE	0x8001
+#define WMA_MON_INJECT_DESC_ID_MASK	0x0FFF
+#define WMA_MON_INJECT_REAPER_INTERVAL_MS	3000
+#define WMA_MON_INJECT_REAPER_STALE_MS		2000
+#define WMA_MON_INJECT_SETUP_SLEEP_MS		150
+#define WMA_MON_INJECT_PEER_SLEEP_MS		100
+#define WMA_MON_INJECT_TEARDOWN_SLEEP_MS	100
+
+enum wma_mon_inject_state {
+	WMA_MON_INJECT_DOWN,
+	WMA_MON_INJECT_UP,
+	WMA_MON_INJECT_STOPPING,
+};
+
+struct wma_mon_inject_nbuf {
+	qdf_nbuf_t nbuf;
+	uint16_t desc_id;
+	unsigned long submit_jiffies;
+	bool valid;
+};
+
+struct wma_mon_inject_ctx {
+	bool initialized;
+	enum wma_mon_inject_state state;
+	uint8_t vdev_id;
+	uint8_t mon_vdev_id;
+	uint32_t chanfreq;
+	uint8_t mac_addr[QDF_MAC_ADDR_SIZE];
+	qdf_mutex_t lifecycle_lock;
+	qdf_spinlock_t state_lock;
+	struct wma_mon_inject_nbuf inflight[WMA_MON_INJECT_MAX_INFLIGHT];
+	qdf_atomic_t inflight_count;
+	uint16_t next_desc_id;
+	struct qdf_delayed_work reaper;
+};
+
+static struct wma_mon_inject_ctx g_inj;
+
+/* ---- DMA unmap helper ---- */
+
+static void wma_mon_inject_unmap_nbuf(qdf_nbuf_t nbuf)
+{
+	void *qdf_ctx = cds_get_context(QDF_MODULE_ID_QDF_DEVICE);
+
+	if (qdf_ctx && nbuf)
+		qdf_nbuf_unmap_single(qdf_ctx, nbuf, QDF_DMA_TO_DEVICE);
+}
+
+/* ---- descriptor helpers ---- */
+
+static bool wma_mon_inject_is_desc_id(uint32_t desc_id)
+{
+	return desc_id >= WMA_MON_INJECT_DESC_ID_BASE &&
+	       desc_id <= (WMA_MON_INJECT_DESC_ID_BASE +
+			   WMA_MON_INJECT_DESC_ID_MASK);
+}
+
+static uint16_t wma_mon_inject_desc_id_alloc(void)
+{
+	uint16_t id = g_inj.next_desc_id;
+
+	g_inj.next_desc_id++;
+	if ((g_inj.next_desc_id & ~WMA_MON_INJECT_DESC_ID_MASK) !=
+	    WMA_MON_INJECT_DESC_ID_BASE)
+		g_inj.next_desc_id = WMA_MON_INJECT_DESC_ID_BASE + 1;
+
+	return id;
+}
+
+/* ---- reaper: free stale in-flight nbufs ---- */
+
+static void wma_mon_inject_reaper_cb(void *context)
+{
+	unsigned long now = jiffies;
+	unsigned long stale_jiffies =
+		msecs_to_jiffies(WMA_MON_INJECT_REAPER_STALE_MS);
+	uint32_t reaped = 0;
+	int i;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+
+	if (g_inj.state != WMA_MON_INJECT_UP) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		return;
+	}
+
+	for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+		struct wma_mon_inject_nbuf *n = &g_inj.inflight[i];
+
+		if (!n->valid || !n->nbuf)
+			continue;
+
+		if (time_after(now, n->submit_jiffies + stale_jiffies)) {
+			qdf_nbuf_t buf = n->nbuf;
+			n->nbuf = NULL;
+			n->valid = false;
+			qdf_spin_unlock_bh(&g_inj.state_lock);
+			wma_mon_inject_unmap_nbuf(buf);
+			qdf_nbuf_free(buf);
+			qdf_spin_lock_bh(&g_inj.state_lock);
+			reaped++;
+		}
+	}
+
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	if (reaped) {
+		qdf_atomic_sub(reaped, &g_inj.inflight_count);
+		wma_info("Injection reaper: freed %u stale nbufs", reaped);
+	}
+
+	/* Re-arm */
+	if (g_inj.initialized && g_inj.state == WMA_MON_INJECT_UP)
+		qdf_delayed_work_start(&g_inj.reaper,
+				       WMA_MON_INJECT_REAPER_INTERVAL_MS);
+}
+
+/* ---- inflight tracking ---- */
+
+static void wma_mon_inject_flush_inflight(void)
+{
+	qdf_nbuf_t pending[WMA_MON_INJECT_MAX_INFLIGHT] = {0};
+	int count = 0;
+	int i;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+		if (!g_inj.inflight[i].valid)
+			continue;
+		pending[count++] = g_inj.inflight[i].nbuf;
+		g_inj.inflight[i].nbuf = NULL;
+		g_inj.inflight[i].valid = false;
+	}
+	if (count)
+		qdf_atomic_sub(count, &g_inj.inflight_count);
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	for (i = 0; i < count; i++) {
+		wma_mon_inject_unmap_nbuf(pending[i]);
+		qdf_nbuf_free(pending[i]);
+	}
+}
+
+/* ---- TX completion ---- */
+
+bool wma_mon_inject_tx_complete(uint32_t desc_id, uint32_t status)
+{
+	qdf_nbuf_t nbuf = NULL;
+	int i;
+
+	if (!wma_mon_inject_is_desc_id(desc_id))
+		return false;
+
+	if (!g_inj.initialized)
+		return true;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+		if (g_inj.inflight[i].valid &&
+		    g_inj.inflight[i].desc_id == desc_id) {
+			nbuf = g_inj.inflight[i].nbuf;
+			g_inj.inflight[i].nbuf = NULL;
+			g_inj.inflight[i].valid = false;
+			break;
+		}
+	}
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	if (nbuf) {
+		qdf_atomic_dec(&g_inj.inflight_count);
+		wma_mon_inject_unmap_nbuf(nbuf);
+		qdf_nbuf_free(nbuf);
+	} else
+		wma_debug("Injection: completion for unknown desc_id=%u",
+			  desc_id);
+
+	if (status)
+		wma_debug("Injection: desc_id=%u completed with status=%u",
+			  desc_id, status);
+
+	return true;
+}
+
+/* ---- helper MAC derivation ---- */
+
+static void wma_mon_inject_build_mac(uint8_t *dst, const uint8_t *monitor_mac)
+{
+	qdf_mem_copy(dst, monitor_mac, QDF_MAC_ADDR_SIZE);
+	dst[0] |= 0x02;   /* locally-administered bit */
+	dst[5] ^= 0x01;   /* flip last bit for uniqueness */
+
+	/* Guard: if the derived MAC still equals the monitor MAC (e.g.
+	 * monitor already had locally-administered + odd last byte),
+	 * flip bit 1 instead to guarantee a distinct address.
+	 */
+	if (!qdf_mem_cmp(dst, monitor_mac, QDF_MAC_ADDR_SIZE))
+		dst[5] ^= 0x02;
+}
+
+/* ---- find free firmware vdev slot ---- */
+
+static QDF_STATUS
+wma_mon_inject_find_vdev_id(tp_wma_handle wma, uint8_t mon_vdev_id,
+			    uint8_t *out_vid)
+{
+	int i;
+	int fw_max;
+
+	fw_max = WMA_MON_INJECT_MAX_VDEV;
+	if (fw_max >= (int)wma->max_bssid)
+		fw_max = (int)wma->max_bssid - 1;
+
+	for (i = fw_max; i >= 0; i--) {
+		if ((uint8_t)i == mon_vdev_id)
+			continue;
+		if (!wma->interfaces[i].vdev) {
+			*out_vid = (uint8_t)i;
+			return QDF_STATUS_SUCCESS;
+		}
+	}
+
+	return QDF_STATUS_E_RESOURCES;
+}
+
+/* ---- teardown (reverse of setup) ---- */
+
+static void wma_mon_inject_do_teardown(tp_wma_handle wma)
+{
+	struct peer_delete_cmd_params pdel = {0};
+	struct vdev_stop_params vstop = {0};
+	uint8_t vdev_id;
+	uint8_t mac_addr[QDF_MAC_ADDR_SIZE];
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	if (g_inj.state == WMA_MON_INJECT_DOWN) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		return;
+	}
+	g_inj.state = WMA_MON_INJECT_STOPPING;
+	vdev_id = g_inj.vdev_id;
+	qdf_mem_copy(mac_addr, g_inj.mac_addr, sizeof(mac_addr));
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	/* Stop the reaper before sending WMI teardown commands */
+	qdf_delayed_work_stop_sync(&g_inj.reaper);
+
+	/* Flush in-flight nbufs — firmware won't complete them */
+	wma_mon_inject_flush_inflight();
+
+	if (wma && wma->wmi_handle) {
+		/* 1. PEER_DELETE */
+		pdel.vdev_id = vdev_id;
+		wmi_unified_peer_delete_send(wma->wmi_handle,
+					     mac_addr, &pdel);
+		msleep(WMA_MON_INJECT_TEARDOWN_SLEEP_MS);
+
+		/* 2. VDEV_STOP (we did VDEV_START during setup) */
+		vstop.vdev_id = vdev_id;
+		wmi_unified_vdev_stop_send(wma->wmi_handle, &vstop);
+		msleep(WMA_MON_INJECT_TEARDOWN_SLEEP_MS);
+
+		/* 3. VDEV_DELETE */
+		wmi_unified_vdev_delete_send(wma->wmi_handle, vdev_id);
+		msleep(WMA_MON_INJECT_TEARDOWN_SLEEP_MS);
+	}
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	g_inj.state = WMA_MON_INJECT_DOWN;
+	g_inj.vdev_id = 0;
+	g_inj.mon_vdev_id = 0;
+	g_inj.chanfreq = 0;
+	qdf_mem_zero(g_inj.mac_addr, sizeof(g_inj.mac_addr));
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	wma_info("Injection: helper vdev torn down");
+}
+
+/* ---- setup: VDEV_CREATE -> VDEV_START -> PEER_CREATE with msleep ---- */
+
+int wma_mon_inject_setup(uint8_t mon_vdev_id, uint32_t chanfreq)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct vdev_create_params vcreate = {0};
+	struct vdev_start_params vstart = {0};
+	struct peer_create_params pcreate = {0};
+	uint8_t helper_mac[QDF_MAC_ADDR_SIZE];
+	uint8_t *monitor_mac;
+	QDF_STATUS status;
+	uint8_t vdev_id;
+	int ret = -EIO;
+
+	if (!g_inj.initialized || !wma || !wma->wmi_handle || !chanfreq)
+		return -EINVAL;
+
+	status = qdf_mutex_acquire(&g_inj.lifecycle_lock);
+	if (QDF_IS_STATUS_ERROR(status))
+		return -EAGAIN;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	if (g_inj.state == WMA_MON_INJECT_UP &&
+	    g_inj.chanfreq == chanfreq) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		ret = 0;
+		goto out_unlock;
+	}
+
+	if (g_inj.state == WMA_MON_INJECT_UP) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		wma_mon_inject_do_teardown(wma);
+	} else if (g_inj.state != WMA_MON_INJECT_DOWN) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		ret = -EBUSY;
+		goto out_unlock;
+	} else {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+	}
+
+	/* Validate monitor vdev */
+	if (mon_vdev_id >= wma->max_bssid ||
+	    !wma->interfaces[mon_vdev_id].vdev) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+
+	/* Find free firmware vdev slot */
+	status = wma_mon_inject_find_vdev_id(wma, mon_vdev_id, &vdev_id);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+
+	/* Derive helper MAC from monitor MAC */
+	monitor_mac =
+		wlan_vdev_mlme_get_macaddr(wma->interfaces[mon_vdev_id].vdev);
+	if (!monitor_mac) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	wma_mon_inject_build_mac(helper_mac, monitor_mac);
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	g_inj.vdev_id = vdev_id;
+	g_inj.mon_vdev_id = mon_vdev_id;
+	g_inj.chanfreq = chanfreq;
+	qdf_mem_copy(g_inj.mac_addr, helper_mac, sizeof(helper_mac));
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	/* ---- 1. VDEV CREATE (STA type) ----
+	 * STA, not AP: AP vdevs trigger firmware beacon-TX-offload
+	 * which crashes because no beacon template exists.
+	 */
+	vcreate.vdev_id = vdev_id;
+	vcreate.type = WMI_VDEV_TYPE_STA;
+	vcreate.subtype = 0;
+	vcreate.nss_2g = 1;
+	vcreate.nss_5g = 1;
+	vcreate.pdev_id = 0;
+
+	status = wmi_unified_vdev_create_send(wma->wmi_handle,
+					      helper_mac, &vcreate);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: vdev create failed: %d", status);
+		goto fail_teardown;
+	}
+	msleep(WMA_MON_INJECT_SETUP_SLEEP_MS);
+
+	/* ---- 2. VDEV START (20 MHz basic mode) ----
+	 * No VDEV_UP: firmware asserts for STA without BSS peer.
+	 */
+	vstart.vdev_id = vdev_id;
+	vstart.channel.mhz = chanfreq;
+	vstart.channel.cfreq1 = chanfreq;
+	vstart.channel.cfreq2 = 0;
+	vstart.channel.phy_mode = (chanfreq < 4000) ? WLAN_PHYMODE_11G
+						    : WLAN_PHYMODE_11A;
+	vstart.channel.maxregpower = 20;
+	vstart.channel.maxpower = 20;
+	vstart.channel.pwr = 20;
+	vstart.beacon_interval = 0;
+	vstart.dtim_period = 0;
+
+	status = wmi_unified_vdev_start_send(wma->wmi_handle, &vstart);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: vdev start failed: %d", status);
+		goto fail_teardown;
+	}
+	msleep(WMA_MON_INJECT_SETUP_SLEEP_MS);
+
+	/* ---- 3. PEER CREATE (self-peer) ---- */
+	pcreate.peer_addr = helper_mac;
+	pcreate.peer_type = WMI_PEER_TYPE_DEFAULT;
+	pcreate.vdev_id = vdev_id;
+
+	status = wmi_unified_peer_create_send(wma->wmi_handle, &pcreate);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: peer create failed: %d", status);
+		goto fail_teardown;
+	}
+	msleep(WMA_MON_INJECT_PEER_SLEEP_MS);
+
+	/* Helper is ready */
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	g_inj.state = WMA_MON_INJECT_UP;
+	g_inj.next_desc_id = WMA_MON_INJECT_DESC_ID_BASE + 1;
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	/* Start the reaper */
+	qdf_delayed_work_start(&g_inj.reaper,
+			       WMA_MON_INJECT_REAPER_INTERVAL_MS);
+
+	wma_info("Injection: helper vdev %u ready on %u MHz (STA, mac=%pM)",
+		 vdev_id, chanfreq, helper_mac);
+	ret = 0;
+	goto out_unlock;
+
+fail_teardown:
+	wma_mon_inject_do_teardown(wma);
+out_unlock:
+	qdf_mutex_release(&g_inj.lifecycle_lock);
+	return ret;
+}
+
+/* ---- public teardown ---- */
+
+void wma_mon_inject_teardown(void)
+{
+	tp_wma_handle wma;
+	QDF_STATUS status;
+
+	if (!g_inj.initialized)
+		return;
+
+	status = qdf_mutex_acquire(&g_inj.lifecycle_lock);
+	if (QDF_IS_STATUS_ERROR(status))
+		return;
+
+	wma = cds_get_context(QDF_MODULE_ID_WMA);
+	wma_mon_inject_do_teardown(wma);
+	qdf_mutex_release(&g_inj.lifecycle_lock);
+}
+
+/* ---- init / deinit ---- */
+
+QDF_STATUS wma_mon_inject_init(void)
+{
+	QDF_STATUS status;
+
+	if (g_inj.initialized)
+		return QDF_STATUS_SUCCESS;
+
+	qdf_mem_zero(&g_inj, sizeof(g_inj));
+
+	status = qdf_mutex_create(&g_inj.lifecycle_lock);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+
+	qdf_spinlock_create(&g_inj.state_lock);
+
+	status = qdf_delayed_work_create(&g_inj.reaper,
+					 wma_mon_inject_reaper_cb, NULL);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: failed to create reaper: %s:%d",
+			__func__, __LINE__);
+		qdf_spinlock_destroy(&g_inj.state_lock);
+		qdf_mutex_destroy(&g_inj.lifecycle_lock);
+		qdf_mem_zero(&g_inj, sizeof(g_inj));
+		return status;
+	}
+
+	g_inj.next_desc_id = WMA_MON_INJECT_DESC_ID_BASE + 1;
+	qdf_atomic_set(&g_inj.inflight_count, 0);
+	g_inj.state = WMA_MON_INJECT_DOWN;
+	g_inj.initialized = true;
+	return QDF_STATUS_SUCCESS;
+}
+
+void wma_mon_inject_deinit(void)
+{
+	if (!g_inj.initialized)
+		return;
+
+	wma_mon_inject_teardown();
+
+	qdf_delayed_work_stop_sync(&g_inj.reaper);
+	qdf_delayed_work_destroy(&g_inj.reaper);
+	qdf_spinlock_destroy(&g_inj.state_lock);
+	qdf_mutex_destroy(&g_inj.lifecycle_lock);
+	qdf_mem_zero(&g_inj, sizeof(g_inj));
+}
+
+/* ---- TX path ---- */
+
+int wma_mon_inject_tx(struct sk_buff *skb, uint32_t chanfreq)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	void *qdf_ctx = cds_get_context(QDF_MODULE_ID_QDF_DEVICE);
+	struct wmi_mgmt_params mgmt = {0};
+	qdf_nbuf_t wmi_buf;
+	uint8_t *frame_data;
+	uint16_t desc_id;
+	uint8_t vdev_id;
+	QDF_STATUS status;
+	int slot = -1;
+	int i;
+
+	if (!g_inj.initialized || !wma || !wma->wmi_handle ||
+	    !qdf_ctx || !skb)
+		return -EINVAL;
+
+	/* Verify firmware supports WMI management TX path */
+	if (!wmi_service_enabled(wma->wmi_handle,
+				 wmi_service_mgmt_tx_wmi)) {
+		wma_err("Injection: firmware does not support WMI mgmt TX");
+		return -EOPNOTSUPP;
+	}
+
+	/* Backpressure: reject if too many frames are in-flight */
+	if (qdf_atomic_read(&g_inj.inflight_count) >=
+	    WMA_MON_INJECT_MAX_INFLIGHT) {
+		wma_warn("Injection: inflight high-water reached (%u)",
+			 qdf_atomic_read(&g_inj.inflight_count));
+		return -EBUSY;
+	}
+
+	/* Allocate WMI buffer and copy frame data */
+	wmi_buf = qdf_nbuf_alloc(NULL, skb->len, 0, 0, false);
+	if (!wmi_buf)
+		return -ENOMEM;
+
+	frame_data = qdf_nbuf_put_tail(wmi_buf, skb->len);
+	if (!frame_data) {
+		qdf_nbuf_free(wmi_buf);
+		return -ENOMEM;
+	}
+	qdf_mem_copy(frame_data, skb->data, skb->len);
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+
+	if (g_inj.state != WMA_MON_INJECT_UP ||
+	    g_inj.chanfreq != chanfreq) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		qdf_nbuf_free(wmi_buf);
+		return -ENODEV;
+	}
+
+	/* Find a free inflight slot */
+	for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+		if (!g_inj.inflight[i].valid) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < 0) {
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		wma_warn("Injection: inflight table full");
+		qdf_nbuf_free(wmi_buf);
+		return -EBUSY;
+	}
+
+	desc_id = wma_mon_inject_desc_id_alloc();
+	vdev_id = g_inj.vdev_id;
+
+	/* Track the nbuf for completion / reaper cleanup */
+	g_inj.inflight[slot].valid = true;
+	g_inj.inflight[slot].nbuf = wmi_buf;
+	g_inj.inflight[slot].desc_id = desc_id;
+	g_inj.inflight[slot].submit_jiffies = jiffies;
+
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	/*
+	 * Probe-request SA normalization: firmware drops broadcast probe
+	 * requests whose SA does not match a known peer.  Overwrite SA
+	 * (offset 10) with the helper vdev MAC so the self-peer matches.
+	 */
+	if (skb->len >= 24) {
+		struct ieee80211_hdr *wh = (struct ieee80211_hdr *)frame_data;
+
+		if (ieee80211_is_probe_req(wh->frame_control) &&
+		    is_broadcast_ether_addr(wh->addr1)) {
+			qdf_mem_copy(frame_data + 10, g_inj.mac_addr,
+				     QDF_MAC_ADDR_SIZE);
+		}
+	}
+
+	/* Fill WMI management parameters */
+	mgmt.tx_frame = wmi_buf;
+	mgmt.pdata = frame_data;
+	mgmt.frm_len = skb->len;
+	mgmt.vdev_id = vdev_id;
+	mgmt.tx_type = GENERIC_NODOWLOAD_ACK_COMP_INDEX;
+	mgmt.chanfreq = (uint16_t)chanfreq;
+	mgmt.desc_id = desc_id;
+	mgmt.macaddr = NULL;
+	mgmt.qdf_ctx = qdf_ctx;
+
+	status = wmi_mgmt_unified_cmd_send(wma->wmi_handle, &mgmt);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		/* Submission failed — remove from inflight and free */
+		qdf_spin_lock_bh(&g_inj.state_lock);
+		g_inj.inflight[slot].valid = false;
+		g_inj.inflight[slot].nbuf = NULL;
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		qdf_nbuf_free(wmi_buf);
+		return -EIO;
+	}
+
+	qdf_atomic_inc(&g_inj.inflight_count);
+	return 0;
+}
