+/*
+ * Refresh the cached BSSID of the live STA association.  MUST run in
+ * process context (not atomic): hdd_get_adapter() walks the adapter list
+ * and takes/puts netdev references, which ndo_start_xmit must not do.
+ * Called from the reaper work so the cache tracks roaming, and from
+ * helper create so it is populated before the first injected frame.
+ * A missing association (NULL adapter, or bssid all zero) clears the
+ * cache rather than leaving a stale BSSID behind.
+ */
+static void hdd_mon_inject_refresh_ap_bssid(void)
+{
+	struct hdd_context *hdd_ctx;
+	struct hdd_adapter *sta_adapter;
+	uint8_t bssid[QDF_MAC_ADDR_SIZE];
+	bool valid = false;
+
+	if (!g_inj.lock_inited)
+		return;
+
+	hdd_ctx = cds_get_context(QDF_MODULE_ID_HDD);
+	if (!hdd_ctx) {
+		qdf_spin_lock_bh(&g_inj.lock);
+		g_inj.ap_bssid_valid = false;
+		qdf_mem_zero(g_inj.ap_bssid, QDF_MAC_ADDR_SIZE);
+		qdf_spin_unlock_bh(&g_inj.lock);
+		return;
+	}
+
+	sta_adapter = hdd_get_adapter(hdd_ctx, QDF_STA_MODE);
+	if (sta_adapter && sta_adapter->deflink) {
+		struct hdd_station_ctx *sta_ctx =
+			WLAN_HDD_GET_STATION_CTX_PTR(sta_adapter->deflink);
+
+		if (sta_ctx &&
+		    !is_zero_ether_addr(sta_ctx->conn_info.bssid.bytes)) {
+			qdf_mem_copy(bssid, sta_ctx->conn_info.bssid.bytes,
+				     QDF_MAC_ADDR_SIZE);
+			valid = true;
+		}
+	}
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	if (valid) {
+		if (!g_inj.ap_bssid_valid ||
+		    !ether_addr_equal(g_inj.ap_bssid, bssid))
+			hdd_info("Injection: AP BSSID cache -> %pM", bssid);
+		qdf_mem_copy(g_inj.ap_bssid, bssid, QDF_MAC_ADDR_SIZE);
+		g_inj.ap_bssid_valid = true;
+	} else {
+		g_inj.ap_bssid_valid = false;
+		qdf_mem_zero(g_inj.ap_bssid, QDF_MAC_ADDR_SIZE);
+	}
+	qdf_spin_unlock_bh(&g_inj.lock);
+}
