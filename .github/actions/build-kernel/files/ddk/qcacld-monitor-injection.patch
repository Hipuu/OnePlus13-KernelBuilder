+		    (g_inj.ap_bssid_valid &&
+		     ether_addr_equal(g_inj.ap_bssid, hdr->addr1)) ||
+		    ieee80211_has_tods(hdr->frame_control) ||
+		    ether_addr_equal(hdr->addr1, hdr->addr3)) {
+			/*
+			 * One counter for both cases: on device the only
+			 * thing that matters is that a flood incremented
+			 * it and no PEER_CREATE for addr1 was logged.
+			 */
+			qdf_spin_lock_bh(&g_inj.lock);
+			g_inj.bssid_skipped++;
+			qdf_spin_unlock_bh(&g_inj.lock);
+		} else {
+			hdd_mon_inject_ensure_peer(wmi, vdev_id, hdr->addr1);
+			peer_target = hdr->addr1;
+		}
+	}
+
+	/*
+	 * The original skb is owned by the netdev stack and must not be
+	 * passed to the WMI layer (which may asynchronously free it).
+	 * Allocate a new qdf_nbuf and copy the 802.11 frame data into it.
+	 */
+	nbuf = qdf_nbuf_alloc(NULL, skb->len, 0, 4, false);
+	if (!nbuf) {
+		hdd_err("Injection: nbuf alloc failed (%u bytes), dropping",
+			skb->len);
+		goto drop;
+	}
+	qdf_nbuf_put_tail(nbuf, skb->len);
+	qdf_mem_copy(qdf_nbuf_data(nbuf), skb->data, skb->len);
+
+	/*
+	 * Reserve a tracking slot and take its token BEFORE submit.  The
+	 * token is 0xF000..0xFFFF, far above the stock mgmt_txrx pool
+	 * (ids < MGMT_DESC_POOL_MAX), so it neither collides with a stock
+	 * desc_id nor can a stock completion be mistaken for ours.
+	 * wma_process_mgmt_tx_completion routes it to
+	 * hdd_mon_inject_tx_complete for immediate unmap+free; the reaper
+	 * is only a lost-completion safety net.
+	 */
+	{
+		int token;
+
+		qdf_spin_lock_bh(&g_inj.lock);
+		if (!g_inj.ready) {
+			qdf_spin_unlock_bh(&g_inj.lock);
+			qdf_nbuf_free(nbuf);
+			hdd_err("Injection: helper went down, dropping");
+			goto drop;
+		}
+		/*
+		 * Quarantine full: the reaper is holding mappings it cannot
+		 * prove firmware is done with.  Refuse TX rather than keep
+		 * allocating.  This is the fail-safe end of the bounded
+		 * quarantine -- the alternative (force-freeing to make room)
+		 * is the SMMU fault this design exists to prevent.
+		 */
+		if (g_inj.quarantine_full) {
+			qdf_spin_unlock_bh(&g_inj.lock);
+			qdf_nbuf_free(nbuf);
+			hdd_err_rl("Injection: quarantine full, refusing TX");
+			goto drop;
+		}
+		if (g_inj.inflight >= HDD_MON_INJECT_BACKPRESSURE) {
+			qdf_spin_unlock_bh(&g_inj.lock);
+			qdf_nbuf_free(nbuf);
+			hdd_err("Injection: backpressure at submit, dropping");
+			mod_delayed_work(system_wq, &hdd_mon_inject_reaper_dw, 0);
+			goto drop;
+		}
+		token = hdd_mon_inject_slot_put(nbuf);
+		qdf_spin_unlock_bh(&g_inj.lock);
+
+		if (token < 0) {
+			hdd_err("Injection: no free TX slot, dropping");
+			qdf_nbuf_free(nbuf);
+			mod_delayed_work(system_wq, &hdd_mon_inject_reaper_dw, 0);
+			goto drop;
+		}
+		/*
+		 * mgmt.desc_id is uint16_t (struct wmi_mgmt_params), which is
+		 * exactly the lane our token occupies, so this assignment is
+		 * lossless -- the old 32-bit id with a seq above bit 15 was
+		 * silently truncated here, which is why firmware never saw it.
+		 */
+		mgmt.desc_id = (uint16_t)token;
+	}
+
+	/* Fill WMI management TX parameters */
+	mgmt.tx_frame = nbuf;
+	mgmt.pdata = qdf_nbuf_data(nbuf);
+	mgmt.frm_len = qdf_nbuf_len(nbuf);
+	mgmt.vdev_id = vdev_id;
+	mgmt.chanfreq = chanfreq;
+	mgmt.qdf_ctx = cds_get_context(QDF_MODULE_ID_QDF_DEVICE);
+	/*
+	 * Peer MAC passed to WMI: the station DA for unicast injection, the
+	 * helper self-peer for broadcast/multicast and for addr1==AP-BSSID.
+	 * Snapshot under no lock — hdr bytes are local to this skb copy path.
+	 */
+	mgmt.macaddr = peer_target;
+	mgmt.use_6mbps = 0;
+	mgmt.tx_params_valid = false;
+
+	/*
+	 * Submit directly via wmi_mgmt_unified_cmd_send().  This bypasses
+	 * wlan_mgmt_txrx and the objmgr peer lookup, routing the frame
+	 * straight to the firmware on the helper vdev.
+	 *
+	 * WMI DMA-maps tx_frame internally on LL (caller must NOT pre-map).
+	 * On success, WMI holds the DMA mapping until firmware completion;
+	 * hdd_mon_inject_tx_complete then unmaps + frees the nbuf.
+	 */
+	status = wmi_mgmt_unified_cmd_send(wmi, &mgmt);
+
+	if (QDF_IS_STATUS_SUCCESS(status)) {
+		uint32_t inflight_snap;
+
+		/* netdev stats (hdd_get_stats may hide these in sysfs) */
+		dev->stats.tx_packets++;
+		dev->stats.tx_bytes += skb->len;
+
+		qdf_spin_lock_bh(&g_inj.lock);
+		inflight_snap = g_inj.inflight;
+		qdf_spin_unlock_bh(&g_inj.lock);
+
+		hdd_info("Injection: mgmt frame submitted (vdev %u, %u MHz, %u bytes, desc 0x%x, inflight %u)",
+			 vdev_id, chanfreq, (uint32_t)skb->len, mgmt.desc_id,
+			 inflight_snap);
+		/* Free the original skb — we copied it into nbuf */
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	hdd_err("Injection: wmi_mgmt_unified_cmd_send failed (%d)", status);
+	/* WMI already unmapped on its failure path; drop the slot + free */
+	qdf_spin_lock_bh(&g_inj.lock);
+	hdd_mon_inject_slot_release_locked(mgmt.desc_id, nbuf);
+	qdf_spin_unlock_bh(&g_inj.lock);
+	qdf_nbuf_free(nbuf);
+
+drop:
+	dev->stats.tx_dropped++;
+	qdf_nbuf_free(skb);
+	return NETDEV_TX_OK;
+}
