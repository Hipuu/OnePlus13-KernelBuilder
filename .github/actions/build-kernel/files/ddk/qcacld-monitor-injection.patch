+/*
+ * Firmware mgmt TX on the ghost STA accepts broadcast without a DA peer,
+ * but unicast completions return status=1 unless a WMI peer exists for the
+ * destination. Create peers on demand (best-effort; failures still attempt TX).
+ * Called without g_inj.lock held; takes the lock around the cache only.
+ */
+static void hdd_mon_inject_ensure_peer(struct wmi_unified *wmi, uint8_t vdev_id,
+				       const uint8_t *mac)
+{
+	struct peer_create_params pcreate = {0};
+	QDF_STATUS status;
+	uint8_t i, count;
+	uint8_t slot;
+
+	if (!wmi || !mac)
+		return;
+	if (is_broadcast_ether_addr(mac) || is_multicast_ether_addr(mac) ||
+	    is_zero_ether_addr(mac))
+		return;
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	count = g_inj.peer_count;
+	for (i = 0; i < count && i < HDD_MON_INJECT_PEER_MAX; i++) {
+		if (ether_addr_equal(g_inj.peer_mac[i], mac)) {
+			qdf_spin_unlock_bh(&g_inj.lock);
+			return;
+		}
+	}
+	if (count >= HDD_MON_INJECT_PEER_MAX) {
+		/* Evict oldest (slot 0); FW may retain stale peer — best effort. */
+		slot = 0;
+		qdf_mem_copy(g_inj.peer_mac[0], mac, QDF_MAC_ADDR_SIZE);
+	} else {
+		slot = count;
+		qdf_mem_copy(g_inj.peer_mac[slot], mac, QDF_MAC_ADDR_SIZE);
+		g_inj.peer_count = count + 1;
+	}
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	{
+		uint8_t mac_copy[QDF_MAC_ADDR_SIZE];
+
+		ether_addr_copy(mac_copy, mac);
+		pcreate.vdev_id = vdev_id;
+		pcreate.peer_addr = mac_copy;
+		pcreate.peer_type = WMI_PEER_TYPE_DEFAULT;
+		status = wmi_unified_peer_create_send(wmi, &pcreate);
+	}
+	if (QDF_IS_STATUS_ERROR(status)) {
+		hdd_err("Injection: PEER_CREATE for %pM failed (%d)", mac, status);
+		return;
+	}
+	/* No sleep here: ndo_start_xmit must not block. FW create is async;
+	 * first unicast after peer create may still fail; later frames OK.
+	 */
+	hdd_info("Injection: PEER_CREATE for unicast DA %pM on vdev %u", mac,
+		 vdev_id);
+}
+
+static netdev_tx_t hdd_mon_hard_start_xmit(struct sk_buff *skb,
+					   struct net_device *dev)
+{
+	struct hdd_adapter *adapter = WLAN_HDD_GET_PRIV_PTR(dev);
+	struct hdd_context *hdd_ctx;
+	struct ieee80211_hdr *hdr;
+	QDF_STATUS status;
+	int ctx_ret;
+	struct wmi_mgmt_params mgmt = {0};
+	qdf_nbuf_t nbuf;
+	uint32_t chanfreq;
+	uint8_t vdev_id;
+	uint8_t helper_mac[QDF_MAC_ADDR_SIZE];
+	tp_wma_handle wma;
+	struct wmi_unified *wmi;
+	bool ready;
+
+	if (!adapter) {
+		hdd_err("Injection: NULL adapter, dropping");
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	hdd_ctx = WLAN_HDD_GET_CTX(adapter);
+	ctx_ret = wlan_hdd_validate_context(hdd_ctx);
+	if (ctx_ret) {
+		hdd_err("Injection: HDD context invalid (%d), dropping", ctx_ret);
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	if (skb_linearize(skb)) {
+		hdd_err("Injection: skb_linearize failed, dropping");
+		goto drop;
+	}
+
+	if (hdd_mon_inject_strip_radiotap(skb)) {
+		hdd_err("Injection: malformed radiotap frame, dropping");
+		goto drop;
+	}
+
+	hdr = (struct ieee80211_hdr *)skb->data;
+	if (skb->len < 16) {
+		hdd_err("Injection: frame too short (%u), dropping",
+			(uint32_t)skb->len);
+		goto drop;
+	}
+
+	/*
+	 * Management, data and control frames all ride the ghost-vdev
+	 * WMI path: the firmware validates the frame type internally
+	 * (60 of 67 types inject on peach-v2). Data frames were
+	 * previously dropped by a management-only gate here, which
+	 * blocked WEP replay, reaver/bully EAPOL and mdk4 floods -- the
+	 * non-capture half of wifite.
+	 */
+
+	/*
+	 * Snapshot helper state under the lock.  The WMI handle is NOT
+	 * cached: re-fetch it from WMA on every TX so a firmware SSR
+	 * (which replaces the handle) never makes us send through a
+	 * dead handle.  Also enforce backpressure: if too many nbufs
+	 * are already DMA-mapped and awaiting the reaper, drop rather
+	 * than grow the leak window toward an SMMU/OOM reboot.
+	 */
+	{
+		uint32_t inflight_snap;
+
+		qdf_spin_lock_bh(&g_inj.lock);
+		ready = g_inj.ready;
+		vdev_id = g_inj.vdev_id;
+		chanfreq = g_inj.chanfreq;
+		inflight_snap = g_inj.inflight;
+		qdf_mem_copy(helper_mac, g_inj.helper_mac, QDF_MAC_ADDR_SIZE);
+		qdf_spin_unlock_bh(&g_inj.lock);
+
+		if (!ready) {
+			hdd_err("Injection: helper not ready, dropping");
+			goto drop;
+		}
+
+		if (inflight_snap >= HDD_MON_INJECT_BACKPRESSURE) {
+			hdd_err("Injection: backpressure (inflight %u), dropping",
+				inflight_snap);
+			/* Nudge the reaper to reclaim sooner. */
+			mod_delayed_work(system_wq, &hdd_mon_inject_reaper_dw, 0);
+			goto drop;
+		}
+	}
+
+	wma = cds_get_context(QDF_MODULE_ID_WMA);
+	if (!wma || !wma->wmi_handle) {
+		hdd_err("Injection: WMA/WMI handle unavailable, dropping");
+		goto drop;
+	}
+	wmi = wma->wmi_handle;
+
+	/*
+	 * Address / peer policy for peach mgmt TX on ghost STA:
+	 * - broadcast probe_req: rewrite SA to helper (self-peer) — proven OTA
+	 * - unicast any mgmt: ensure WMI peer for DA; FW status 1 without it
+	 * - deauth/disassoc keep caller SA (AP spoof) — broadcast deauth OTA works
+	 * - mgmt.macaddr: DA for unicast (peer key), helper for broadcast
+	 */
+	if (skb->len >= 24 &&
+	    ieee80211_is_probe_req(hdr->frame_control) &&
+	    is_broadcast_ether_addr(hdr->addr1)) {
+		ether_addr_copy(hdr->addr2, helper_mac);
+	}
+	if (skb->len >= 24 &&
+	    !is_broadcast_ether_addr(hdr->addr1) &&
+	    !is_multicast_ether_addr(hdr->addr1)) {
+		hdd_mon_inject_ensure_peer(wmi, vdev_id, hdr->addr1);
+		/* Also peer the SA when spoofing a third party (e.g. AP BSSID). */
+		if (!ether_addr_equal(hdr->addr2, helper_mac) &&
+		    !is_broadcast_ether_addr(hdr->addr2) &&
+		    !is_zero_ether_addr(hdr->addr2))
+			hdd_mon_inject_ensure_peer(wmi, vdev_id, hdr->addr2);
+	}
+
+	/*
+	 * The original skb is owned by the netdev stack and must not be
+	 * passed to the WMI layer (which may asynchronously free it).
+	 * Allocate a new qdf_nbuf and copy the 802.11 frame data into it.
+	 */
+	nbuf = qdf_nbuf_alloc(NULL, skb->len, 0, 4, false);
+	if (!nbuf) {
+		hdd_err("Injection: nbuf alloc failed (%u bytes), dropping",
+			skb->len);
+		goto drop;
+	}
+	qdf_nbuf_put_tail(nbuf, skb->len);
+	qdf_mem_copy(qdf_nbuf_data(nbuf), skb->data, skb->len);
+
+	/*
+	 * Reserve a tracking slot and assign a unique high-range desc_id
+	 * BEFORE submit. desc_id 0 collides with the stock mgmt_txrx
+	 * pool. Our IDs live at HDD_MON_INJECT_DESC_BASE|slot with a
+	 * seq in the upper 16 bits. wma_process_mgmt_tx_completion
+	 * routes them to hdd_mon_inject_tx_complete for immediate
+	 * unmap+free; the reaper is only a lost-completion safety net.
+	 */
+	{
+		int slot_id;
+
+		qdf_spin_lock_bh(&g_inj.lock);
+		if (!g_inj.ready) {
+			qdf_spin_unlock_bh(&g_inj.lock);
+			qdf_nbuf_free(nbuf);
+			hdd_err("Injection: helper went down, dropping");
+			goto drop;
+		}
+		if (g_inj.inflight >= HDD_MON_INJECT_BACKPRESSURE) {
+			qdf_spin_unlock_bh(&g_inj.lock);
+			qdf_nbuf_free(nbuf);
+			hdd_err("Injection: backpressure at submit, dropping");
+			mod_delayed_work(system_wq, &hdd_mon_inject_reaper_dw, 0);
+			goto drop;
+		}
+		slot_id = hdd_mon_inject_slot_put(nbuf);
+		qdf_spin_unlock_bh(&g_inj.lock);
+
+		if (slot_id < 0) {
+			hdd_err("Injection: no free TX slot, dropping");
+			qdf_nbuf_free(nbuf);
+			mod_delayed_work(system_wq, &hdd_mon_inject_reaper_dw, 0);
+			goto drop;
+		}
+		mgmt.desc_id = (uint32_t)slot_id;
+	}
+
+	/* Fill WMI management TX parameters */
+	mgmt.tx_frame = nbuf;
+	mgmt.pdata = qdf_nbuf_data(nbuf);
+	mgmt.frm_len = qdf_nbuf_len(nbuf);
+	mgmt.vdev_id = vdev_id;
+	mgmt.chanfreq = chanfreq;
+	mgmt.qdf_ctx = cds_get_context(QDF_MODULE_ID_QDF_DEVICE);
+	/*
+	 * Peer MAC passed to WMI: unicast DA after ensure_peer; helper for bcast.
+	 * Snapshot under no lock — hdr bytes are local to this skb copy path.
+	 */
+	if (skb->len >= 24 &&
+	    !is_broadcast_ether_addr(hdr->addr1) &&
+	    !is_multicast_ether_addr(hdr->addr1))
+		mgmt.macaddr = hdr->addr1;
+	else
+		mgmt.macaddr = helper_mac;
+	mgmt.use_6mbps = 0;
+	mgmt.tx_params_valid = false;
+
+	/*
+	 * Submit directly via wmi_mgmt_unified_cmd_send().  This bypasses
+	 * wlan_mgmt_txrx and the objmgr peer lookup, routing the frame
+	 * straight to the firmware on the helper vdev.
+	 *
+	 * WMI DMA-maps tx_frame internally on LL (caller must NOT pre-map).
+	 * On success, WMI holds the DMA mapping until firmware completion;
+	 * hdd_mon_inject_tx_complete then unmaps + frees the nbuf.
+	 */
+	status = wmi_mgmt_unified_cmd_send(wmi, &mgmt);
+
+	if (QDF_IS_STATUS_SUCCESS(status)) {
+		uint32_t inflight_snap;
+
+		/* netdev stats (hdd_get_stats may hide these in sysfs) */
+		dev->stats.tx_packets++;
+		dev->stats.tx_bytes += skb->len;
