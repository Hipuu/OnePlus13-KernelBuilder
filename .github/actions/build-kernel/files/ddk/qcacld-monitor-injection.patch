+static netdev_tx_t hdd_mon_hard_start_xmit(struct sk_buff *skb,
+					   struct net_device *dev)
+{
+	struct hdd_adapter *adapter = WLAN_HDD_GET_PRIV_PTR(dev);
+	struct hdd_context *hdd_ctx;
+	struct ieee80211_hdr *hdr;
+	QDF_STATUS status;
+	int ctx_ret;
+	struct wmi_mgmt_params mgmt = {0};
+	qdf_nbuf_t nbuf;
+	uint32_t chanfreq;
+	uint8_t vdev_id;
+	uint8_t helper_mac[QDF_MAC_ADDR_SIZE];
+	uint8_t *peer_target;
+	tp_wma_handle wma;
+	struct wmi_unified *wmi;
+	bool ready;
+
+	if (!adapter) {
+		hdd_err("Injection: NULL adapter, dropping");
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	hdd_ctx = WLAN_HDD_GET_CTX(adapter);
+	ctx_ret = wlan_hdd_validate_context(hdd_ctx);
+	if (ctx_ret) {
+		hdd_err("Injection: HDD context invalid (%d), dropping", ctx_ret);
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	if (skb_linearize(skb)) {
+		hdd_err("Injection: skb_linearize failed, dropping");
+		goto drop;
+	}
+
+	if (hdd_mon_inject_strip_radiotap(skb)) {
+		hdd_err("Injection: malformed radiotap frame, dropping");
+		goto drop;
+	}
+
+	hdr = (struct ieee80211_hdr *)skb->data;
+	if (skb->len < 16) {
+		hdd_err("Injection: frame too short (%u), dropping",
+			(uint32_t)skb->len);
+		goto drop;
+	}
+
+	/*
+	 * Management, data and control frames all ride the ghost-vdev
+	 * WMI path: the firmware validates the frame type internally
+	 * (60 of 67 types inject on peach-v2). Data frames were
+	 * previously dropped by a management-only gate here, which
+	 * blocked WEP replay, reaver/bully EAPOL and mdk4 floods -- the
+	 * non-capture half of wifite.
+	 */
+
+	/*
+	 * Snapshot helper state under the lock.  The WMI handle is NOT
+	 * cached: re-fetch it from WMA on every TX so a firmware SSR
+	 * (which replaces the handle) never makes us send through a
+	 * dead handle.  Also enforce backpressure: if too many nbufs
+	 * are already DMA-mapped and awaiting the reaper, drop rather
+	 * than grow the leak window toward an SMMU/OOM reboot.
+	 */
+	{
+		uint32_t inflight_snap;
+
+		qdf_spin_lock_bh(&g_inj.lock);
+		ready = g_inj.ready;
+		vdev_id = g_inj.vdev_id;
+		chanfreq = g_inj.chanfreq;
+		inflight_snap = g_inj.inflight;
+		qdf_mem_copy(helper_mac, g_inj.helper_mac, QDF_MAC_ADDR_SIZE);
+		qdf_spin_unlock_bh(&g_inj.lock);
+
+		if (!ready) {
+			hdd_err("Injection: helper not ready, dropping");
+			goto drop;
+		}
+
+		if (inflight_snap >= HDD_MON_INJECT_BACKPRESSURE) {
+			hdd_err("Injection: backpressure (inflight %u), dropping",
+				inflight_snap);
+			/* Nudge the reaper to reclaim sooner. */
+			mod_delayed_work(system_wq, &hdd_mon_inject_reaper_dw, 0);
+			goto drop;
+		}
+	}
+
+	wma = cds_get_context(QDF_MODULE_ID_WMA);
+	if (!wma || !wma->wmi_handle) {
+		hdd_err("Injection: WMA/WMI handle unavailable, dropping");
+		goto drop;
+	}
+	wmi = wma->wmi_handle;
+
+	/*
+	 * Address / peer policy for peach mgmt TX on ghost STA:
+	 * - broadcast probe_req: rewrite SA to helper (self-peer) — proven OTA
+	 * - unicast any mgmt: ensure WMI peer for the DA ONLY; FW status 1
+	 *   without it
+	 * - deauth/disassoc keep caller SA (AP spoof) — broadcast deauth OTA works
+	 * - mgmt.macaddr: DA for unicast (peer key), helper self-peer for
+	 *   broadcast AND for the addr1==BSSID case below
+	 *
+	 * NEVER peer the header SA.  A PEER_CREATE whose MAC is the monitored
+	 * AP's own BSSID puts a second non-self peer on a vdev that is
+	 * VDEV_STARTED but deliberately never VDEV_UP'ed, and peach-v2
+	 * cmnos-asserts on the mgmt-TX completion path ~230-250 ms later:
+	 * firmware hang -> WMI Stop -> SSR -> the next module unload panics
+	 * the kernel (SYSTEM_LAST_KMSG: "last unloaded: qca_cld3_peach_v2").
+	 * Measured on the 7f6886 build, same warm monitor session:
+	 *   unicast DA=victim SA=helper    (DA peer only)  -> TX completes clean
+	 *   unicast DA=victim SA=AP BSSID  (DA + SA peers) -> hang -> SSR
+	 * Broadcast deauth spoofing the AP's SA with zero peers is OTA-verified
+	 * (it kicked the test client off), so the header SA needs no peer to be
+	 * transmitted — the FW mgmt-TX dispatcher keys on mgmt.macaddr, not on
+	 * the frame's SA.  Known trade-off: unicast mgmt that spoofs a
+	 * third-party SA (e.g. EAPOL/auth spoofing) may now complete with FW
+	 * status=1, i.e. it fails to transmit instead of hanging the firmware.
+	 *
+	 * A unicast frame whose addr1 IS the associated AP's BSSID gets no
+	 * peer either, and is keyed to the helper self-peer so it still
+	 * submits.  This is not an edge case: aireplay-ng's directed deauth
+	 * emits exactly this frame (addr1 = AP BSSID, addr2 = victim) as the
+	 * second half of every iteration, so it is what wifite produces
+	 * constantly.  Skipping the peer alone would leave macaddr = the AP
+	 * BSSID with no peer for it — the FW status=1 path.
+	 */
+	if (skb->len >= 24 &&
+	    ieee80211_is_probe_req(hdr->frame_control) &&
+	    is_broadcast_ether_addr(hdr->addr1)) {
+		ether_addr_copy(hdr->addr2, helper_mac);
+	}
+
+	/*
+	 * Pick the peer key for this frame: a station DA needs its own WMI
+	 * peer, everything else (broadcast, multicast, the helper's own
+	 * address, and the AP's BSSID as DA) rides the helper self-peer.
+	 */
+	peer_target = helper_mac;
+	if (skb->len >= 24 &&
+	    !is_broadcast_ether_addr(hdr->addr1) &&
+	    !is_multicast_ether_addr(hdr->addr1)) {
+		/*
+		 * Two MACs must never get a peer here.
+		 *
+		 * 1. The helper's OWN address.  A DA equal to the helper MAC
+		 *    is a frame addressed to this very vdev, so the peer
+		 *    would be a second peer for an address that already has
+		 *    the self-peer, on a vdev that is only STARTED and never
+		 *    UP'ed.  A PEER_CREATE for a MAC that is already a peer
+		 *    on this vdev has hung this firmware once (b3c8fd9's
+		 *    SA-peer hang: peach-v2 cmnos-assert ~256 ms later), and
+		 *    a probe-response flood aimed at the injecting station --
+		 *    ordinary monitor traffic -- emits exactly that frame.
+		 *    Unlike the AP-BSSID case below, this test needs no
+		 *    association: the helper MAC is a constant.
+		 *
+		 * 2. The associated AP's BSSID (aireplay-ng's directed
+		 *    deauth), when a STA association happens to exist.
+		 *    Best-effort by nature: the cache is filled from the
+		 *    STA adapter's conn_info, so it is only valid while a
+		 *    STA session is associated, and on a monitor-only
+		 *    session -- the route that is actually used -- it stays
+		 *    invalid and this test cannot fire.
+		 *
+		 * 3. Any frame that is addressed to the DS, or whose addr1
+		 *    equals its addr3.  Two shapes, one idea: neither can be
+		 *    a station DA, and both are reachable with no association
+		 *    and no cache -- which is what makes them fire on the
+		 *    monitor-only route where test 2 is dead.
+		 *
+		 *    a. addr1 == addr3.  For a management frame with neither
+		 *       ToDS nor FromDS set, addr3 IS the BSSID by definition,
+		 *       so this is a BSSID-as-DA test.  It catches
+		 *       aireplay-ng -0, which emits BOTH directions every
+		 *       iteration: the client->AP direction carries
+		 *       addr1 = addr3 = AP BSSID.
+		 *
+		 *    b. ToDS set.  A ToDS frame is going to the distribution
+		 *       system, so its addr1 is the RA/BSSID by definition --
+		 *       never a station.  This catches aireplay-ng -3 (ARP
+		 *       replay), which injects ToDS=1 with addr1 = BSSID and
+		 *       addr3 = the replayed ARP's DA, so addr1 != addr3 and
+		 *       (a) alone would miss it.  ARP replay is a core wifite
+		 *       attack, so missing it would leave the same hang.
+		 *
+		 *    False-positive risk is bounded.  A station's own MAC is
+		 *    never a BSSID in a frame an attacker sends to it; a ToDS
+		 *    frame's addr1 is a DS address by definition; and a
+		 *    FromDS frame, whose addr1 IS a real station DA, is
+		 *    deliberately not caught -- it still peers.  A 4-address
+		 *    frame (ToDS and FromDS both set) has addr1 = RA and is
+		 *    caught, but it is not a shape a monitor-TX tool
+		 *    produces; and if one ever occurred the cost is a frame
+		 *    that falls back to the self-peer and fails to transmit,
+		 *    not a firmware hang.
+		 *
+		 * All three fall through to the helper self-peer, which
+		 * always exists, so the frame still submits.
+		 *
+		 * Counting the skip here rather than in ensure_peer() is
+		 * deliberate: the peer call is skipped entirely, so this is
+		 * the only place the decision is observable.  A deauth flood
+		 * must produce a non-zero bssid_skipped, and the firmware
+		 * must NOT log a PEER_CREATE for any of these MACs.
+		 */
