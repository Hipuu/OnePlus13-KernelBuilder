+	vdev = hdd_objmgr_get_vdev_by_user(link_info, WLAN_OSIF_ID);
+	if (!vdev)
+		goto drop;
+
+	pdev = wlan_vdev_get_pdev(vdev);
+	if (!pdev) {
+		hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+		goto drop;
+	}
+
+	pdev_id = wlan_objmgr_pdev_get_pdev_id(pdev);
+	peer = wlan_objmgr_get_peer(hdd_ctx->psoc, pdev_id,
+					hdd_mon_inject_peer_addr.bytes,
+					WLAN_OSIF_ID);
+	if (!peer) {
+		hdd_debug_rl("Injection: hidden STA host peer is missing");
+		hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+		goto drop;
+	}
+
+	mgmt_param.tx_frame = skb;
+	mgmt_param.pdata = skb->data;
+	mgmt_param.frm_len = frame_len;
+	mgmt_param.vdev_id = link_info->vdev_id;
+	mgmt_param.chanfreq = READ_ONCE(hdd_mon_inject_chan_freq);
+	mgmt_param.qdf_ctx = wlan_psoc_get_qdf_dev(hdd_ctx->psoc);
+	mgmt_param.macaddr = hdr->addr1;
