+/*
+ * Ghost STA helper for management-frame injection on the monitor vdev.
+ *
+ * peach-v2 firmware crashes (SSR) when WMI_MGMT_TX_SEND targets the
+ * monitor vdev directly.  We work around this by creating a hidden STA
+ * vdev via direct WMI commands, VDEV_START-ing it on the monitor
+ * channel, and creating a self-peer — then submitting management frames
+ * through wmi_mgmt_unified_cmd_send() on that helper vdev.
+ *
+ * This bypasses objmgr/policy-manager entirely (which blocks virtual
+ * interface creation in monitor mode).  The helper vdev ID is not
+ * reserved in the psoc vdev_id_map, so it can collide with a
+ * concurrently-allocated real interface.  This is a known limitation.
+ *
+ * TX lifetime / completion model (host safety):
+ *   - desc_id is assigned from HDD_MON_INJECT_DESC_BASE + slot BEFORE
+ *     WMI submit so firmware completions never hit stock pool id 0.
+ *   - wma_process_mgmt_tx_completion calls hdd_mon_inject_tx_complete()
+ *     before the stock mgmt_txrx pool lookup. Matching high-range
+ *     desc_ids are reclaimed immediately (unmap+free). The reaper is
+ *     only a safety net for lost completions.
+ *   - Backpressure drops new frames when the slot table is near full
+ *     so DMA-mapped buffers cannot grow without bound while Android
+ *     still has the netdev open.
+ *   - ndo_get_stats uses hdd_mon_get_stats so netdev->stats (not DP)
+ *     is what sysfs reports for monitor injection.
+ */
+
+/* Forward declarations — always visible (referenced outside #ifdef). */
+static void hdd_mon_inject_tx_enable_work(struct work_struct *work);
+static void hdd_mon_inject_stop(struct hdd_adapter *adapter);
+static void hdd_mon_inject_slots_flush(void);
+/* Called from wma_process_mgmt_tx_completion (same .ko). */
+bool hdd_mon_inject_tx_complete(uint32_t desc_id, uint32_t status);
+/* Upstream static helper defined later in this file (wlan_hdd_main.c). */
+static int wlan_hdd_delete_mon_link(struct hdd_adapter *adapter,
+				    struct wlan_hdd_link_info *link_info);
+/* Restore entry point, called from hdd_wlan_re_init (wlan_hdd_power.c). */
+void hdd_mon_inject_restore(struct hdd_context *hdd_ctx);
+
+/*
+ * Global injection context.  The spinlock protects ready, chanfreq,
+ * vdev_id, helper_mac, and the TX slot table.  The WMI handle is
+ * re-fetched from WMA on every TX (never cached across SSR).
+ */
+
+#define HDD_MON_INJECT_SLOTS		32
+#define HDD_MON_INJECT_DESC_BASE	0xF000U
+/*
+ * Token layout.  struct wmi_mgmt_params declares desc_id as uint16_t
+ * (wmi_unified_param.h), so bits above 15 are truncated at submit and
+ * NEVER reach firmware; the 16-bit lane is the only thing that comes
+ * back (measured: 235/235 completions echo it verbatim, 0/235 carry
+ * anything else).  The varying part of the id must therefore live in
+ * those 16 bits, or every reuse of a slot looks identical to firmware.
+ *
+ *   bits[4:0]   slot          (32 slots)
+ *   bits[11:5]  generation    (128 values, per-slot, bumped on reuse)
+ *   bits[15:12] 0xF           (HDD_MON_INJECT_DESC_BASE)
+ *
+ * Tokens span the whole 0xF000..0xFFFF range.  Stock mgmt ids are below
+ * MGMT_DESC_POOL_MAX (64), so a token never collides with the stock
+ * pool and a stock completion never looks like ours.
+ *
+ * This is what defeats the ABA hazard: the token changes every time a
+ * slot is reused, so a completion for a previous occupant of that slot
+ * matches nothing (the slot now holds a different token) and frees
+ * nothing.  Two independent arguments bound the residual risk:
+ *
+ *  1. Wrap: a stale completion aliases a live submission only if slot S
+ *     is reused its whole 128-value generation space first.  That is
+ *     128*32 = 4096 submits -- ~525 s at the measured 7.8/s, ~82 s under
+ *     an mdk4-class flood -- against a measured worst-case completion
+ *     latency of 768 ms.
+ *  2. Ordering: per-slot completion order is strictly FIFO (measured
+ *     1496/1496 in submit order).  Completion(g) is therefore processed
+ *     before completion(g+1)..completion(g+128), so those generations
+ *     cannot all have been submitted and freed before completion(g)
+ *     arrives.
+ *
+ * Note that neither argument needs the reaper's age to be a correctness
+ * bound: a completion that arrives after its slot was reclaimed by the
+ * reaper finds a different token (the slot was reused) or an empty slot,
+ * and frees nothing either way.  The reaper holds the mapping instead of
+ * releasing it, so a "late" completion costs nothing.
+ */
+#define HDD_MON_INJECT_TOKEN_MASK	0x0FFFU	/* 12 bits: slot + generation */
+#define HDD_MON_INJECT_GEN_MASK		0x7FU	/* 7 generation bits */
+#define HDD_MON_INJECT_GEN_SHIFT	5
+#define HDD_MON_INJECT_SLOT_MASK	(HDD_MON_INJECT_SLOTS - 1)
+#define HDD_MON_INJECT_REAP_MS		1000	/* nominal reaper period */
+#define HDD_MON_INJECT_REAP_FAST_MS	250	/* under pressure */
+#define HDD_MON_INJECT_AGE_MS		5000	/* lost-completion safety net */
+/*
+ * The reaper is the LOST-COMPLETION path only: with the token match
+ * fixed, a completion reclaims its own buffer, so the reaper fires only
+ * when firmware never reported back.  Its age must exceed the longest
+ * time firmware can still hold a buffer, and it is a single constant --
+ * deliberately NOT shortened under pressure.  Measured submit->
+ * completion max was 768 ms under saturation (inflight up to 30);
+ * 5000 ms keeps ~6.5x margin.  The previous 150 ms was BELOW p99
+ * (180 ms), which is what let the reaper unmap buffers firmware was
+ * still DMA-reading and produced the SMMU/NOC fault.
+ *
+ * The age is a heuristic, not a proof: a host can never distinguish
+ * "completion lost" from "completion very late", so no finite age is
+ * provably safe.  That is why the age is no longer load-bearing for
+ * correctness -- the reaper now moves an aged buffer to the quarantine
+ * instead of unmapping it, so firing too early costs a held mapping,
+ * never a use-after-free.  The age only decides how long a slot stays
+ * unavailable to new submissions.
+ *
+ * Cost of the longer age: a genuinely lost completion keeps its slot
+ * for up to 5 s.  Since the slot IS freed (only the mapping is held),
+ * BACKPRESSURE (30) < SLOTS (32) still governs throughput, so losses do
+ * not wedge injection -- they consume quarantine capacity.  Completions
+ * are FIFO and near-lossless in practice (measured 235/235 delivered),
+ * so this is a liveness backstop, not a hot path.
+ */
+#define HDD_MON_INJECT_PRESSURE		16	/* more frequent reaper checks */
+/*
+ * Drop TX at this inflight.  Must stay BELOW HDD_MON_INJECT_SLOTS or the
+ * "no free TX slot" branch fires first and the cap never engages; 30 of
+ * 32 keeps the self-peer plus a little slack while allowing a much
+ * deeper TX pipeline than the original 24, which throttled deauth floods.
+ */
+#define HDD_MON_INJECT_BACKPRESSURE	30	/* drop TX at this inflight */
+/*
+ * Unicast DA peer cache.  A deauth flood walks the same handful of
+ * station MACs repeatedly; 8 entries thrashed and re-created peers
+ * mid-burst (each PEER_CREATE is a WMI round trip on the never-VDEV_UP
+ * ghost vdev).  16 covers a busy BSS without unbounded firmware peers.
+ */
+#define HDD_MON_INJECT_PEER_MAX		16	/* unicast DA peer cache */
+
+struct hdd_mon_inject_slot {
+	bool in_use;
+	qdf_nbuf_t nbuf;
+	unsigned long submit_jiffies;
+	uint32_t desc_id;
+	/*
+	 * Per-slot generation, bumped every time this slot is handed out.
+	 * It is the varying part of the desc_id, so a completion that
+	 * arrives after the slot was reused carries the OLD token and
+	 * fails the strict compare -- which is what makes that compare
+	 * safe now that the whole id fits in the 16 bits firmware echoes.
+	 */
+	uint32_t gen;
+};
+
+struct hdd_mon_inject_ctx {
+	bool ready;
+	bool lock_inited;
+	bool helper_created;	/* WMI create was attempted/succeeded */
+	uint8_t vdev_id;
+	uint8_t helper_mac[QDF_MAC_ADDR_SIZE];
+	/* Dynamic WMI peers created for unicast DA (FW rejects unicast without peer). */
+	uint8_t peer_mac[HDD_MON_INJECT_PEER_MAX][QDF_MAC_ADDR_SIZE];
+	uint8_t peer_count;
+	/*
+	 * BSSID of the live STA association, cached so the atomic TX path
+	 * never has to walk the adapter list.  Frames whose addr1 is the
+	 * AP's own BSSID must NOT get a WMI peer: PEER_CREATE for the
+	 * monitored AP's MAC on the never-VDEV_UP ghost vdev makes peach-v2
+	 * cmnos-assert ~230-250 ms later (see the addr1 policy comment in
+	 * hdd_mon_hard_start_xmit).  aireplay-ng's directed deauth sends
+	 * exactly such a frame, so this exclusion is what makes wifite's
+	 * deauth attack survivable.  Refreshed from process context (the
+	 * reaper work and helper create); zero when not associated.
+	 */
+	uint8_t ap_bssid[QDF_MAC_ADDR_SIZE];
+	bool ap_bssid_valid;
+	uint32_t chanfreq;
+	qdf_spinlock_t lock;
+	struct hdd_mon_inject_slot slots[HDD_MON_INJECT_SLOTS];
+	/*
+	 * Bounded quarantine for buffers the reaper reclaimed on the AGE_MS
+	 * timeout.  Such a buffer's slot is freed (so the slot becomes
+	 * reusable and injection stays live) but its DMA mapping is LEFT
+	 * LIVE: the reaper cannot distinguish "completion lost" from
+	 * "completion very late", so it must not be the thing that unmaps.
+	 * A completion that arrives after the buffer was quarantined either
+	 * matches nothing (the slot holds a new token) or is a duplicate --
+	 * either way it frees nothing, which is correct, because the buffer
+	 * is no longer owned by any slot.
+	 *
+	 * Capacity equals SLOTS: inflight is capped at BACKPRESSURE (30) <
+	 * SLOTS, so at most SLOTS distinct buffers can ever be outstanding.
+	 * The quarantine is drained only where firmware is provably done
+	 * with it -- vdev teardown, or a path where firmware is unreachable
+	 * (see hdd_mon_inject_slots_flush).  It is a bounded leak by
+	 * construction, never an unbounded one.
+	 */
+	qdf_nbuf_t quarantine[HDD_MON_INJECT_SLOTS];
+	uint32_t quarantine_count;
+	/*
+	 * Set when the quarantine is full, i.e. more completions were lost
+	 * than the quarantine can hold.  Fails safe: TX is refused (the
+	 * buffer stays tracked in its slot, still in_use) rather than
+	 * force-freeing a mapping firmware may still read.  A session that
+	 * reports this is losing completions and needs the age raised.
+	 */
+	bool quarantine_full;
+	uint32_t next_slot;
+	uint32_t inflight;
+	struct net_device *mon_dev;
+	uint64_t tx_ok;
+	uint64_t tx_fail;
+	uint64_t tx_complete;
+	/*
+	 * Frames that skipped PEER_CREATE because their addr1 is a BSSID
+	 * rather than a station (see the addr1 policy comment in
+	 * hdd_mon_hard_start_xmit for the three tests).  Exposed in the
+	 * teardown log so an on-device run can prove the deauth exclusion
+	 * is actually engaging -- a flood tool always produces some --
+	 * without a debugger.  A deauth or ARP-replay run that reports
+	 * bssid_skipped=0 did NOT exercise the exclusion.
+	 */
+	uint64_t bssid_skipped;
+	/*
+	 * Reclaim-path accounting.  A run can only be diagnosed from its
+	 * counters if it is visible WHICH path freed each buffer, so these
+	 * are the load-bearing diagnostic for the token fix:
+	 *
+	 *   tx_complete  completions that matched their slot's token and
+	 *                freed it -- the healthy path, and the one that was
+	 *                dead code (0/235) before the token moved into the
+	 *                low 16 bits.
+	 *   tx_stale     completions that arrived for a token the slot no
+	 *                longer held (a reused slot's previous occupant, or
+	 *                a duplicate).  Expected and benign: frees nothing.
+	 *   reaped       buffers whose completion firmware never delivered,
+	 *                moved to the quarantine by the AGE_MS timeout.  This
+	 *                restores slot liveness only; it does NOT unmap, so it
+	 *                is no longer an SMMU trigger.  Must stay near zero in
+	 *                a healthy run.  It was previously only hdd_debug, so
+	 *                a crashed run could not prove whether it fired.
+	 *   quarantined  buffers whose slot was reclaimed on timeout and whose
+	 *                DMA mapping is therefore still live.  They are unmapped
+	 *                only where firmware is provably done with them (vdev
+	 *                teardown), never on a timer.  A non-zero value that
+	 *                never drains means completions are being lost.
+	 *
+	 * Healthy session: tx_complete >> 0, reaped ~= 0, quarantined ~= 0.
+	 * Before the fix the reverse held (tx_complete 0, everything reaped),
+	 * which is exactly what the 987.9s SMMU fault looked like.
+	 */
+	uint64_t tx_stale;
+	uint64_t reaped;
+	uint64_t flushed;
+	uint64_t quarantined;
+};
+
+static struct hdd_mon_inject_ctx g_inj;
+
+/* Reaper: periodically unmap + free nbufs stock completion cannot reclaim. */
+static void hdd_mon_inject_reaper(struct work_struct *work);
+/*
+ * Defined with the other injection helpers further down, but called from
+ * the reaper and helper-create above it, so it needs a forward
+ * declaration here (an implicit declaration is an error under -Werror).
+ */
+static void hdd_mon_inject_refresh_ap_bssid(void);
+static DECLARE_DELAYED_WORK(hdd_mon_inject_reaper_dw, hdd_mon_inject_reaper);
+
+/* Always declare: referenced from stop/open paths and injection functions. */
+static DECLARE_DELAYED_WORK(hdd_mon_inject_tx_enable_dw,
+			    hdd_mon_inject_tx_enable_work);
+static struct hdd_adapter *hdd_mon_inject_tx_enable_adapter;
+
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+
+#define HDD_MON_MIN_80211_LEN 24
+
+struct hdd_mon_radiotap_hdr {
+	uint8_t it_version;
+	uint8_t it_pad;
+	uint16_t it_len;
+	uint32_t it_present;
+} __packed;
+
+static int hdd_mon_inject_strip_radiotap(struct sk_buff *skb)
+{
+	struct hdd_mon_radiotap_hdr *rthdr;
+	uint16_t rtap_len;
+
+	if (skb->len < sizeof(*rthdr))
+		return -EINVAL;
+
+	rthdr = (struct hdd_mon_radiotap_hdr *)skb->data;
+	if (rthdr->it_version != 0)
+		return -EINVAL;
+
+	rtap_len = le16_to_cpu(rthdr->it_len);
+	if (rtap_len < sizeof(*rthdr) || rtap_len > skb->len ||
+	    skb->len - rtap_len < HDD_MON_MIN_80211_LEN)
+		return -EINVAL;
+
+	skb_pull(skb, rtap_len);
+	return 0;
+}
+
+/*
+ * Unmap + free an injection nbuf.  WMI mapped it on submit (LL path, see
+ * qdf_nbuf_map_single in send_mgmt_cmd_tlv) and, on the send-failure path,
+ * unmaps it itself before returning E_FAILURE -- so this runs only for a
+ * buffer WMI accepted, whose mapping WMI holds until completion.
+ * Stock mgmt_txrx completion cannot reclaim our nbufs: we bypass its
+ * descriptor pool and use high-range desc_ids.  peach-v2 DOES emit TX
+ * completion events for the ghost STA helper, and wma_process_mgmt_tx_
+ * completion routes ours to hdd_mon_inject_tx_complete, which calls this
+ * on a strict token match.  When a completion never arrives, the buffer
+ * is moved to the bounded quarantine by the reaper -- deliberately NOT
+ * unmapped there -- and this runs only when firmware is provably done
+ * with it: the teardown flush, which drains the quarantine alongside the
+ * slot table after the ghost vdev is deleted.
+ */
+static void hdd_mon_inject_unmap_free(qdf_nbuf_t nbuf)
+{
+	void *qdf_ctx;
+
+	if (!nbuf)
+		return;
+
+	qdf_ctx = cds_get_context(QDF_MODULE_ID_QDF_DEVICE);
+	if (qdf_ctx)
+		qdf_nbuf_unmap_single(qdf_ctx, nbuf, QDF_DMA_TO_DEVICE);
+	qdf_nbuf_free(nbuf);
+}
+
+/*
+ * Build a desc_id wholly inside the 16-bit lane firmware echoes.
+ *   bits[4:0]  slot
+ *   bits[11:5] generation (per-slot, bumped on every reuse)
+ *   bits[15:12] HDD_MON_INJECT_DESC_BASE (0xF)
+ * The generation is what makes a token unique: when a slot is freed and
+ * handed out again its token changes, so a late completion for the
+ * previous occupant matches nothing and frees nothing.  Keeping the
+ * whole id in 16 bits is what lets the strict compare in
+ * hdd_mon_inject_tx_complete actually succeed -- the old layout put the
+ * generation at bits[30:16], which struct wmi_mgmt_params (uint16_t
+ * desc_id) truncated away at submit, making that compare unsatisfiable.
+ */
+static uint32_t hdd_mon_inject_make_desc_id(uint32_t idx, uint32_t gen)
+{
+	return HDD_MON_INJECT_DESC_BASE |
+	       ((gen & HDD_MON_INJECT_GEN_MASK) << HDD_MON_INJECT_GEN_SHIFT) |
+	       (idx & HDD_MON_INJECT_SLOT_MASK);
+}
+
+static bool hdd_mon_inject_desc_is_ours(uint32_t desc_id)
+{
+	uint32_t low = desc_id & 0xFFFFU;
+
+	/*
+	 * Firmware echoes only the low 16 bits of the WMI desc_id, and our
+	 * tokens live entirely there, so test that lane.  A token is
+	 * DESC_BASE (0xF) in the top nibble plus a 12-bit slot/generation
+	 * value, i.e. 0xF000..0xFFFF; stock mgmt ids are below
+	 * MGMT_DESC_POOL_MAX (64) and can never land in that range.
+	 */
+	return (low & ~HDD_MON_INJECT_TOKEN_MASK) == HDD_MON_INJECT_DESC_BASE;
+}
+
+/* Slot index from a full or low16-only desc_id. */
+static uint32_t hdd_mon_inject_desc_slot(uint32_t desc_id)
+{
+	return (desc_id & 0xFFFFU) & HDD_MON_INJECT_SLOT_MASK;
+}
+
+/* Stash nbuf in the next free slot.  Caller holds g_inj.lock.
+ * Returns desc_id (> 0) or -1 if the table is full.
+ */
+static int hdd_mon_inject_slot_put(qdf_nbuf_t nbuf)
+{
+	uint32_t i, idx;
+	uint32_t desc_id;
+
+	for (i = 0; i < HDD_MON_INJECT_SLOTS; i++) {
+		idx = (g_inj.next_slot + i) % HDD_MON_INJECT_SLOTS;
+		if (!g_inj.slots[idx].in_use) {
+			/*
+			 * Bump this slot's generation so the new token
+			 * cannot equal the one just retired here.
+			 */
+			g_inj.slots[idx].gen++;
+			desc_id = hdd_mon_inject_make_desc_id(
+					idx, g_inj.slots[idx].gen);
+			g_inj.slots[idx].in_use = true;
+			g_inj.slots[idx].nbuf = nbuf;
+			g_inj.slots[idx].submit_jiffies = jiffies;
+			g_inj.slots[idx].desc_id = desc_id;
+			g_inj.next_slot = (idx + 1) % HDD_MON_INJECT_SLOTS;
+			g_inj.inflight++;
+			return (int)desc_id;
+		}
+	}
+	return -1;
+}
+
+/* Drop a specific slot after a failed WMI submit.  Caller may hold lock. */
+static void hdd_mon_inject_slot_release_locked(uint32_t desc_id,
+					       qdf_nbuf_t nbuf)
+{
+	uint32_t idx;
+
+	if (!hdd_mon_inject_desc_is_ours(desc_id))
+		return;
+
+	idx = hdd_mon_inject_desc_slot(desc_id);
+	if (idx >= HDD_MON_INJECT_SLOTS)
+		return;
+
+	/*
+	 * Match by slot + nbuf.  Do NOT require full 32-bit desc equality:
+	 * firmware completions often return only the low 16 bits.
+	 */
+	if (g_inj.slots[idx].in_use &&
+	    g_inj.slots[idx].nbuf == nbuf) {
+		g_inj.slots[idx].in_use = false;
+		g_inj.slots[idx].nbuf = NULL;
+		g_inj.slots[idx].desc_id = 0;
+		if (g_inj.inflight)
+			g_inj.inflight--;
+	}
+}
+
+/*
+ * Move an aged nbuf into the quarantine instead of unmapping it.  Caller
+ * holds g_inj.lock.
+ *
+ * The reaper reclaimed this buffer's SLOT (so injection stays live) but
+ * firmware never reported the completion, so we cannot prove it is done
+ * with the DMA mapping.  Restoring slot liveness is safe and necessary;
+ * unmapping here is what produced the SMMU/NOC fault.  Hold the mapping
+ * until a point that CAN prove it (vdev teardown), and count it.
+ *
+ * Returns false if the quarantine is full.  On overflow the caller must
+ * NOT free the buffer: the slot keeps it (still in_use) and TX is
+ * refused, so the failure mode is a stalled injection session with a
+ * loud log, never a use-after-free.
+ */
+static bool hdd_mon_inject_quarantine_put(qdf_nbuf_t nbuf)
+{
+	if (g_inj.quarantine_count >= HDD_MON_INJECT_SLOTS) {
+		g_inj.quarantine_full = true;
+		return false;
+	}
+	g_inj.quarantine[g_inj.quarantine_count++] = nbuf;
+	return true;
+}
+
+/* Flush every in-flight slot (teardown / stop / SSR path). */
+static void hdd_mon_inject_slots_flush(void)
+{
+	uint32_t i;
+	qdf_nbuf_t nbufs[HDD_MON_INJECT_SLOTS * 2];
+	uint32_t count = 0;
+
+	if (!g_inj.lock_inited)
+		return;
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	for (i = 0; i < HDD_MON_INJECT_SLOTS; i++) {
+		if (g_inj.slots[i].in_use) {
+			nbufs[count++] = g_inj.slots[i].nbuf;
+			g_inj.slots[i].in_use = false;
+			g_inj.slots[i].nbuf = NULL;
+			g_inj.slots[i].desc_id = 0;
+		}
+	}
+	g_inj.inflight = 0;
+	/*
+	 * Drain the quarantine too.  This function is called ONLY where
+	 * firmware is provably done with our buffers: after the ghost vdev
+	 * is stopped and deleted, or when firmware is unreachable entirely.
+	 * That is exactly the proof the reaper lacked, so this is the point
+	 * where a quarantined mapping may finally be unmapped.
+	 */
+	for (i = 0; i < g_inj.quarantine_count; i++)
+		nbufs[count++] = g_inj.quarantine[i];
+	g_inj.quarantine_count = 0;
+	g_inj.quarantine_full = false;
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	for (i = 0; i < count; i++)
+		hdd_mon_inject_unmap_free(nbufs[i]);
+
+	g_inj.flushed += count;
+	if (count)
+		hdd_info("Injection: flushed %u in-flight nbuf(s)", count);
+}
+
+/**
+ * hdd_mon_inject_tx_complete() - WMA completion reclaim for inject desc_ids
+ * @desc_id: WMI mgmt desc_id from firmware completion
+ * @status:  firmware TX status (0 = success)
+ *
+ * Return: true if consumed (injection path), false for stock pool path.
+ */
+bool hdd_mon_inject_tx_complete(uint32_t desc_id, uint32_t status)
+{
+	qdf_nbuf_t nbuf = NULL;
+	struct net_device *dev = NULL;
+	uint32_t inflight_snap = 0;
+	uint64_t ok_snap, fail_snap;
+	uint32_t idx;
+	uint32_t stored_desc = 0;
+	bool freed = false;
+
+	if (!g_inj.lock_inited)
+		return false;
+	if (!hdd_mon_inject_desc_is_ours(desc_id))
+		return false;
+
+	idx = hdd_mon_inject_desc_slot(desc_id);
+	if (idx >= HDD_MON_INJECT_SLOTS)
+		return true;
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	/*
+	 * Compare in the 16-bit lane, not the full 32-bit word.  The token
+	 * lives entirely in the low 16 bits and firmware echoes exactly the
+	 * 16 bits it was sent (struct wmi_mgmt_params.desc_id is uint16_t, so
+	 * the host widens it with zero high bits).  Masking both sides makes
+	 * the match independent of whatever the completion event carries
+	 * above bit 15 -- which is the safe direction: a spurious high bit
+	 * would otherwise make the compare unsatisfiable, silently returning
+	 * this code to the reaper-only regime that caused the SMMU fault.
+	 *
+	 * The match is also what makes this safe.  Because every reuse of a
+	 * slot bumps that slot's generation, a completion that arrives after
+	 * the slot was reused carries the previous occupant's token and
+	 * compares unequal: we free NOTHING.  Without the generation (i.e.
+	 * with a bare slot index, as the old low16-only fallback did) that
+	 * stale completion would free the NEW submission's nbuf while
+	 * firmware is still DMA-reading it -- the UAF the old strict-compare
+	 * comment was reaching for.  The difference is that the old compare
+	 * could never be true at all, so no completion was ever consumed and
+	 * the reaper became the only reclaim path.
+	 *
+	 * A slot that is not in_use, or whose stored token differs, is a
+	 * stale or duplicate completion: drop it, free nothing, and leave
+	 * inflight alone.
+	 */
+	stored_desc = g_inj.slots[idx].desc_id;
+	if (g_inj.slots[idx].in_use &&
+	    stored_desc == (desc_id & 0xFFFFU)) {
+		nbuf = g_inj.slots[idx].nbuf;
+		g_inj.slots[idx].in_use = false;
+		g_inj.slots[idx].nbuf = NULL;
+		g_inj.slots[idx].desc_id = 0;
+		if (g_inj.inflight)
+			g_inj.inflight--;
+		freed = true;
+	} else {
+		g_inj.tx_stale++;
+	}
+	dev = g_inj.mon_dev;
+	if (freed) {
+		g_inj.tx_complete++;
+		if (status)
+			g_inj.tx_fail++;
+		else
+			g_inj.tx_ok++;
+	}
+	inflight_snap = g_inj.inflight;
+	ok_snap = g_inj.tx_ok;
+	fail_snap = g_inj.tx_fail;
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	if (nbuf)
+		hdd_mon_inject_unmap_free(nbuf);
+
+	if (dev && status && freed)
+		dev->stats.tx_errors++;
+
+	if (freed)
+		hdd_info("Injection: TX complete desc 0x%x (slot %u stored 0x%x) status %u inflight %u (ok=%llu fail=%llu)",
+			 desc_id, idx, stored_desc, status, inflight_snap,
+			 (unsigned long long)ok_snap,
+			 (unsigned long long)fail_snap);
+	else
+		/*
+		 * A stale or duplicate completion is now an expected, benign
+		 * event (the slot was reused, so the token no longer matches),
+		 * not an error: the completion path is working as intended and
+		 * the frame it referred to was already reclaimed.  Keep it at
+		 * debug level so a healthy run does not look like a failure --
+		 * at err level this line was the "mismatch" that made a
+		 * working completion path look broken.
+		 */
+		hdd_debug("Injection: stale TX complete desc 0x%x slot %u (stored 0x%x)",
+			  desc_id, idx, stored_desc);
+	return true;
+}
+
+/*
+ * Reaper work: free nbufs older than the age threshold.  This is the
+ * LOST-COMPLETION path only -- the healthy path is
+ * hdd_mon_inject_tx_complete, which reclaims on the firmware event.
+ */
+static void hdd_mon_inject_reaper(struct work_struct *work)
+{
+	uint32_t i;
+	uint32_t count = 0;
+	uint32_t inflight_snap;
+	uint32_t quarantine_snap;
+	bool overflow = false;
+	bool ready_snap;
+	unsigned long age;
+	unsigned int reap_ms;
+
+	if (!g_inj.lock_inited)
+		return;
+
+	/*
+	 * Reaper runs in a workqueue, i.e. process context, so it is the
+	 * one periodic hook that may safely walk the adapter list.  Keep
+	 * the AP-BSSID cache fresh here: roaming between the helper create
+	 * and the attack would otherwise leave the exclusion stale and let
+	 * the new BSSID through to PEER_CREATE.
+	 */
+	hdd_mon_inject_refresh_ap_bssid();
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	inflight_snap = g_inj.inflight;
+	ready_snap = g_inj.ready;
+	/*
+	 * One age, load-independent.  Pressure must never SHORTEN this
+	 * window: a deep pipeline is exactly the case where completions
+	 * are slowest, so shrinking the age under pressure would reclaim
+	 * buffers firmware is most likely still holding.  Pressure only
+	 * makes the reaper CHECK more often (see the reschedule below);
+	 * it never lowers the bar for reclaiming.
+	 */
+	age = msecs_to_jiffies(HDD_MON_INJECT_AGE_MS);
+
+	for (i = 0; i < HDD_MON_INJECT_SLOTS; i++) {
+		if (!g_inj.slots[i].in_use ||
+		    !time_after(jiffies,
+				g_inj.slots[i].submit_jiffies + age))
+			continue;
+
+		/*
+		 * Quarantine the buffer, do NOT unmap it.  Firmware may still
+		 * be DMA-reading it: an age threshold can only bound how long a
+		 * completion is LIKELY to take, never prove one will not still
+		 * arrive.  Move the mapping somewhere it is held, not released.
+		 *
+		 * A slot with no buffer has nothing to hold; release it and
+		 * move on (defensive: in_use implies nbuf, but a NULL here
+		 * must not consume a quarantine entry).
+		 */
+		if (!g_inj.slots[i].nbuf) {
+			g_inj.slots[i].in_use = false;
+			g_inj.slots[i].desc_id = 0;
+			if (g_inj.inflight)
+				g_inj.inflight--;
+			continue;
+		}
+
+		if (!hdd_mon_inject_quarantine_put(g_inj.slots[i].nbuf)) {
+			/*
+			 * Quarantine full.  Leave this slot exactly as it is
+			 * (in_use, buffer attached) so the buffer stays tracked
+			 * and is never freed underneath firmware.  TX is refused
+			 * from here on; the session stalls loudly rather than
+			 * corrupting memory.
+			 */
+			overflow = true;
+			continue;
+		}
+
+		g_inj.slots[i].in_use = false;
+		g_inj.slots[i].nbuf = NULL;
+		g_inj.slots[i].desc_id = 0;
+		if (g_inj.inflight)
+			g_inj.inflight--;
+		count++;
+	}
+	g_inj.reaped += count;
+	g_inj.quarantined += count;
+	if (overflow)
+		g_inj.quarantine_full = true;
+	inflight_snap = g_inj.inflight;
+	quarantine_snap = g_inj.quarantine_count;
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	if (count)
+		/*
+		 * hdd_info, not hdd_debug: this is the lost-completion path,
+		 * and a healthy run must show reaped ~= 0.  It no longer
+		 * unmaps anything -- the buffers are held in the quarantine
+		 * until teardown -- so a climb here means completions are
+		 * being lost (raise the age), NOT that memory is being
+		 * corrupted.  Leaving it at debug made the previous crash
+		 * unprovable from the log.
+		 */
+		hdd_info("Injection: reaped %u nbuf(s) into quarantine (%u held), inflight now %u",
+			 count, quarantine_snap, inflight_snap);
+
+	if (overflow)
+		/*
+		 * Loud and ratelimited: every reaper pass while full would
+		 * otherwise flood the log, and the condition is persistent
+		 * (TX stays refused until teardown drains the quarantine).
+		 */
+		hdd_err_rl("Injection: quarantine full (%u held), refusing TX - completions are being lost",
+			   quarantine_snap);
+
+	/* Reschedule while helper is ready; go faster under pressure. */
+	if (ready_snap) {
+		if (inflight_snap >= HDD_MON_INJECT_PRESSURE)
+			reap_ms = HDD_MON_INJECT_REAP_FAST_MS;
+		else
+			reap_ms = HDD_MON_INJECT_REAP_MS;
+		schedule_delayed_work(&hdd_mon_inject_reaper_dw,
+				      msecs_to_jiffies(reap_ms));
+	}
+}
+
+/*
+ * Create the ghost STA helper vdev.  Called after the monitor adapter
+ * is started (in __hdd_mon_open).  Must NOT run in atomic context.
+ */
+static QDF_STATUS hdd_mon_inject_helper_create(struct hdd_adapter *adapter,
+					       uint32_t chanfreq)
+{
+	tp_wma_handle wma;
+	struct wmi_unified *wmi;
+	struct vdev_create_params vcreate = {0};
+	struct vdev_start_params vstart = {0};
+	struct peer_create_params pcreate = {0};
+	QDF_STATUS status;
+	int i;
+	uint8_t vdev_id = WLAN_INVALID_VDEV_ID;
+
+	wma = cds_get_context(QDF_MODULE_ID_WMA);
+	if (!wma || !wma->wmi_handle) {
+		hdd_err("Injection: WMA/WMI handle unavailable");
+		return QDF_STATUS_E_FAILURE;
+	}
+	wmi = wma->wmi_handle;
+
+	/*
+	 * Scan WMA interfaces for a free slot.  Skip slots occupied by
+	 * real STA vdevs to avoid conflicts with active connections.
+	 */
+	for (i = 0; i < wma->max_bssid; i++) {
+		if (wma->interfaces[i].vdev == NULL &&
+		    wma->interfaces[i].type != WMI_VDEV_TYPE_STA) {
+			vdev_id = i;
+			break;
+		}
+	}
+	if (vdev_id == WLAN_INVALID_VDEV_ID) {
+		hdd_err("Injection: no free WMA slot for helper vdev");
+		return QDF_STATUS_E_FAILURE;
+	}
+
+	/* Derive helper MAC: locally-administered bit + increment last byte */
+	qdf_mem_copy(g_inj.helper_mac, adapter->deflink->link_addr.bytes,
+		     QDF_MAC_ADDR_SIZE);
+	g_inj.helper_mac[0] |= 0x02;
+	g_inj.helper_mac[QDF_MAC_ADDR_SIZE - 1]++;
+
+	g_inj.vdev_id = vdev_id;
+	g_inj.chanfreq = chanfreq;
+
+	/* WMI_VDEV_CREATE_CMDID: type=STA, subtype=0 */
+	vcreate.vdev_id = vdev_id;
+	vcreate.type = WMI_VDEV_TYPE_STA;
+	vcreate.subtype = 0;
+	vcreate.nss_2g = 1;
+	vcreate.nss_5g = 1;
+	vcreate.pdev_id = WMI_PDEV_ID_1ST;
+
+	status = wmi_unified_vdev_create_send(wmi, g_inj.helper_mac, &vcreate);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		hdd_err("Injection: VDEV_CREATE failed (%d)", status);
+		return status;
+	}
+	hdd_info("Injection: VDEV_CREATE sent (vdev %u)", vdev_id);
+	qdf_spin_lock_bh(&g_inj.lock);
+	g_inj.helper_created = true;
+	g_inj.vdev_id = vdev_id;
+	qdf_spin_unlock_bh(&g_inj.lock);
+	msleep(150);
+
+	/* WMI_VDEV_START_CMDID: monitor channel, 20 MHz */
+	vstart.vdev_id = vdev_id;
+	vstart.channel.mhz = chanfreq;
+	vstart.channel.cfreq1 = chanfreq;
+	/* Bandwidth is encoded in phy_mode, no separate ch_width field. */
+	vstart.channel.phy_mode = WLAN_PHYMODE_11G;
+	vstart.beacon_interval = 0;
+	vstart.dtim_period = 0;
+	vstart.preferred_rx_streams = 1;
+	vstart.preferred_tx_streams = 1;
+
+	status = wmi_unified_vdev_start_send(wmi, &vstart);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		hdd_err("Injection: VDEV_START failed (%d)", status);
+		/* Attempt to unwind: delete the vdev we just created */
+		wmi_unified_vdev_delete_send(wmi, vdev_id);
+		return status;
+	}
+	hdd_info("Injection: VDEV_START sent (vdev %u, %u MHz)", vdev_id, chanfreq);
+	msleep(150);
+
+	/* WMI_PEER_CREATE_CMDID: self-peer with helper MAC */
+	pcreate.vdev_id = vdev_id;
+	pcreate.peer_addr = g_inj.helper_mac;
+	pcreate.peer_type = WMI_PEER_TYPE_DEFAULT;
+
+	status = wmi_unified_peer_create_send(wmi, &pcreate);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		hdd_err("Injection: PEER_CREATE failed (%d)", status);
+		/* Unwind: stop and delete the vdev */
+		{
+			struct vdev_stop_params vstop = {0};
+			vstop.vdev_id = vdev_id;
+			wmi_unified_vdev_stop_send(wmi, &vstop);
+		}
+		msleep(100);
+		wmi_unified_vdev_delete_send(wmi, vdev_id);
+		return status;
+	}
+	hdd_info("Injection: PEER_CREATE sent (vdev %u)", vdev_id);
+	msleep(100);
+
+	/*
+	 * Skip VDEV_UP.  For STA vdevs, firmware's wlan_vdev_up asserts
+	 * unless a BSS peer (the AP) exists — we only have a self-peer.
+	 * The mgmt TX handler only needs the vdev in STARTED state with
+	 * a valid peer at vdev+0xc.  This matches the Loukious reference.
+	 */
+
+	/* Mark helper as ready for TX and start the reaper */
+	qdf_spin_lock_bh(&g_inj.lock);
+	g_inj.helper_created = true;
+	g_inj.ready = true;
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	/*
+	 * Populate the AP-BSSID exclusion now, in this process context,
+	 * so the very first injected frame is already protected instead of
+	 * waiting up to one reaper period (1 s) for the cache to fill.
+	 */
+	hdd_mon_inject_refresh_ap_bssid();
+
+	schedule_delayed_work(&hdd_mon_inject_reaper_dw,
+			      msecs_to_jiffies(HDD_MON_INJECT_REAP_MS));
+
+	hdd_info("Injection: ghost STA helper ready (vdev %u, mac %pM, %u MHz)",
+		 vdev_id, g_inj.helper_mac, chanfreq);
+	return QDF_STATUS_SUCCESS;
+}
+
+/*
+ * Tear down the ghost STA helper.  Must NOT run in atomic context.
+ * Order matters for host safety:
+ *   1. mark !ready so xmit drops immediately (no new buffer can enter a slot)
+ *   2. cancel reaper (no concurrent unmap)
+ *   3. PEER_DELETE / VDEV_STOP / VDEV_DELETE, so firmware is provably done
+ *      with every buffer we submitted on this vdev
+ *   4. flush all still-outstanding slots AND drain the quarantine -- only
+ *      now is it safe to unmap
+ * Flushing before step 3 is what let a buffer be unmapped while firmware was
+ * still DMA-reading it on a STARTED vdev (the SMMU/NOC fault class).  The
+ * quarantine exists because the reaper cannot know when firmware is done;
+ * this teardown is the one place that can prove it, so this is where those
+ * held mappings are released.
+ * Leaving the ghost STA alive after Android turns Wi-Fi off is a
+ * leading suspect for the 10-20 min late reboot; always tear it down
+ * from hdd_stop / hdd_mon_inject_stop.
+ */
+static void hdd_mon_inject_helper_teardown(void)
+{
+	tp_wma_handle wma;
+	struct wmi_unified *wmi;
+	QDF_STATUS status;
+	uint8_t vdev_id;
+	uint8_t helper_mac[QDF_MAC_ADDR_SIZE];
+	bool helper_created = false;
+
+	if (g_inj.lock_inited) {
+		qdf_spin_lock_bh(&g_inj.lock);
+		helper_created = g_inj.helper_created;
+		g_inj.ready = false;
+		g_inj.helper_created = false;
+		vdev_id = g_inj.vdev_id;
+		qdf_mem_copy(helper_mac, g_inj.helper_mac, QDF_MAC_ADDR_SIZE);
+		qdf_spin_unlock_bh(&g_inj.lock);
+	} else {
+		helper_created = g_inj.helper_created;
+		g_inj.ready = false;
+		g_inj.helper_created = false;
+		vdev_id = g_inj.vdev_id;
+		qdf_mem_copy(helper_mac, g_inj.helper_mac, QDF_MAC_ADDR_SIZE);
+	}
+
+	/*
+	 * Stop the reaper before anything else so it cannot unmap
+	 * concurrently with the teardown below.
+	 */
+	cancel_delayed_work_sync(&hdd_mon_inject_reaper_dw);
+
+	/*
+	 * TX is already blocked (g_inj.ready = false above), so no new
+	 * buffer can enter a slot.  The outstanding ones are unmapped only
+	 * AFTER the ghost vdev is stopped and deleted, further down: while
+	 * the vdev is still STARTED in firmware, a buffer we unmap here
+	 * could still be one firmware is DMA-reading, which is the same
+	 * SMMU fault class the reaper-age fix addresses.  Firmware is the
+	 * only thing that can prove it is done with a buffer, so we let
+	 * the vdev teardown be that proof and flush afterwards.
+	 */
+	if (!helper_created) {
+		/* No ghost vdev was ever created, so no buffer of ours can
+		 * still be held by firmware: flush now. */
+		hdd_mon_inject_slots_flush();
+		return;
+	}
+
+	wma = cds_get_context(QDF_MODULE_ID_WMA);
+	if (!wma || !wma->wmi_handle) {
+		/*
+		 * No WMI handle: the ghost vdev may survive in firmware. A
+		 * later PMO suspend walking it asserts peach-v2 firmware
+		 * (cmnos_assert -> MHI ramdump -> teardown panic). Log loudly
+		 * so the loader's post-switch health check can advise reboot.
+		 */
+		hdd_err("Injection: teardown skipped, WMI unavailable - ghost vdev may leak into firmware; reboot recommended");
+		if (g_inj.lock_inited) {
+			qdf_spin_lock_bh(&g_inj.lock);
+			g_inj.vdev_id = WLAN_INVALID_VDEV_ID;
+			qdf_mem_zero(g_inj.helper_mac, QDF_MAC_ADDR_SIZE);
+			qdf_spin_unlock_bh(&g_inj.lock);
+		} else {
+			g_inj.vdev_id = WLAN_INVALID_VDEV_ID;
+			qdf_mem_zero(g_inj.helper_mac, QDF_MAC_ADDR_SIZE);
+		}
+		/*
+		 * Firmware is unreachable, so its vdev state cannot be
+		 * quiesced and we can never obtain the proof that it is done
+		 * with our buffers.  Unmap as a last resort: firmware is dead
+		 * (SSR/WMI gone), so a DMA read cannot happen, and leaking the
+		 * mappings would be worse.  This is the one drain without a
+		 * firmware-done proof, and it is only reachable when there is
+		 * no firmware to race.
+		 */
+		hdd_mon_inject_slots_flush();
+		return;
+	}
+	wmi = wma->wmi_handle;
+
+	/* WMI_PEER_DELETE_CMDID */
+	{
+		struct peer_delete_cmd_params pdel = {0};
+		uint8_t peers[HDD_MON_INJECT_PEER_MAX][QDF_MAC_ADDR_SIZE];
+		uint8_t pcount = 0, pi;
+
+		if (g_inj.lock_inited)
+			qdf_spin_lock_bh(&g_inj.lock);
+		pcount = g_inj.peer_count;
+		if (pcount > HDD_MON_INJECT_PEER_MAX)
+			pcount = HDD_MON_INJECT_PEER_MAX;
+		for (pi = 0; pi < pcount; pi++)
+			qdf_mem_copy(peers[pi], g_inj.peer_mac[pi],
+				     QDF_MAC_ADDR_SIZE);
+		g_inj.peer_count = 0;
+		qdf_mem_zero(g_inj.peer_mac, sizeof(g_inj.peer_mac));
+		if (g_inj.lock_inited)
+			qdf_spin_unlock_bh(&g_inj.lock);
+
+		for (pi = 0; pi < pcount; pi++) {
+			pdel.vdev_id = vdev_id;
+			wmi_unified_peer_delete_send(wmi, peers[pi], &pdel);
+			msleep(20);
+		}
+		pdel.vdev_id = vdev_id;
+		wmi_unified_peer_delete_send(wmi, helper_mac, &pdel);
+	}
+	msleep(100);
+
+	/* WMI_VDEV_STOP_CMDID */
+	{
+		struct vdev_stop_params vstop = {0};
+		vstop.vdev_id = vdev_id;
+		wmi_unified_vdev_stop_send(wmi, &vstop);
+	}
+	msleep(100);
+
+	/* WMI_VDEV_DELETE_CMDID */
+	status = wmi_unified_vdev_delete_send(wmi, vdev_id);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		/*
+		 * If this send fails the ghost vdev survives in firmware and
+		 * the next PMO suspend asserts (the 10-20 min late reboot).
+		 * The loader's post-switch health check keys on this marker.
+		 */
+		hdd_err("Injection: VDEV_DELETE send failed (%d) - ghost vdev leaked; reboot recommended",
+			status);
+	} else {
+		hdd_info("Injection: ghost STA helper torn down (vdev %u)",
+			 vdev_id);
+	}
+
+	/*
+	 * The ghost vdev is stopped and deleted, so firmware has no path
+	 * left to DMA-read any buffer we submitted on it.  NOW it is safe
+	 * to unmap and free the outstanding ones -- doing this before the
+	 * vdev teardown is what let a STARTED vdev's in-flight buffer be
+	 * unmapped underneath firmware.
+	 */
+	hdd_mon_inject_slots_flush();
+}
+
+/*
+ * Full stop path used from hdd_stop when the monitor iface goes down
+ * (Android Wi-Fi off, ifconfig down, mode switch).  Cancels deferred
+ * create, tears down the helper, flushes slots, and stops carrier/TX
+ * so the netdev cannot queue more frames into a dead helper.
+ */
+static void hdd_mon_inject_stop(struct hdd_adapter *adapter)
+{
+	struct net_device *dev = adapter ? adapter->dev : NULL;
+
+	/* Block deferred create from racing teardown. */
+	hdd_mon_inject_tx_enable_adapter = NULL;
+	cancel_delayed_work_sync(&hdd_mon_inject_tx_enable_dw);
+
+	if (dev) {
+		netif_tx_stop_all_queues(dev);
+		netif_carrier_off(dev);
+	}
+
+	hdd_mon_inject_helper_teardown();
+
+	/* Belt-and-suspenders: flush again after teardown returns. */
+	hdd_mon_inject_slots_flush();
+
+	/*
+	 * Surface the counters before the lock goes away.  This line is the
+	 * on-device diagnostic for the whole reclaim design, so it carries
+	 * every path that can free a buffer:
+	 *
+	 *   complete  completions that matched and freed their slot -- the
+	 *             healthy reclaim path.  It was dead code before the
+	 *             token moved into the low 16 bits, so a run that ends
+	 *             with complete=0 and reaped>0 has NOT been fixed.
+	 *   stale     completions for a token the slot no longer held --
+	 *             expected (reused slot) and safe; frees nothing.
+	 *   reaped    the AGE_MS timeout path -- the lost-completion path.
+	 *             Healthy ~= 0; a climb means completions are being
+	 *             lost.  These buffers are moved to the quarantine, NOT
+	 *             unmapped, so a climb is a liveness signal, not memory
+	 *             corruption.
+	 *   flushed   buffers unmapped at teardown, after the ghost vdev is
+	 *             deleted -- including anything the quarantine held.
+	 *   bssid_skipped > 0 after an attack is the proof that the addr1
+	 *             exclusion kept the AP's own BSSID off the ghost vdev.
+	 */
+	if (g_inj.lock_inited) {
+		uint64_t ok_s, fail_s, done_s, skip_s, stale_s, reap_s, flush_s;
+
+		qdf_spin_lock_bh(&g_inj.lock);
+		ok_s = g_inj.tx_ok;
+		fail_s = g_inj.tx_fail;
+		done_s = g_inj.tx_complete;
+		skip_s = g_inj.bssid_skipped;
+		stale_s = g_inj.tx_stale;
+		reap_s = g_inj.reaped;
+		flush_s = g_inj.flushed;
+		qdf_spin_unlock_bh(&g_inj.lock);
+		hdd_info("Injection: session stats ok=%llu fail=%llu complete=%llu stale=%llu reaped=%llu flushed=%llu bssid_skipped=%llu",
+			 (unsigned long long)ok_s, (unsigned long long)fail_s,
+			 (unsigned long long)done_s, (unsigned long long)stale_s,
+			 (unsigned long long)reap_s, (unsigned long long)flush_s,
+			 (unsigned long long)skip_s);
+		/*
+		 * Anything still in the quarantine here would be a leak: this
+		 * runs after hdd_mon_inject_helper_teardown, whose flush drains
+		 * it.  Warn rather than stay silent, so a leak is visible.
+		 */
+		if (g_inj.quarantine_count)
+			hdd_err("Injection: %u buffer(s) left in quarantine at stop",
+				g_inj.quarantine_count);
+	}
+
+	if (g_inj.lock_inited) {
+		qdf_spin_lock_bh(&g_inj.lock);
+		g_inj.mon_dev = NULL;
+		qdf_spin_unlock_bh(&g_inj.lock);
+		qdf_spinlock_destroy(&g_inj.lock);
+		g_inj.lock_inited = false;
+	} else {
+		g_inj.mon_dev = NULL;
+	}
+}
