+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+/* Hidden STA vdev used for monitor-mode frame injection. */
+static struct hdd_adapter *hdd_mon_inject_sta_adapter;
+
+/**
+ * hdd_mon_inject_create_hidden_sta() - allocate and start a hidden STA vdev
+ * @mon_adapter: the monitor-mode adapter that will use the vdev for injection
+ *
+ * The firmware silently drops frames submitted on a monitor vdev, so a hidden
+ * STA vdev is created alongside the monitor interface. Injection uses this
+ * STA vdev instead of the monitor vdev.
+ *
+ * Return: none
+ */
+static void hdd_mon_inject_create_hidden_sta(struct hdd_adapter *mon_adapter)
+{
+	struct hdd_context *hdd_ctx = WLAN_HDD_GET_CTX(mon_adapter);
+	struct hdd_adapter_create_param params = {0};
+	struct hdd_adapter *sta_adapter;
+	struct wlan_objmgr_vdev *vdev;
+	uint8_t *mac_addr;
+
+	if (hdd_mon_inject_sta_adapter)
+		return;
+
+	if (!wlan_hdd_is_session_type_monitor(mon_adapter->device_mode))
+		return;
+
+	mac_addr = wlan_hdd_get_intf_addr(hdd_ctx, QDF_STA_MODE);
+	if (!mac_addr) {
+		hdd_err("Injection: failed to get STA MAC address");
+		return;
+	}
+
+	sta_adapter = hdd_open_adapter(hdd_ctx, QDF_STA_MODE, "null",
+				       mac_addr, NET_NAME_UNKNOWN, false,
+				       &params);
+	if (!sta_adapter) {
+		hdd_err("Injection: failed to open hidden STA adapter");
+		wlan_hdd_release_intf_addr(hdd_ctx, mac_addr);
+		return;
+	}
+
+	if (hdd_start_adapter(sta_adapter, false)) {
+		hdd_err("Injection: failed to start hidden STA adapter");
+		goto err_close;
+	}
+
+	vdev = hdd_objmgr_get_vdev_by_user(sta_adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev) {
+		hdd_err("Injection: hidden STA vdev not ready");
+		goto err_close;
+	}
+
+	mlme_vdev_self_peer_create(vdev);
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+
+	hdd_mon_inject_sta_adapter = sta_adapter;
+	return;
+
+err_close:
+	hdd_stop_adapter(hdd_ctx, sta_adapter);
+	hdd_close_adapter(hdd_ctx, sta_adapter, false);
+	wlan_hdd_release_intf_addr(hdd_ctx, mac_addr);
+}
+
+/**
+ * hdd_mon_inject_destroy_hidden_sta() - tear down the hidden STA vdev
+ * @mon_adapter: the monitor-mode adapter that owns the hidden STA vdev
+ *
+ * Return: none
+ */
+static void hdd_mon_inject_destroy_hidden_sta(struct hdd_adapter *mon_adapter)
+{
+	struct hdd_context *hdd_ctx = WLAN_HDD_GET_CTX(mon_adapter);
+	struct hdd_adapter *sta_adapter = hdd_mon_inject_sta_adapter;
+	struct qdf_mac_addr mac_addr;
+
+	if (!sta_adapter)
+		return;
+
+	hdd_mon_inject_sta_adapter = NULL;
+
+	qdf_copy_macaddr(&mac_addr, &sta_adapter->mac_addr);
+	hdd_stop_adapter(hdd_ctx, sta_adapter);
+	hdd_deinit_adapter(hdd_ctx, sta_adapter, false);
+	hdd_close_adapter(hdd_ctx, sta_adapter, false);
+	wlan_hdd_release_intf_addr(hdd_ctx, mac_addr.bytes);
+}
+#endif
