diff --git a/core/hdd/src/wlan_hdd_main.c b/core/hdd/src/wlan_hdd_main.c
index dcdaf2f6..39f85ca1 100755
--- a/core/hdd/src/wlan_hdd_main.c
+++ b/core/hdd/src/wlan_hdd_main.c
@@ -156,6 +156,8 @@
 #include "wlan_hdd_twt.h"
 #include "qc_sap_ioctl.h"
 #include "wlan_mlme_main.h"
+#include "wma_frame_inject.h"
+#include <linux/ieee80211.h>
 #include "wlan_p2p_cfg_api.h"
 #include "wlan_cfg80211_p2p.h"
 #include "wlan_cfg80211_interop_issues_ap.h"
@@ -1282,7 +1284,7 @@ struct notifier_block hdd_netdev_notifier = {
 };
 
 /* variable to hold the insmod parameters */
-int con_mode;
+int con_mode = QDF_GLOBAL_MONITOR_MODE;
 #ifdef FEATURE_WLAN_RESIDENT_DRIVER
 EXPORT_SYMBOL(con_mode);
 #endif
@@ -3449,6 +3451,96 @@ static void hdd_mon_turn_off_ps_and_wow(struct hdd_context *hdd_ctx)
 	ucfg_pmo_set_wow_enable(hdd_ctx->psoc, PMO_WOW_DISABLE_BOTH);
 }
 
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+
+#define HDD_MON_MIN_80211_LEN 24
+
+struct hdd_mon_radiotap_hdr {
+	uint8_t it_version;
+	uint8_t it_pad;
+	uint16_t it_len;
+	uint32_t it_present;
+} __packed;
+
+static uint32_t hdd_mon_inject_chan_freq;
+
+static int hdd_mon_inject_strip_radiotap(struct sk_buff *skb)
+{
+	struct hdd_mon_radiotap_hdr *rthdr;
+	uint16_t rtap_len;
+
+	if (skb->len < sizeof(*rthdr))
+		return -EINVAL;
+
+	rthdr = (struct hdd_mon_radiotap_hdr *)skb->data;
+	if (rthdr->it_version != 0)
+		return -EINVAL;
+
+	rtap_len = le16_to_cpu(rthdr->it_len);
+	if (rtap_len < sizeof(*rthdr) || rtap_len > skb->len ||
+	    skb->len - rtap_len < HDD_MON_MIN_80211_LEN)
+		return -EINVAL;
+
+	skb_pull(skb, rtap_len);
+	return 0;
+}
+
+static bool hdd_mon_inject_get_channel(struct hdd_adapter *mon_adapter,
+				       struct wlan_channel *channel)
+{
+	struct wlan_objmgr_vdev *vdev;
+	struct wlan_channel *source;
+	bool valid = false;
+
+	vdev = hdd_objmgr_get_vdev_by_user(mon_adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev)
+		return false;
+
+	source = wlan_vdev_mlme_get_bss_chan(vdev);
+	if (!source || !source->ch_freq)
+		source = wlan_vdev_mlme_get_des_chan(vdev);
+
+	if (source && source->ch_freq) {
+		qdf_mem_copy(channel, source, sizeof(*channel));
+		valid = true;
+	}
+
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+	return valid;
+}
+
+static bool hdd_mon_inject_set_channel(struct hdd_adapter *adapter)
+{
+	struct wlan_channel channel = {0};
+
+	if (!adapter || !adapter->deflink)
+		return false;
+
+	if (!hdd_mon_inject_get_channel(adapter, &channel)) {
+		hdd_err("Injection: monitor channel is not ready");
+		return false;
+	}
+
+	if (wma_mon_inject_setup(adapter->deflink->vdev_id,
+				 channel.ch_freq) != 0) {
+		hdd_err("Injection: failed to start helper vdev on %u MHz",
+			channel.ch_freq);
+		return false;
+	}
+
+	hdd_mon_inject_chan_freq = channel.ch_freq;
+	hdd_info("Injection: helper ready on %u MHz", channel.ch_freq);
+	return true;
+}
+
+static void hdd_mon_inject_stop(struct hdd_adapter *adapter)
+{
+	wma_mon_inject_teardown();
+	hdd_mon_inject_chan_freq = 0;
+}
+
+#endif /* FEATURE_MONITOR_MODE_SUPPORT */
+
 /**
  * __hdd_mon_open() - HDD Open function
  * @dev: Pointer to net_device structure
@@ -3523,6 +3615,8 @@ static int __hdd_mon_open(struct net_device *dev)
 		param.policy = BBM_DRIVER_MODE_POLICY;
 		param.policy_info.driver_mode = QDF_GLOBAL_MONITOR_MODE;
 		ucfg_dp_bbm_apply_independent_policy(hdd_ctx->psoc, &param);
+		if (!hdd_mon_inject_set_channel(adapter))
+			hdd_err("Injection: initial channel setup failed");
 		ucfg_dp_set_current_throughput_level(hdd_ctx->psoc,
 						     PLD_BUS_WIDTH_VERY_HIGH);
 	}
@@ -5875,6 +5969,11 @@ int hdd_stop_no_trans(struct net_device *dev)
 	if (WLAN_HDD_IS_NDI(adapter))
 		goto reset_iface_opened;
 
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+	if (wlan_hdd_is_session_type_monitor(adapter->device_mode))
+		hdd_mon_inject_stop(adapter);
+#endif
+
 	/*
 	 * The interface is marked as down for outside world (aka kernel)
 	 * But the driver is pretty much alive inside. The driver needs to
@@ -7306,10 +7405,52 @@ static const struct net_device_ops wlan_drv_ops = {
 };
 
 #ifdef FEATURE_MONITOR_MODE_SUPPORT
-/* Monitor mode net_device_ops, does not Tx and most of operations. */
+
+static netdev_tx_t hdd_mon_hard_start_xmit(struct sk_buff *skb,
+					   struct net_device *dev)
+{
+	struct hdd_adapter *adapter = WLAN_HDD_GET_PRIV_PTR(dev);
+	struct ieee80211_hdr *hdr;
+
+	if (!adapter) {
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	if (wlan_hdd_validate_context(WLAN_HDD_GET_CTX(adapter))) {
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+	if (skb_linearize(skb) || hdd_mon_inject_strip_radiotap(skb)) {
+		hdd_debug_rl("Injection: malformed radiotap frame");
+		goto drop;
+	}
+
+	hdr = (struct ieee80211_hdr *)skb->data;
+	if (!ieee80211_is_mgmt(hdr->frame_control)) {
+		hdd_debug_rl("Injection: only management frames are supported");
+		goto drop;
+	}
+
+	if (wma_mon_inject_tx(skb, hdd_mon_inject_chan_freq) == 0) {
+		dev->stats.tx_packets++;
+		dev->stats.tx_bytes += skb->len;
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
+	}
+
+drop:
+	dev->stats.tx_dropped++;
+	qdf_nbuf_free(skb);
+	return NETDEV_TX_OK;
+}
+
+/* Monitor mode net_device_ops with management-frame injection support. */
 static const struct net_device_ops wlan_mon_drv_ops = {
 	.ndo_open = hdd_mon_open,
 	.ndo_stop = hdd_stop,
+	.ndo_start_xmit = hdd_mon_hard_start_xmit,
 	.ndo_get_stats = hdd_get_stats,
 };
 
@@ -11423,7 +11564,14 @@ int wlan_hdd_set_mon_chan(struct hdd_adapter *adapter)
 			adapter->monitor_mode_vdev_up_in_progress = false;
 		}
 	}
-		return qdf_status_to_os_return(status);
+
+	if (QDF_IS_STATUS_SUCCESS(status) &&
+	    !hdd_mon_inject_set_channel(adapter)) {
+		hdd_err("Failed to synchronize monitor injection channel");
+		return -EIO;
+	}
+
+	return qdf_status_to_os_return(status);
 }
 #endif
 
diff --git a/core/wma/inc/wma_frame_inject.h b/core/wma/inc/wma_frame_inject.h
new file mode 100644
index 00000000..b1bfcf8e
--- /dev/null
+++ b/core/wma/inc/wma_frame_inject.h
@@ -0,0 +1,65 @@
+/*
+ * Copyright (c) 2024 The Linux Foundation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef WMA_FRAME_INJECT_H
+#define WMA_FRAME_INJECT_H
+
+#include <qdf_types.h>
+#include <qdf_nbuf.h>
+
+#ifdef FEATURE_MONITOR_MODE_SUPPORT
+
+/**
+ * wma_mon_inject_setup() - create a firmware-only helper vdev for injection
+ * @mon_vdev_id: monitor vdev id (used to avoid collision)
+ * @chanfreq: channel frequency in MHz
+ *
+ * Creates (or re-creates on channel change) a lightweight STA vdev in
+ * firmware and a self-peer on the requested channel. The host does not
+ * register an objmgr vdev, so firmware responses for this helper are
+ * dropped; msleep() delays separate the asynchronous commands.
+ *
+ * Return: 0 on success, negative errno on failure.
+ */
+int wma_mon_inject_setup(uint8_t mon_vdev_id, uint32_t chanfreq);
+
+/**
+ * wma_mon_inject_teardown() - destroy the helper vdev
+ *
+ * Sends PEER_DELETE -> VDEV_STOP -> VDEV_DELETE with msleep() gaps.
+ */
+void wma_mon_inject_teardown(void);
+
+/**
+ * wma_mon_inject_tx() - transmit a management frame through the helper vdev
+ * @skb: 802.11 management frame (radiotap already stripped)
+ * @chanfreq: channel frequency in MHz
+ *
+ * Consumes @skb on success. On failure the caller retains ownership.
+ *
+ * Return: 0 on success, negative errno on failure.
+ */
+int wma_mon_inject_tx(struct sk_buff *skb, uint32_t chanfreq);
+
+#else /* FEATURE_MONITOR_MODE_SUPPORT */
+
+static inline int wma_mon_inject_setup(uint8_t mon_vdev_id, uint32_t chanfreq)
+{
+	return -EINVAL;
+}
+
+static inline void wma_mon_inject_teardown(void)
+{
+}
+
+static inline int wma_mon_inject_tx(struct sk_buff *skb, uint32_t chanfreq)
+{
+	return -EINVAL;
+}
+
+#endif /* FEATURE_MONITOR_MODE_SUPPORT */
+
+#endif /* WMA_FRAME_INJECT_H */
diff --git a/core/wma/src/wma_frame_inject.c b/core/wma/src/wma_frame_inject.c
new file mode 100644
index 00000000..f468a2ee
--- /dev/null
+++ b/core/wma/src/wma_frame_inject.c
@@ -0,0 +1,401 @@
+/*
+ * Copyright (c) 2024 The Linux Foundation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include "wma_frame_inject.h"
+#include "wma.h"
+#include "wma_api.h"
+#include "wma_internal.h"
+#include "wmi_unified_api.h"
+#include "wmi_unified.h"
+#include "wlan_vdev_mgr_tgt_if_tx_defs.h"
+#include "qdf_mem.h"
+#include "qdf_time.h"
+#include "qdf_module.h"
+#include "qdf_delayed_work.h"
+#include "qdf_spinlock.h"
+#include "cds_api.h"
+
+/* Firmware needs time between asynchronous VDEV/peer commands */
+#define WMA_MON_INJECT_CMD_DELAY_MS 150
+#define WMA_MON_INJECT_PEER_DELAY_MS 100
+#define WMA_MON_INJECT_MAX_VDEV (CFG_TGT_NUM_VDEV - 2)
+
+/* In-flight TX buffers are freed after this timeout if no completion arrives */
+#define WMA_MON_INJECT_NBUF_TIMEOUT_US 2000000ULL
+#define WMA_MON_INJECT_REAP_INTERVAL_MS 3000
+#define WMA_MON_INJECT_MAX_INFLIGHT 16
+#define WMA_MON_INJECT_DESC_ID_BASE 0x8000
+#define WMA_MON_INJECT_DESC_ID_MASK 0x0FFF
+
+struct wma_mon_inject_nbuf {
+	qdf_nbuf_t nbuf;
+	uint16_t desc_id;
+	uint64_t submit_ts;
+	bool valid;
+};
+
+struct wma_mon_inject_ctx {
+	bool created;
+	uint8_t vdev_id;
+	uint8_t mon_vdev_id;
+	uint32_t chanfreq;
+	uint8_t mac_addr[QDF_MAC_ADDR_SIZE];
+	qdf_spinlock_t lock;
+	struct qdf_delayed_work reaper;
+	struct wma_mon_inject_nbuf inflight[WMA_MON_INJECT_MAX_INFLIGHT];
+	uint16_t next_desc_id;
+	bool reaper_running;
+};
+
+static struct wma_mon_inject_ctx g_inj;
+static bool g_inj_lock_inited;
+
+static void wma_mon_inject_lock_init(void)
+{
+	if (g_inj_lock_inited)
+		return;
+	qdf_spinlock_create(&g_inj.lock);
+	g_inj_lock_inited = true;
+}
+
+static uint16_t wma_mon_inject_desc_id_alloc(void)
+{
+	uint16_t id;
+
+	id = g_inj.next_desc_id;
+	if ((++g_inj.next_desc_id & ~WMA_MON_INJECT_DESC_ID_MASK) !=
+	    WMA_MON_INJECT_DESC_ID_BASE)
+		g_inj.next_desc_id = WMA_MON_INJECT_DESC_ID_BASE;
+
+	return id;
+}
+
+static void wma_mon_inject_nbuf_unmap_free(qdf_nbuf_t nbuf)
+{
+	void *qdf_ctx;
+
+	if (!nbuf)
+		return;
+
+	qdf_ctx = cds_get_context(QDF_MODULE_ID_QDF_DEVICE);
+	if (qdf_ctx)
+		qdf_nbuf_unmap_single(qdf_ctx, nbuf, QDF_DMA_TO_DEVICE);
+	qdf_nbuf_free(nbuf);
+}
+
+static void wma_mon_inject_reaper_cb(void *arg)
+{
+	uint64_t now = qdf_get_log_timestamp();
+	int i;
+
+	if (!g_inj.reaper_running)
+		return;
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+		struct wma_mon_inject_nbuf *e = &g_inj.inflight[i];
+		uint64_t age_us;
+
+		if (!e->valid || !e->nbuf)
+			continue;
+
+		age_us = qdf_log_timestamp_to_usecs(now - e->submit_ts);
+		if (age_us < WMA_MON_INJECT_NBUF_TIMEOUT_US)
+			continue;
+
+		wma_warn("Injection: reap stale desc_id=%u age=%llu us",
+			 e->desc_id, age_us);
+		wma_mon_inject_nbuf_unmap_free(e->nbuf);
+		e->nbuf = NULL;
+		e->valid = false;
+	}
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	qdf_delayed_work_start(&g_inj.reaper, WMA_MON_INJECT_REAP_INTERVAL_MS);
+}
+
+static void wma_mon_inject_reaper_init(void)
+{
+	if (g_inj.reaper_running)
+		return;
+
+	qdf_delayed_work_create(&g_inj.reaper, wma_mon_inject_reaper_cb, NULL);
+	g_inj.reaper_running = true;
+	qdf_delayed_work_start(&g_inj.reaper, WMA_MON_INJECT_REAP_INTERVAL_MS);
+}
+
+static void wma_mon_inject_reaper_deinit(void)
+{
+	int i;
+
+	if (!g_inj.reaper_running)
+		return;
+
+	qdf_delayed_work_stop_sync(&g_inj.reaper);
+	qdf_delayed_work_destroy(&g_inj.reaper);
+	g_inj.reaper_running = false;
+
+	for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+		if (g_inj.inflight[i].valid && g_inj.inflight[i].nbuf)
+			wma_mon_inject_nbuf_unmap_free(g_inj.inflight[i].nbuf);
+	}
+	qdf_mem_zero(g_inj.inflight, sizeof(g_inj.inflight));
+}
+
+static QDF_STATUS wma_mon_inject_find_vdev_id(uint8_t mon_vdev_id,
+					      uint8_t *out_vid)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	int i, fw_max;
+
+	if (!wma)
+		return QDF_STATUS_E_FAILURE;
+
+	fw_max = WMA_MON_INJECT_MAX_VDEV;
+	if (fw_max >= (int)wma->max_bssid)
+		fw_max = (int)wma->max_bssid - 1;
+
+	for (i = fw_max; i >= 0; i--) {
+		if ((uint8_t)i == mon_vdev_id)
+			continue;
+		if (!wma->interfaces[i].vdev) {
+			*out_vid = (uint8_t)i;
+			return QDF_STATUS_SUCCESS;
+		}
+	}
+
+	return QDF_STATUS_E_RESOURCES;
+}
+
+static void wma_mon_inject_build_mac(uint8_t *dst, uint8_t *monitor_mac)
+{
+	qdf_mem_copy(dst, monitor_mac, QDF_MAC_ADDR_SIZE);
+	/* Locally administered and guaranteed different from monitor MAC */
+	dst[0] |= 0x02;
+	dst[5] ^= 0x01;
+}
+
+int wma_mon_inject_setup(uint8_t mon_vdev_id, uint32_t chanfreq)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct vdev_create_params vcreate = {0};
+	struct vdev_start_params vstart = {0};
+	struct peer_create_params pcreate = {0};
+	uint8_t *monitor_mac;
+	QDF_STATUS status;
+	uint8_t vdev_id;
+
+	if (!wma || !wma->wmi_handle)
+		return -EINVAL;
+
+	wma_mon_inject_lock_init();
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	if (g_inj.created) {
+		bool same = (g_inj.chanfreq == chanfreq);
+		qdf_spin_unlock_bh(&g_inj.lock);
+		return same ? 0 : -EBUSY;
+	}
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	status = wma_mon_inject_find_vdev_id(mon_vdev_id, &vdev_id);
+	if (QDF_IS_STATUS_ERROR(status))
+		return -EBUSY;
+
+	monitor_mac = wlan_vdev_mlme_get_macaddr(wma->interfaces[mon_vdev_id].vdev);
+	if (!monitor_mac)
+		return -EINVAL;
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	wma_mon_inject_build_mac(g_inj.mac_addr, monitor_mac);
+	g_inj.vdev_id = vdev_id;
+	g_inj.mon_vdev_id = mon_vdev_id;
+	g_inj.chanfreq = chanfreq;
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	/* 1. VDEV CREATE (STA type) */
+	vcreate.vdev_id = vdev_id;
+	vcreate.type = WMI_VDEV_TYPE_STA;
+	vcreate.subtype = 0;
+	vcreate.nss_2g = 1;
+	vcreate.nss_5g = 1;
+	vcreate.pdev_id = 0;
+
+	status = wmi_unified_vdev_create_send(wma->wmi_handle,
+					      g_inj.mac_addr, &vcreate);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: vdev create failed: %d", status);
+		goto fail_clear;
+	}
+	msleep(WMA_MON_INJECT_CMD_DELAY_MS);
+
+	/* 2. VDEV START (basic 20 MHz) */
+	vstart.vdev_id = vdev_id;
+	vstart.channel.mhz = chanfreq;
+	vstart.channel.cfreq1 = chanfreq;
+	vstart.channel.cfreq2 = 0;
+	vstart.channel.phy_mode = (chanfreq < 4000) ? WLAN_PHYMODE_11G
+							  : WLAN_PHYMODE_11A;
+	vstart.channel.maxregpower = 20;
+	vstart.channel.maxpower = 20;
+	vstart.channel.pwr = 20;
+	vstart.beacon_interval = 0;
+	vstart.dtim_period = 0;
+
+	status = wmi_unified_vdev_start_send(wma->wmi_handle, &vstart);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: vdev start failed: %d", status);
+		goto fail_delete;
+	}
+	msleep(WMA_MON_INJECT_CMD_DELAY_MS);
+
+	/* 3. PEER CREATE (self-peer) */
+	pcreate.peer_addr = g_inj.mac_addr;
+	pcreate.peer_type = WMI_PEER_TYPE_DEFAULT;
+	pcreate.vdev_id = vdev_id;
+
+	status = wmi_unified_peer_create_send(wma->wmi_handle, &pcreate);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		wma_err("Injection: peer create failed: %d", status);
+		goto fail_stop;
+	}
+	msleep(WMA_MON_INJECT_PEER_DELAY_MS);
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	g_inj.created = true;
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	wma_info("Injection: helper vdev %u on %u MHz", vdev_id, chanfreq);
+	wma_mon_inject_reaper_init();
+	return 0;
+
+fail_stop:
+	wmi_unified_vdev_stop_send(wma->wmi_handle,
+				   &(struct vdev_stop_params){.vdev_id = vdev_id});
+fail_delete:
+	wmi_unified_vdev_delete_send(wma->wmi_handle, vdev_id);
+fail_clear:
+	qdf_spin_lock_bh(&g_inj.lock);
+	qdf_mem_zero(g_inj.mac_addr, sizeof(g_inj.mac_addr));
+	g_inj.vdev_id = 0;
+	g_inj.chanfreq = 0;
+	qdf_spin_unlock_bh(&g_inj.lock);
+	return -EIO;
+}
+
+void wma_mon_inject_teardown(void)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	struct peer_delete_cmd_params pdel = {0};
+	struct vdev_stop_params vstop = {0};
+	uint8_t vdev_id;
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	if (!g_inj.created) {
+		qdf_spin_unlock_bh(&g_inj.lock);
+		return;
+	}
+	vdev_id = g_inj.vdev_id;
+	g_inj.created = false;
+	g_inj.chanfreq = 0;
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	wma_mon_inject_reaper_deinit();
+
+	if (!wma || !wma->wmi_handle)
+		return;
+
+	pdel.vdev_id = vdev_id;
+	wmi_unified_peer_delete_send(wma->wmi_handle, g_inj.mac_addr, &pdel);
+	msleep(WMA_MON_INJECT_PEER_DELAY_MS);
+
+	vstop.vdev_id = vdev_id;
+	wmi_unified_vdev_stop_send(wma->wmi_handle, &vstop);
+	msleep(WMA_MON_INJECT_CMD_DELAY_MS);
+
+	wmi_unified_vdev_delete_send(wma->wmi_handle, vdev_id);
+	msleep(WMA_MON_INJECT_CMD_DELAY_MS);
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	qdf_mem_zero(g_inj.mac_addr, sizeof(g_inj.mac_addr));
+	qdf_spin_unlock_bh(&g_inj.lock);
+}
+
+int wma_mon_inject_tx(struct sk_buff *skb, uint32_t chanfreq)
+{
+	tp_wma_handle wma = cds_get_context(QDF_MODULE_ID_WMA);
+	void *qdf_ctx = cds_get_context(QDF_MODULE_ID_QDF_DEVICE);
+	struct wmi_mgmt_params mgmt = {0};
+	qdf_nbuf_t wmi_buf;
+	uint8_t *frame_data;
+	uint16_t desc_id;
+	int slot = -1;
+	int i;
+
+	if (!wma || !wma->wmi_handle || !skb)
+		return -EINVAL;
+
+	qdf_spin_lock_bh(&g_inj.lock);
+	if (!g_inj.created) {
+		qdf_spin_unlock_bh(&g_inj.lock);
+		return -ENODEV;
+	}
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	wmi_buf = qdf_nbuf_alloc(NULL, skb->len, 0, 0, false);
+	if (!wmi_buf)
+		return -ENOMEM;
+
+	frame_data = qdf_nbuf_put_tail(wmi_buf, skb->len);
+	if (!frame_data) {
+		qdf_nbuf_free(wmi_buf);
+		return -ENOMEM;
+	}
+	qdf_mem_copy(frame_data, skb->data, skb->len);
+
+	desc_id = wma_mon_inject_desc_id_alloc();
+
+	mgmt.tx_frame = wmi_buf;
+	mgmt.pdata = frame_data;
+	mgmt.frm_len = skb->len;
+	mgmt.vdev_id = g_inj.vdev_id;
+	mgmt.tx_type = GENERIC_NODOWLOAD_ACK_COMP_INDEX;
+	mgmt.chanfreq = (uint16_t)chanfreq;
+	mgmt.desc_id = desc_id;
+	mgmt.macaddr = NULL;
+	mgmt.qdf_ctx = qdf_ctx;
+
+	/* Track the buffer before the send so the reaper can clean it up. */
+	qdf_spin_lock_bh(&g_inj.lock);
+	for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+		if (!g_inj.inflight[i].valid) {
+			slot = i;
+			g_inj.inflight[i].valid = true;
+			g_inj.inflight[i].nbuf = wmi_buf;
+			g_inj.inflight[i].desc_id = desc_id;
+			g_inj.inflight[i].submit_ts = qdf_get_log_timestamp();
+			break;
+		}
+	}
+	qdf_spin_unlock_bh(&g_inj.lock);
+
+	if (slot < 0) {
+		wma_warn("Injection: in-flight buffer table full");
+		qdf_nbuf_free(wmi_buf);
+		return -EBUSY;
+	}
+
+	if (QDF_IS_STATUS_ERROR(wmi_mgmt_unified_cmd_send(wma->wmi_handle, &mgmt))) {
+		qdf_spin_lock_bh(&g_inj.lock);
+		g_inj.inflight[slot].valid = false;
+		g_inj.inflight[slot].nbuf = NULL;
+		qdf_spin_unlock_bh(&g_inj.lock);
+		qdf_nbuf_free(wmi_buf);
+		return -EIO;
+	}
+
+	return 0;
+}
