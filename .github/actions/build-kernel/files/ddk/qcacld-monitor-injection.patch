+	ctx_ret = wlan_hdd_validate_context(hdd_ctx);
+	if (ctx_ret) {
+		hdd_err("Injection: HDD context invalid (%d), dropping", ctx_ret);
+		qdf_nbuf_free(skb);
+		return NETDEV_TX_OK;
