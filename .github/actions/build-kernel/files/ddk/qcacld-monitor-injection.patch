+	 * This API allocates a unique descriptor and retains skb until firmware
+	 * completion. Directly calling wma_mgmt_unified_cmd_send() with desc_id
+	 * zero and freeing skb here causes descriptor collisions and DMA UAF.
+	 */
+	status = wlan_mgmt_txrx_mgmt_frame_tx(
+		peer, NULL, skb, hdd_mon_inject_tx_complete, NULL,
+		WLAN_UMAC_COMP_MLME, &mgmt_param);
