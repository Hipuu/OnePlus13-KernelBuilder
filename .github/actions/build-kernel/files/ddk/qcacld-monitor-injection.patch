diff --git a/core/wma/src/wma_frame_inject.c b/core/wma/src/wma_frame_inject.c
new file mode 100644
index 00000000..e15575c5
--- /dev/null
+++ b/core/wma/src/wma_frame_inject.c
@@ -0,0 +1,853 @@
+/*
+ * Copyright (c) 2024 The Linux Foundation. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <linux/delay.h>
+
+#include "wma_frame_inject.h"
+#include "wma.h"
+#include "wma_api.h"
+#include "wma_internal.h"
+#include "wmi_unified_api.h"
+#include "wmi_unified.h"
+#include "wlan_vdev_mgr_tgt_if_tx_defs.h"
+#include "qdf_event.h"
+#include "qdf_lock.h"
+#include "qdf_mem.h"
+#include "qdf_module.h"
+#include "cds_api.h"
+
+#define WMA_MON_INJECT_MAX_VDEV (CFG_TGT_NUM_VDEV - 2)
+#define WMA_MON_INJECT_MAX_INFLIGHT 16
+#define WMA_MON_INJECT_DESC_ID_BASE 0x8000
+#define WMA_MON_INJECT_DESC_ID_MASK 0x0FFF
+#define WMA_MON_INJECT_START_TIMEOUT_MS 2000
+#define WMA_MON_INJECT_PEER_TIMEOUT_MS 2000
+#define WMA_MON_INJECT_STOP_TIMEOUT_MS 1500
+#define WMA_MON_INJECT_DELETE_TIMEOUT_MS 1500
+#define WMA_MON_INJECT_TX_DRAIN_TIMEOUT_MS 2000
+#define WMA_MON_INJECT_TX_DRAIN_POLL_MS 20
+
+enum wma_mon_inject_state {
+	WMA_MON_INJECT_DOWN,
+	WMA_MON_INJECT_STARTING,
+	WMA_MON_INJECT_UP,
+	WMA_MON_INJECT_STOPPING,
+};
+
+struct wma_mon_inject_nbuf {
+	qdf_nbuf_t nbuf;
+	uint16_t desc_id;
+	bool valid;
+};
+
+struct wma_mon_inject_ctx {
+	bool initialized;
+	bool vdev_claimed;
+	bool vdev_created;
+	bool start_sent;
+	bool peer_created;
+	enum wma_mon_inject_state state;
+	uint8_t vdev_id;
+	uint8_t mon_vdev_id;
+	uint32_t chanfreq;
+	uint32_t start_status;
+	uint32_t peer_create_status;
+	uint8_t mac_addr[QDF_MAC_ADDR_SIZE];
+	qdf_mutex_t lifecycle_lock;
+	qdf_spinlock_t state_lock;
+	qdf_event_t start_event;
+	qdf_event_t peer_create_event;
+	qdf_event_t peer_delete_event;
+	qdf_event_t stop_event;
+	qdf_event_t delete_event;
+	struct wma_mon_inject_nbuf inflight[WMA_MON_INJECT_MAX_INFLIGHT];
+	uint16_t next_desc_id;
+	uint16_t active_submitters;
+};
+
+static struct wma_mon_inject_ctx g_inj;
+
+static bool wma_mon_inject_is_desc_id(uint32_t desc_id)
+{
+	return desc_id >= WMA_MON_INJECT_DESC_ID_BASE &&
+	       desc_id <= (WMA_MON_INJECT_DESC_ID_BASE +
+			   WMA_MON_INJECT_DESC_ID_MASK);
+}
+
+static bool wma_mon_inject_desc_id_alloc_locked(uint16_t *desc_id)
+{
+	uint16_t candidate;
+	bool in_use;
+	int attempt;
+	int i;
+
+	for (attempt = 0; attempt <= WMA_MON_INJECT_DESC_ID_MASK; attempt++) {
+		candidate = g_inj.next_desc_id;
+		if ((++g_inj.next_desc_id & ~WMA_MON_INJECT_DESC_ID_MASK) !=
+		    WMA_MON_INJECT_DESC_ID_BASE)
+			g_inj.next_desc_id = WMA_MON_INJECT_DESC_ID_BASE;
+
+		in_use = false;
+		for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+			if (g_inj.inflight[i].valid &&
+			    g_inj.inflight[i].desc_id == candidate) {
+				in_use = true;
+				break;
+			}
+		}
+
+		if (!in_use) {
+			*desc_id = candidate;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+static void wma_mon_inject_nbuf_unmap_free(qdf_nbuf_t nbuf)
+{
+	void *qdf_ctx;
+
+	if (!nbuf)
+		return;
+
+	qdf_ctx = cds_get_context(QDF_MODULE_ID_QDF_DEVICE);
+	if (qdf_ctx)
+		qdf_nbuf_unmap_single(qdf_ctx, nbuf, QDF_DMA_TO_DEVICE);
+	qdf_nbuf_free(nbuf);
+}
+
+static unsigned int wma_mon_inject_pending_tx_locked(void)
+{
+	unsigned int pending = g_inj.active_submitters;
+	int i;
+
+	for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+		if (g_inj.inflight[i].valid)
+			pending++;
+	}
+
+	return pending;
+}
+
+static bool wma_mon_inject_wait_for_tx_drain(void)
+{
+	unsigned int elapsed = 0;
+	unsigned int pending;
+
+	while (elapsed < WMA_MON_INJECT_TX_DRAIN_TIMEOUT_MS) {
+		qdf_spin_lock_bh(&g_inj.state_lock);
+		pending = wma_mon_inject_pending_tx_locked();
+		qdf_spin_unlock_bh(&g_inj.state_lock);
+		if (!pending)
+			return true;
+
+		msleep(WMA_MON_INJECT_TX_DRAIN_POLL_MS);
+		elapsed += WMA_MON_INJECT_TX_DRAIN_POLL_MS;
+	}
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	pending = wma_mon_inject_pending_tx_locked();
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+	wma_warn("Injection: %u TX buffers did not complete before teardown",
+		 pending);
+	return false;
+}
+
+static void wma_mon_inject_flush_inflight(void)
+{
+	qdf_nbuf_t pending[WMA_MON_INJECT_MAX_INFLIGHT] = {0};
+	int count = 0;
+	int i;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	for (i = 0; i < WMA_MON_INJECT_MAX_INFLIGHT; i++) {
+		if (!g_inj.inflight[i].valid)
+			continue;
+
+		pending[count++] = g_inj.inflight[i].nbuf;
+		g_inj.inflight[i].nbuf = NULL;
+		g_inj.inflight[i].valid = false;
+	}
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	for (i = 0; i < count; i++)
+		wma_mon_inject_nbuf_unmap_free(pending[i]);
+}
+
+static bool wma_mon_inject_submitters_idle(void)
+{
+	bool idle;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	idle = !g_inj.active_submitters;
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	return idle;
+}
+
+QDF_STATUS wma_mon_inject_init(void)
+{
+	QDF_STATUS status;
+
+	if (g_inj.initialized)
+		return QDF_STATUS_SUCCESS;
+
+	qdf_mem_zero(&g_inj, sizeof(g_inj));
+	status = qdf_mutex_create(&g_inj.lifecycle_lock);
+	if (QDF_IS_STATUS_ERROR(status))
+		return status;
+
+	qdf_spinlock_create(&g_inj.state_lock);
+
+	status = qdf_event_create(&g_inj.start_event);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto fail_spinlock;
+
+	status = qdf_event_create(&g_inj.peer_create_event);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto fail_start_event;
+
+	status = qdf_event_create(&g_inj.peer_delete_event);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto fail_peer_create_event;
+
+	status = qdf_event_create(&g_inj.stop_event);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto fail_peer_delete_event;
+
+	status = qdf_event_create(&g_inj.delete_event);
+	if (QDF_IS_STATUS_ERROR(status))
+		goto fail_stop_event;
+
+	g_inj.next_desc_id = WMA_MON_INJECT_DESC_ID_BASE;
+	g_inj.state = WMA_MON_INJECT_DOWN;
+	g_inj.initialized = true;
+	return QDF_STATUS_SUCCESS;
+
+fail_stop_event:
+	qdf_event_destroy(&g_inj.stop_event);
+fail_peer_delete_event:
+	qdf_event_destroy(&g_inj.peer_delete_event);
+fail_peer_create_event:
+	qdf_event_destroy(&g_inj.peer_create_event);
+fail_start_event:
+	qdf_event_destroy(&g_inj.start_event);
+fail_spinlock:
+	qdf_spinlock_destroy(&g_inj.state_lock);
+	qdf_mutex_destroy(&g_inj.lifecycle_lock);
+	qdf_mem_zero(&g_inj, sizeof(g_inj));
+	return status;
+}
+
+static QDF_STATUS
+wma_mon_inject_find_vdev_id(tp_wma_handle wma, uint8_t mon_vdev_id,
+			    uint8_t *out_vid)
+{
+	int i;
+	int fw_max;
+
+	fw_max = WMA_MON_INJECT_MAX_VDEV;
+	if (fw_max >= (int)wma->max_bssid)
+		fw_max = (int)wma->max_bssid - 1;
+
+	for (i = fw_max; i >= 0; i--) {
+		if ((uint8_t)i == mon_vdev_id)
+			continue;
+		if (!wma->interfaces[i].vdev) {
+			*out_vid = (uint8_t)i;
+			return QDF_STATUS_SUCCESS;
+		}
+	}
+
+	return QDF_STATUS_E_RESOURCES;
+}
+
+static void wma_mon_inject_build_mac(uint8_t *dst, const uint8_t *monitor_mac)
+{
+	qdf_mem_copy(dst, monitor_mac, QDF_MAC_ADDR_SIZE);
+	dst[0] |= 0x02;
+	dst[5] ^= 0x01;
+}
+
+bool wma_mon_inject_vdev_start_response(uint8_t vdev_id, uint32_t status)
+{
+	bool signal = false;
+	bool handled = false;
+
+	if (!g_inj.initialized)
+		return false;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	if (g_inj.vdev_claimed && g_inj.vdev_id == vdev_id) {
+		handled = true;
+		if (g_inj.state == WMA_MON_INJECT_STARTING) {
+			g_inj.start_status = status;
+			signal = true;
+		}
+	}
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	if (signal)
+		qdf_event_set(&g_inj.start_event);
+
+	return handled;
+}
+
+bool wma_mon_inject_vdev_stop_response(uint8_t vdev_id)
+{
+	bool signal = false;
+	bool handled = false;
+
+	if (!g_inj.initialized)
+		return false;
+
+	qdf_spin_lock_bh(&g_inj.state_lock);
+	if (g_inj.vdev_claimed && g_inj.vdev_id == vdev_id) {
+		handled = true;
+		if (g_inj.state == WMA_MON_INJECT_STOPPING)
+			signal = true;
+	}
+	qdf_spin_unlock_bh(&g_inj.state_lock);
+
+	if (signal)
+		qdf_event_set(&g_inj.stop_event);
+
+	return handled;
+}
+
