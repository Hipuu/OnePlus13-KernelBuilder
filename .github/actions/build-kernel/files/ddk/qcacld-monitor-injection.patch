+#define HDD_MON_INJECT_IFNAME "null"
+#define HDD_MON_INJECT_START_TIMEOUT_MS 8500
+#define HDD_MON_INJECT_START_POLL_MS 10
+
+/*
+ * Monitor vdevs are receive-only in the peach firmware. Keep one internal
+ * STA vdev started on the monitor channel and use its self peer for injected
+ * management frames.
+ */
+static struct hdd_adapter *hdd_mon_inject_sta_adapter;
+static struct qdf_mac_addr hdd_mon_inject_peer_addr;
+static uint32_t hdd_mon_inject_chan_freq;
+static bool hdd_mon_inject_vdev_started;
+static bool hdd_mon_inject_peer_created;
+static bool hdd_mon_inject_ready;
+
+static bool
+hdd_mon_inject_get_channel(struct hdd_adapter *mon_adapter,
+			   struct wlan_channel *channel)
+{
+	struct wlan_objmgr_vdev *vdev;
+	struct wlan_channel *source;
+	bool valid = false;
+
+	vdev = hdd_objmgr_get_vdev_by_user(mon_adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev)
+		return false;
+
+	source = wlan_vdev_mlme_get_bss_chan(vdev);
+	if (!source || !source->ch_freq)
+		source = wlan_vdev_mlme_get_des_chan(vdev);
+
+	if (source && source->ch_freq) {
+		qdf_mem_copy(channel, source, sizeof(*channel));
+		valid = true;
+	}
+
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+	return valid;
+}
+
+static bool
+hdd_mon_inject_get_self_peer(struct wlan_objmgr_vdev *vdev,
+			     struct qdf_mac_addr *peer_addr)
+{
+	const uint8_t *addr;
+
+	addr = wlan_vdev_mlme_get_mldaddr(vdev);
+	if (!addr || qdf_is_macaddr_zero((struct qdf_mac_addr *)addr))
+		addr = wlan_vdev_mlme_get_macaddr(vdev);
+	if (!addr)
+		return false;
+
+	qdf_mem_copy(peer_addr->bytes, addr, QDF_MAC_ADDR_SIZE);
+	return !qdf_is_macaddr_zero(peer_addr);
+}
+
+static void
+hdd_mon_inject_fill_start_params(struct hdd_context *hdd_ctx,
+				 struct wlan_channel *channel,
+				 struct vdev_start_params *params)
+{
+	int8_t power = channel->ch_maxpower;
+
+	if (power <= 0)
+		power = 20;
+
+	params->beacon_interval = 100;
+	params->dtim_period = 1;
+	params->channel.chan_id = channel->ch_ieee;
+	if (!params->channel.chan_id)
+		params->channel.chan_id =
+			wlan_reg_freq_to_chan(hdd_ctx->pdev, channel->ch_freq);
+	params->channel.pwr = power;
+	params->channel.mhz = channel->ch_freq;
+	params->channel.is_chan_passive =
+		wlan_reg_is_dfs_for_freq(hdd_ctx->pdev, channel->ch_freq);
+	params->channel.allow_ht = true;
+	params->channel.allow_vht = true;
+	params->channel.phy_mode = channel->ch_phymode;
+	if (!params->channel.phy_mode) {
+		if (WLAN_REG_IS_24GHZ_CH_FREQ(channel->ch_freq))
+			params->channel.phy_mode = WLAN_PHYMODE_11G;
+		else
+			params->channel.phy_mode = WLAN_PHYMODE_11A;
+	}
+	params->channel.cfreq1 = channel->ch_cfreq1;
+	if (!params->channel.cfreq1)
+		params->channel.cfreq1 = channel->ch_freq;
+	params->channel.cfreq2 = channel->ch_cfreq2;
+	params->channel.maxpower = power;
+	params->channel.maxregpower = power;
+#ifdef WLAN_FEATURE_11BE
+	params->channel.puncture_bitmap = channel->puncture_bitmap;
+#endif
+}
+
+static bool
+hdd_mon_inject_wait_for_start(struct wlan_objmgr_vdev *vdev)
+{
+	uint32_t elapsed;
+	enum wlan_vdev_state state;
+
+	for (elapsed = 0; elapsed < HDD_MON_INJECT_START_TIMEOUT_MS;
+	     elapsed += HDD_MON_INJECT_START_POLL_MS) {
+		state = wlan_vdev_mlme_get_state(vdev);
+		if (state >= WLAN_VDEV_S_START)
+			return true;
+		qdf_sleep(HDD_MON_INJECT_START_POLL_MS);
+	}
+
+	return false;
+}
+
+static bool
+hdd_mon_inject_start_hidden_vdev(struct hdd_adapter *sta_adapter,
+				 struct wlan_channel *channel)
+{
+	struct hdd_context *hdd_ctx = WLAN_HDD_GET_CTX(sta_adapter);
+	struct wlan_objmgr_vdev *vdev;
+	struct vdev_mlme_obj *mlme_obj;
+	struct wlan_channel *des_chan;
+	struct wlan_channel *bss_chan;
+	struct vdev_start_params start_param = {0};
+	struct vdev_up_params up_param = {0};
+	struct peer_create_params peer_param = {0};
+	struct qdf_mac_addr self_peer;
+	wmi_unified_t wmi_handle;
+	QDF_STATUS status;
+
+	wmi_handle = get_wmi_unified_hdl_from_psoc(hdd_ctx->psoc);
+	if (!wmi_handle) {
+		hdd_err("Injection: WMI handle is unavailable");
+		return false;
+	}
+
+	vdev = hdd_objmgr_get_vdev_by_user(sta_adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev) {
+		hdd_err("Injection: hidden STA vdev is unavailable");
+		return false;
+	}
+
+	if (!hdd_mon_inject_get_self_peer(vdev, &self_peer)) {
+		hdd_err("Injection: hidden STA self peer is unavailable");
+		goto fail_put_vdev;
+	}
+	mlme_obj = wlan_vdev_mlme_get_cmpt_obj(vdev);
+	if (!mlme_obj) {
+		hdd_err("Injection: hidden STA MLME object is unavailable");
+		goto fail_put_vdev;
+	}
+	qdf_mem_copy(mlme_obj->mgmt.generic.bssid, self_peer.bytes,
+		     QDF_MAC_ADDR_SIZE);
+
+	des_chan = wlan_vdev_mlme_get_des_chan(vdev);
+	bss_chan = wlan_vdev_mlme_get_bss_chan(vdev);
+	if (!des_chan || !bss_chan) {
+		hdd_err("Injection: hidden STA channel state is unavailable");
+		goto fail_put_vdev;
+	}
+
+	qdf_mem_copy(des_chan, channel, sizeof(*des_chan));
+	qdf_mem_zero(bss_chan, sizeof(*bss_chan));
+
+	start_param.vdev_id = wlan_vdev_get_id(vdev);
+	start_param.is_restart = hdd_mon_inject_vdev_started;
+	hdd_mon_inject_fill_start_params(hdd_ctx, channel, &start_param);
+
+	if (!hdd_mon_inject_peer_created) {
+		peer_param.peer_addr = self_peer.bytes;
+		peer_param.vdev_id = start_param.vdev_id;
+		peer_param.peer_type = WMI_PEER_TYPE_DEFAULT;
+		status = wmi_unified_peer_create_send(wmi_handle, &peer_param);
+		if (QDF_IS_STATUS_ERROR(status)) {
+			hdd_err("Injection: firmware self-peer create failed: %d",
+				status);
+			goto fail_put_vdev;
+		}
+
+		qdf_copy_macaddr(&hdd_mon_inject_peer_addr, &self_peer);
+		hdd_mon_inject_peer_created = true;
+	}
+
+	status = wma_vdev_pre_start(start_param.vdev_id,
+				    start_param.is_restart);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		hdd_err("Injection: hidden vdev pre-start failed: %d", status);
+		goto fail_put_vdev;
+	}
+
+	/*
+	 * The target interface arms the response timer that the WMI event
+	 * handler requires. A direct WMI send makes that handler reject the
+	 * response before WMA can publish the accepted channel.
+	 */
+	status = tgt_vdev_mgr_start_send(mlme_obj, &start_param);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		hdd_err("Injection: hidden vdev %s failed: %d",
+			start_param.is_restart ? "restart" : "start", status);
+		goto fail_put_vdev;
+	}
+
+	/*
+	 * WMA copies des_chan to bss_chan only for a successful firmware
+	 * response. This therefore distinguishes acceptance from a response
+	 * timeout or rejection without racing the asynchronous event handler.
+	 */
+	if (!hdd_mon_inject_wait_for_start(vdev)) {
+		hdd_err("Injection: hidden vdev start rejected or timed out on %u MHz",
+			channel->ch_freq);
+		goto fail_put_vdev;
+	}
+	hdd_mon_inject_vdev_started = true;
+
+	/* VDEV_UP releases the START runtime lock and enables firmware TX. */
+	up_param.vdev_id = start_param.vdev_id;
+	status = tgt_vdev_mgr_up_send(mlme_obj, &up_param);
+	if (QDF_IS_STATUS_ERROR(status)) {
+		hdd_err("Injection: hidden vdev up failed: %d", status);
+		goto fail_put_vdev;
+	}
+
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+	return true;
+
+fail_put_vdev:
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+	return false;
+}
+
+static void
+hdd_mon_inject_stop_hidden_vdev(struct hdd_adapter *sta_adapter)
+{
+	struct hdd_context *hdd_ctx = WLAN_HDD_GET_CTX(sta_adapter);
+	struct wlan_objmgr_vdev *vdev;
+	struct peer_delete_cmd_params del_param = {0};
+	struct vdev_stop_params stop_param = {0};
+	wmi_unified_t wmi_handle;
+	bool command_sent = false;
+	uint8_t vdev_id;
+
+	hdd_mon_inject_ready = false;
+	hdd_mon_inject_chan_freq = 0;
+
+	wmi_handle = get_wmi_unified_hdl_from_psoc(hdd_ctx->psoc);
+	vdev = hdd_objmgr_get_vdev_by_user(sta_adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev)
+		goto clear_state;
+	if (!wmi_handle) {
+		hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+		goto clear_state;
+	}
+
+	vdev_id = wlan_vdev_get_id(vdev);
+	if (hdd_mon_inject_peer_created) {
+		del_param.vdev_id = vdev_id;
+		wmi_unified_peer_delete_send(wmi_handle,
+					     hdd_mon_inject_peer_addr.bytes,
+					     &del_param);
+		command_sent = true;
+	}
+
+	if (hdd_mon_inject_vdev_started) {
+		stop_param.vdev_id = vdev_id;
+		wmi_unified_vdev_stop_send(wmi_handle, &stop_param);
+		command_sent = true;
+	}
+
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+
+clear_state:
+	hdd_mon_inject_peer_created = false;
+	hdd_mon_inject_vdev_started = false;
+	qdf_mem_zero(&hdd_mon_inject_peer_addr,
+		     sizeof(hdd_mon_inject_peer_addr));
+
+	/* Keep peer-delete/stop ahead of the normal vdev-delete teardown. */
+	if (command_sent)
+		qdf_sleep(20);
+}
+
+static bool
+hdd_mon_inject_create_hidden_sta(struct hdd_adapter *mon_adapter)
+{
+	struct hdd_context *hdd_ctx = WLAN_HDD_GET_CTX(mon_adapter);
+	struct hdd_adapter_create_param params = {0};
+	struct hdd_adapter *sta_adapter;
+	struct wlan_objmgr_vdev *vdev;
+	uint8_t *mac_addr;
+
+	sta_adapter = hdd_get_adapter_by_iface_name(hdd_ctx,
+						    HDD_MON_INJECT_IFNAME);
+	if (sta_adapter) {
+		if (sta_adapter->device_mode != QDF_STA_MODE) {
+			hdd_err("Injection: %s exists with the wrong mode",
+				HDD_MON_INJECT_IFNAME);
+			return false;
+		}
+		hdd_mon_inject_sta_adapter = sta_adapter;
+		return true;
+	}
+
+	if (mon_adapter->device_mode != QDF_MONITOR_MODE)
+		return false;
+
+	mac_addr = wlan_hdd_get_intf_addr(hdd_ctx, QDF_STA_MODE);
+	if (!mac_addr) {
+		hdd_err("Injection: failed to allocate a hidden STA address");
+		return false;
+	}
+
+	sta_adapter = hdd_open_adapter(hdd_ctx, QDF_STA_MODE,
+				       HDD_MON_INJECT_IFNAME, mac_addr,
+				       NET_NAME_UNKNOWN, true, &params);
+	if (!sta_adapter) {
+		hdd_err("Injection: failed to open hidden STA adapter");
+		wlan_hdd_release_intf_addr(hdd_ctx, mac_addr);
+		return false;
+	}
+
+	if (hdd_start_adapter(sta_adapter, true)) {
+		hdd_err("Injection: failed to create hidden STA vdev");
+		goto err_close;
+	}
+
+	vdev = hdd_objmgr_get_vdev_by_user(sta_adapter->deflink, WLAN_OSIF_ID);
+	if (!vdev) {
+		hdd_err("Injection: hidden STA vdev did not become ready");
+		goto err_stop;
+	}
+	hdd_objmgr_put_vdev_by_user(vdev, WLAN_OSIF_ID);
+
+	hdd_mon_inject_sta_adapter = sta_adapter;
+	hdd_mon_inject_vdev_started = false;
+	hdd_mon_inject_peer_created = false;
+	hdd_mon_inject_ready = false;
+	hdd_mon_inject_chan_freq = 0;
+	return true;
+
+err_stop:
+	hdd_stop_adapter(hdd_ctx, sta_adapter);
+err_close:
+	hdd_close_adapter(hdd_ctx, sta_adapter, true);
+	wlan_hdd_release_intf_addr(hdd_ctx, mac_addr);
+	return false;
+}
+
+bool hdd_mon_inject_set_channel(struct hdd_adapter *mon_adapter)
+{
+	struct hdd_adapter *sta_adapter = hdd_mon_inject_sta_adapter;
+	struct wlan_channel channel = {0};
+
+	if (!sta_adapter || !mon_adapter || !mon_adapter->dev)
+		return false;
+
+	if (!hdd_mon_inject_get_channel(mon_adapter, &channel)) {
+		hdd_err("Injection: monitor channel is not ready");
+		return false;
+	}
+
+	WRITE_ONCE(hdd_mon_inject_ready, false);
+	netif_carrier_off(mon_adapter->dev);
+	netif_tx_disable(mon_adapter->dev);
+
+	if (!hdd_mon_inject_start_hidden_vdev(sta_adapter, &channel))
+		return false;
+
+	hdd_mon_inject_chan_freq = channel.ch_freq;
+	WRITE_ONCE(hdd_mon_inject_ready, true);
+	netif_carrier_on(mon_adapter->dev);
+	netif_tx_wake_all_queues(mon_adapter->dev);
+	hdd_info("Injection: hidden STA ready on %u MHz", channel.ch_freq);
+	return true;
+}
+
+static void
+hdd_mon_inject_destroy_hidden_sta(struct hdd_adapter *mon_adapter)
+{
+	struct hdd_context *hdd_ctx = WLAN_HDD_GET_CTX(mon_adapter);
+	struct hdd_adapter *sta_adapter;
+	struct qdf_mac_addr mac_addr;
+
+	WRITE_ONCE(hdd_mon_inject_ready, false);
+	sta_adapter = hdd_get_adapter_by_iface_name(hdd_ctx,
+						    HDD_MON_INJECT_IFNAME);
+	hdd_mon_inject_sta_adapter = NULL;
+	if (!sta_adapter)
+		return;
+
+	qdf_copy_macaddr(&mac_addr, &sta_adapter->mac_addr);
+	hdd_mon_inject_stop_hidden_vdev(sta_adapter);
+	hdd_stop_adapter(hdd_ctx, sta_adapter);
+	hdd_deinit_adapter(hdd_ctx, sta_adapter, true);
+	hdd_close_adapter(hdd_ctx, sta_adapter, true);
+	wlan_hdd_release_intf_addr(hdd_ctx, mac_addr.bytes);
+}
