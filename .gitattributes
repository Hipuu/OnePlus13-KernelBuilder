# Shell scripts that run on the Android device must keep LF endings. A CRLF
# script fails to execute: the kernel reads the shebang as "/system/bin/sh\r"
# and reports "No such file or directory".
*.sh text eol=lf

# The build pipeline is consumed by Linux runners only.
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Bazel/Kleaf inputs. user.bazelrc and the build config fragment are sourced as
# shell by Kleaf, so CRLF would put a stray \r into POST_DEFCONFIG_CMDS.
*.bazel text eol=lf
*.bazelrc text eol=lf
*.bzl text eol=lf
*.fragment text eol=lf
